  toNode          DecisionRuleNode        @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  edgeConditions  DecisionEdgeCondition[]

  @@unique([artifactVersionId, edgeKey])
  @@index([artifactVersionId, fromNodeId, priority])
