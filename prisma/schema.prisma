  approverId  String?   @map("approver_id") @db.VarChar(160)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  calculatedField CalculatedField                      @relation(fields: [calculatedFieldId], references: [id], onDelete: Cascade)
  libraries       CalculatedFieldLibrary[]
  testCases       CalculatedFieldTestCase[]
  artifactUses    DecisionArtifactCalculatedFieldUse[]

  @@unique([calculatedFieldId, versionNumber])
  @@index([calculatedFieldId, status])
  @@map("decision_calculated_field_version")
}

/// Uso de un campo calculado desde un nodo del grafo (§5.1).
///
/// Existe como tabla —y no solo dentro del `config` del nodo— por dos razones: fija la
/// versión del campo que ese artefacto usa (inmutabilidad) y hace consultable la
/// dependencia inversa que exige §5.2 ("qué artefactos usan este campo calculado"),
/// que sobre JSON sería un escaneo completo.
model DecisionArtifactCalculatedFieldUse {
  id                       BigInt @id @default(autoincrement())
  tenantId                 BigInt @map("tenant_id")
  artifactVersionId        BigInt @map("artifact_version_id")
  nodeKey                  String @map("node_key") @db.VarChar(120)
  callKey                  String @map("call_key") @db.VarChar(120)
  calculatedFieldVersionId BigInt @map("calculated_field_version_id")

  /// { [inputId]: { source, path?, value?, expression? } }
  inputMappingJson Json   @map("input_mapping_json")
  targetKind       String @map("target_kind") @db.VarChar(20)
  targetCode       String @map("target_code") @db.VarChar(120)
  /// Definición congelada del campo en el momento de guardar el grafo. El motor la
  /// ejecuta sin volver a consultar la base, así que la decisión es reproducible.
  definitionJson   Json   @map("definition_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  artifactVersion        DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  calculatedFieldVersion CalculatedFieldVersion  @relation(fields: [calculatedFieldVersionId], references: [id], onDelete: Restrict)

  @@unique([artifactVersionId, nodeKey, callKey])
  @@index([tenantId, calculatedFieldVersionId])
  @@map("decision_artifact_calculated_field_use")
}

model CalculatedFieldLibrary {
  id                       BigInt @id @default(autoincrement())
  calculatedFieldVersionId BigInt @map("calculated_field_version_id")
  approvedLibraryId        BigInt @map("approved_library_id")

  calculatedFieldVersion CalculatedFieldVersion @relation(fields: [calculatedFieldVersionId], references: [id], onDelete: Cascade)
  library                ApprovedLibrary        @relation(fields: [approvedLibraryId], references: [id], onDelete: Restrict)

  @@unique([calculatedFieldVersionId, approvedLibraryId])
  @@map("decision_calculated_field_library")
}

model CalculatedFieldTestCase {
  id                       BigInt   @id @default(autoincrement())
  calculatedFieldVersionId BigInt   @map("calculated_field_version_id")
  name                     String   @db.VarChar(160)
  inputsJson               Json     @map("inputs_json")
  expectedJson             Json?    @map("expected_json")
  /// CÃ³digo de error esperado cuando el caso debe fallar de forma controlada.
  expectedErrorCode        String?  @map("expected_error_code") @db.VarChar(80)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  calculatedFieldVersion CalculatedFieldVersion @relation(fields: [calculatedFieldVersionId], references: [id], onDelete: Cascade)

  @@index([calculatedFieldVersionId])
  @@map("decision_calculated_field_test_case")
}

// ---------------------------------------------------------------------------
// Fase 6 â€” QA Lab: generaciÃ³n masiva reproducible (Â§10)
// ---------------------------------------------------------------------------

model QaGenerationRun {
  id                BigInt      @id @default(autoincrement())
  tenantId          BigInt      @map("tenant_id")
  artifactVersionId BigInt      @map("artifact_version_id")
  environmentCode   String      @map("environment_code") @db.VarChar(40)
  status            QaRunStatus @default(QUEUED)

  /// Semilla que hace la corrida reproducible bit a bit.
  seed                 String @db.VarChar(64)
  /// ConfiguraciÃ³n completa: cantidad, mezcla vÃ¡lido/invÃ¡lido/lÃ­mite, concurrencia,
  /// timeout y estrategia de parada.
  configJson           Json   @map("config_json")
  /// VersiÃ³n del generador y de sus dependencias, para reproducir el resultado exacto.
  generatorVersion     String @map("generator_version") @db.VarChar(40)
  toolingJson          Json   @map("tooling_json")
  /// Copia del contrato usado para generar (entradas + salidas), congelada.
  contractSnapshotJson Json   @map("contract_snapshot_json")

  totalCases   Int @default(0) @map("total_cases")
  passedCases  Int @default(0) @map("passed_cases")
  failedCases  Int @default(0) @map("failed_cases")
  erroredCases Int @default(0) @map("errored_cases")
  durationMs   Int @default(0) @map("duration_ms")

  summaryJson Json?     @map("summary_json")
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.VarChar(160)

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  counterexamples QaCounterexample[]

  @@index([tenantId, artifactVersionId, startedAt])
  @@map("decision_qa_generation_run")
}

model QaCounterexample {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  qaRunId  BigInt @map("qa_run_id")
  /// Propiedad violada (p. ej. OUTPUT_CONTRACT_RESPECTED, DETERMINISM).
  property String @db.VarChar(120)

  /// Contraejemplo MÃNIMO tras la reducciÃ³n de fast-check.
  shrunkInputJson   Json    @map("shrunk_input_json")
  originalInputJson Json?   @map("original_input_json")
  observedJson      Json?   @map("observed_json")
  failureCode       String  @map("failure_code") @db.VarChar(120)
  failureMessage    String  @map("failure_message") @db.Text
  /// Semilla + path de fast-check para volver a ejecutar exactamente este caso.
  replaySeed        String  @map("replay_seed") @db.VarChar(64)
  replayPath        String? @map("replay_path") @db.VarChar(200)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  qaRun QaGenerationRun @relation(fields: [qaRunId], references: [id], onDelete: Cascade)

  @@index([tenantId, qaRunId])
  @@index([tenantId, property, createdAt])
  @@map("decision_qa_counterexample")
}

// ---------------------------------------------------------------------------
// Workers adicionales — análisis semántico y extractos bancarios (ADR-0026)
//
// Una tabla por worker, no una tabla genérica de jobs: los dos tienen entradas
// y resultados que no se parecen en nada, y una tabla común habría acabado con
// la mitad de las columnas nulas y un `payload_json` sin forma. Lo que sí es
// común —ciclo de vida, lease, intentos, correlación— se escribe igual en las
// dos, así que el frontend las lee con el mismo código.
// ---------------------------------------------------------------------------

/// Ejecución del worker de análisis semántico.
model SemanticAnalysisRun {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  /// Identificador público. Es lo que viaja al frontend y a los logs; el `id`
  /// numérico no sale del motor.
  requestId      String @map("request_id") @db.VarChar(64)
  /// Clave de deduplicación acotada al tenant, tal como la define el contrato
  /// original del worker.
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)

  status   WorkerRunStatus @default(QUEUED)
  progress Int             @default(0)

  inputSource   WorkerInputSource @map("input_source")
  /// Texto analizado. Se minimiza al vencer el plazo de retención: se conserva
  /// la trazabilidad, no el contenido.
  inputText     String            @map("input_text") @db.Text
  inputMetadata Json?             @map("input_metadata")
  /// Nombre del escenario cuando `inputSource = FIXTURE`. Permite excluir las
  /// pruebas de cualquier lectura de operación.
  fixtureCode   String?           @map("fixture_code") @db.VarChar(60)

  /// `SemanticAnalysisResult` completo, tal como lo produce el núcleo del worker.
  resultJson   Json?   @map("result_json")
  warningsJson Json?   @map("warnings_json")
  errorCode    String? @map("error_code") @db.VarChar(120)
  errorMessage String? @map("error_message") @db.Text

  attemptCount   Int       @default(0) @map("attempt_count")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  queuedAt       DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  requestedBy   String @map("requested_by") @db.VarChar(160)
  correlationId String @map("correlation_id") @db.VarChar(64)

  /// Portador de traza W3C capturado al encolar. Anulable: una solicitud encolada antes
  /// de esta columna, o con la telemetría apagada, no lo trae y el worker abre una traza
  /// raíz para ella en vez de rechazar el trabajo.
  traceCarrier Json? @map("trace_carrier")

  /// Reenviar la misma solicitud devuelve la ejecución existente en vez de
  /// crear una segunda. Es la idempotencia, y es un índice único porque
  /// confiarla al código deja la puerta abierta a dos peticiones simultáneas.
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, requestId])
  /// El reclamo del worker ordena por este índice; sin él, cada ciclo escanea
  /// la tabla entera para encontrar la fila más antigua en QUEUED.
  @@index([status, queuedAt])
  @@index([tenantId, queuedAt])
  @@map("decision_semantic_analysis_run")
}

/// Ejecución del worker de extractos bancarios.
model BankStatementRun {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  requestId String @map("request_id") @db.VarChar(64)

  status   WorkerRunStatus @default(QUEUED)
  progress Int             @default(0)

  inputSource WorkerInputSource @map("input_source")
  fixtureCode String?           @map("fixture_code") @db.VarChar(60)

  /// Ya saneado en el borde: sin rutas, sin caracteres de control.
  fileName      String @map("file_name") @db.VarChar(255)
  /// SHA-256 del contenido. Es la base de la idempotencia porque el worker
  /// original no traía ninguna y el nombre del archivo no identifica nada.
  fileHash      String @map("file_hash") @db.Char(64)
  fileSizeBytes Int    @map("file_size_bytes")
  /// El documento, mientras hace falta. **Se borra en la misma transacción que
  /// cierra la ejecución**: lo que se conserva es el resultado normalizado, no
  /// el extracto bancario. Es a la vez la decisión de privacidad y el motivo
  /// por el que esta tabla no crece sin cota.
  fileBytes     Bytes? @map("file_bytes")

  /// `NormalizedBankStatement`. Hereda el enmascarado del motor: nunca trae el
  /// número de cuenta completo.
  resultJson       Json?    @map("result_json")
  warningsJson     Json?    @map("warnings_json")
  confidence       Decimal? @db.Decimal(4, 3)
  institutionId    String?  @map("institution_id") @db.VarChar(16)
  transactionCount Int?     @map("transaction_count")

  errorCode    String? @map("error_code") @db.VarChar(120)
  errorMessage String? @map("error_message") @db.Text

  attemptCount   Int       @default(0) @map("attempt_count")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  queuedAt       DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  requestedBy   String @map("requested_by") @db.VarChar(160)
  correlationId String @map("correlation_id") @db.VarChar(64)

  /// Portador de traza W3C capturado al encolar. Anulable por el mismo motivo que en
  /// `SemanticAnalysisRun`: compatibilidad con filas y telemetría anteriores a esta columna.
  traceCarrier Json? @map("trace_carrier")

  @@unique([tenantId, fileHash])
  @@unique([tenantId, requestId])
  @@index([status, queuedAt])
  @@index([tenantId, queuedAt])
  @@map("decision_bank_statement_run")
}

// ---------------------------------------------------------------------------
// Catálogo del worker semántico (ADR-0026).
//
// El worker original guardaba esto en su propio esquema `semantic_analysis`
// con Sequelize y tres migraciones propias. Aquí vive en el mismo esquema y el
// mismo ORM que el resto del motor: dos ORM contra la misma base es la clase de
// duplicación que el encargo prohíbe, y además parte las transacciones en dos.
//
// El catálogo son DATOS, no código: añadir una categoría o un alias no exige
// desplegar. Esa era una propiedad del worker original y se conserva.
// ---------------------------------------------------------------------------

/// Categoría contra la que se clasifica un texto.
model SemanticCategory {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  code        String @db.VarChar(120)
  name        String @db.VarChar(200)
  description String @db.Text

  /// Código de la categoría que la contiene; `null` en las raíces del árbol.
  ///
  /// Se guarda el CÓDIGO y no el `id` a propósito: el catálogo son datos que se
  /// siembran e importan por código, y una clave foránea contra `id` obligaría a
  /// ordenar la inserción de padres antes que la de hijos en cada carga. El
  /// árbol se cierra por `(tenant_id, parent_code)` contra `(tenant_id, code)`,
  /// que es único, así que la integridad se conserva sin ese acoplamiento.
  parentCode String? @map("parent_code") @db.VarChar(120)

  /// Ejemplos que SÍ son la categoría, y ejemplos que se le parecen pero NO lo
  /// son. Los contraejemplos son los que evitan el falso positivo, así que
  /// pesan tanto como los positivos.
  positiveExamples     Json @map("positive_examples")
  counterExamples      Json @map("counter_examples")
  restrictions         Json
  relatedCategoryCodes Json @map("related_category_codes")

  /// Confianza mínima para aceptar esta categoría. Es por categoría y no global
  /// porque no todas cuestan lo mismo al equivocarse.
  acceptanceThreshold Decimal @map("acceptance_threshold") @db.Decimal(4, 3)
  /// Sube al cambiar el significado de la categoría. La auditoría guarda con qué
  /// versión se decidió, para que una reclasificación posterior sea explicable.
  version             Int     @default(1)
  isActive            Boolean @default(true) @map("is_active")

  embeddings SemanticCategoryEmbedding[]

  /// El árbol se cierra dentro del tenant: `tenantId` entra en la clave para que
  /// una categoría no pueda colgar de la rama de otro cliente.
  parent   SemanticCategory?  @relation("SemanticCategoryTree", fields: [tenantId, parentCode], references: [tenantId, code], onDelete: Restrict, onUpdate: Cascade)
  children SemanticCategory[] @relation("SemanticCategoryTree")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, parentCode])
  @@map("decision_semantic_category")
}

/// Alias de una entidad conocida, para resolver menciones a su nombre canónico.
model SemanticEntityAlias {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  alias         String  @db.VarChar(200)
  canonicalName String  @map("canonical_name") @db.VarChar(200)
  entityType    String  @map("entity_type") @db.VarChar(60)
  isActive      Boolean @default(true) @map("is_active")

  @@unique([tenantId, entityType, alias])
  @@index([tenantId, isActive])
  @@map("decision_semantic_entity_alias")
}

/// Vector de una categoría, para la recuperación híbrida de candidatos.
model SemanticCategoryEmbedding {
  id         BigInt @id @default(autoincrement())
  categoryId BigInt @map("category_id")

  /// El modelo forma parte de la clave: vectores de modelos distintos no son
  /// comparables entre sí, y mezclarlos produce una similitud sin significado.
  model   String @db.VarChar(120)
  version Int    @default(1)
  /// Se guarda como JSON y no como `vector` de pgvector para no exigir una
  /// extensión de PostgreSQL que este despliegue puede no tener. La similitud
  /// se calcula en el worker; con catálogos de este tamaño es suficiente.
  vector  Json

  category SemanticCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, model])
  @@map("decision_semantic_category_embedding")
}

/// Consumo por tenant dentro de una ventana temporal.
model SemanticTenantBudget {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  /// Inicio de la ventana, truncado. Vive en la base y no en memoria porque el
  /// límite debe respetarse entre TODAS las réplicas del worker, no dentro de
  /// un proceso.
  windowStart   DateTime @map("window_start") @db.Timestamptz(6)
  analyses      Int      @default(0)
  providerCalls Int      @default(0) @map("provider_calls")

  @@unique([tenantId, windowStart])
  @@map("decision_semantic_tenant_budget")
}
