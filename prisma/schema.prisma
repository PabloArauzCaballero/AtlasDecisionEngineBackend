model RuntimeIdempotency {
  id             BigInt            @id @default(autoincrement())
  tenantId       BigInt            @map("tenant_id")
  artifactCode   String            @map("artifact_code") @db.VarChar(100)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(160)
  requestHash    String            @map("request_hash") @db.VarChar(128)
  status         IdempotencyStatus @default(PROCESSING)
  responseJson   Json?             @map("response_json")
  responseHash   String?           @map("response_hash") @db.VarChar(128)
  // Short lease held only while PROCESSING. A crashed request frees the key when this
  // lapses (seconds/minutes), so a stuck reservation no longer holds it for the full
  // response TTL below (plan §3.2). expiresAt stays the long replay window for a terminal
  // response.
  leaseExpiresAt DateTime          @default(now()) @map("lease_expires_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, artifactCode, idempotencyKey])
  @@index([expiresAt])
  @@map("decision_runtime_idempotency")
}

model DecisionAuditEvent {
  id               BigInt   @id @default(autoincrement())
  tenantId         BigInt   @map("tenant_id")
  eventType        String   @map("event_type") @db.VarChar(100)
  aggregateType    String   @map("aggregate_type") @db.VarChar(100)
  aggregateId      String   @map("aggregate_id") @db.VarChar(160)
  actorId          String   @map("actor_id") @db.VarChar(160)
  requestId        String?  @map("request_id") @db.VarChar(120)
  payloadJson      Json     @map("payload_json")
  previousHash     String?  @map("previous_hash") @db.VarChar(128)
  eventHash        String   @map("event_hash") @db.VarChar(128)
  // Identifies which signing secret produced eventHash, so AUDIT_HASH_SECRET can be
  // rotated without invalidating the historical chain.
  hashKeyId        String   @default("v1") @map("hash_key_id") @db.VarChar(40)
  // The exact canonical string that eventHash was computed over. Verification hashes this
  // instead of re-serializing payloadJson, because Postgres JSONB re-normalizes some
  // numbers (e.g. high-precision decimals) on round-trip, which would otherwise flip a
  // valid event to a false EVENT_HASH_MISMATCH. Nullable for events written before this.
  canonicalPayload String?  @map("canonical_payload") @db.Text
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt])
  @@index([aggregateType, aggregateId])
  // Supports the cursor-paginated audit feed (GET v1/audit/events/cursor), which seeks
  // `tenant_id = ? AND id < ? ORDER BY id DESC`. Without it Postgres scans the primary key
  // backwards and discards every other tenant's rows, so the deeper a tenant walks the more
  // rows it reads to fill one page — exactly the cost keyset pagination exists to avoid.
  @@index([tenantId, id])
  @@map("decision_audit_event")
}

model DecisionAccessAudit {
  id          BigInt   @id @default(autoincrement())
  requestId   String   @map("request_id") @db.VarChar(120)
  // Nullable because rejected requests are audited too, and a 401 has no
  // authenticated principal or tenant to attribute the attempt to.
  principalId String?  @map("principal_id") @db.VarChar(160)
