  nodeType          String  @map("node_type") @db.VarChar(50)
  label             String  @db.VarChar(200)
  configJson        Json    @map("config_json")
  // Porcentaje (0–100) del lienzo del editor, CON decimales: redondear a entero
  // movía los nodos ~17 px cada vez que se recargaba el grafo.
  xPos              Float   @default(0) @map("x_pos")
  yPos              Float   @default(0) @map("y_pos")
  orderIndex        Int     @default(0) @map("order_index")
