model DecisionExecution {
  id                   BigInt          @id @default(autoincrement())
  tenantId             BigInt          @map("tenant_id")
  deploymentId         BigInt          @map("deployment_id")
  artifactVersionId    BigInt          @map("artifact_version_id")
  environmentId        BigInt          @map("environment_id")
  requestId            String          @map("request_id") @db.VarChar(120)
  correlationId        String?         @map("correlation_id") @db.VarChar(120)
  idempotencyKey       String          @map("idempotency_key") @db.VarChar(160)
  subjectReferenceHash String?         @map("subject_reference_hash") @db.VarChar(128)
  /// El mismo sujeto, ya resuelto a fila. La columna HMAC se conserva: es la que responde a
  /// una solicitud de titular sin necesidad de tocar `decision_subject`, y las ejecuciones
  /// anteriores a esta migración sólo tienen esa.
  subjectId            BigInt?         @map("subject_id")
  /// Por qué esta ejecución no lleva sujeto. `WARN` (el integrador no lo mandó) o
  /// `NOT_APPLICABLE` (la versión declara que no lo tiene). Nulo cuando sí lo lleva.
  /// Sin esta columna, «faltó» y «no aplica» se confundían y la cobertura mentía.
  subjectAbsenceReason SubjectReferencePolicy? @map("subject_absence_reason")
  /// Alguna variable entró más vieja que su SLA y su política era `DEGRADE`. La decisión es
  /// válida; lo que no vale es que no se pueda distinguir de una tomada con datos frescos.
  degradedInputs       Boolean                 @default(false) @map("degraded_inputs")
  inputSnapshotJson    Json            @map("input_snapshot_json")
  outputJson           Json?           @map("output_json")
  decisionStatus       ExecutionStatus @map("decision_status")
  businessOutcome      String?         @map("business_outcome") @db.VarChar(80)
  durationMs           Int             @map("duration_ms")
  executedAt           DateTime        @default(now()) @map("executed_at") @db.Timestamptz(6)

  deployment           DecisionDeployment            @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  artifactVersion      DecisionArtifactVersion       @relation(fields: [artifactVersionId], references: [id], onDelete: Restrict)
  environment          DecisionEnvironment           @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  subject              DecisionSubject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  variables            DecisionExecutionVariable[]
  steps                DecisionExecutionStep[]
  reasons              DecisionExecutionReason[]
  errors               DecisionExecutionError[]
  manualReview         DecisionManualReviewCase?
  outcomeObservations  DecisionOutcomeObservation[]
  monitoringAttributes DecisionMonitoringAttribute[]
  outcomeWindows       OutcomeWindowSchedule[]

  @@unique([tenantId, requestId])
  @@index([tenantId, executedAt])
  @@index([artifactVersionId, executedAt])
  /// El historial de un solicitante y su exposición se piden por sujeto, no por hash.
  @@index([tenantId, subjectId, executedAt])
  /// Sin este índice, atender una solicitud de titular (LGPD art. 18, CCPA §1798.110) exigía
  /// recorrer la tabla entera. La columna se escribía desde el principio y no la leía nadie.
  @@index([tenantId, subjectReferenceHash])
  @@map("decision_execution")
}

/// El solicitante, en seudónimo, como entidad de primera clase.
///
/// Antes el sujeto sólo existía como una columna HMAC repetida en cada ejecución. Con eso se
/// puede agrupar («dame las decisiones de ESTE», si traes la referencia en claro) pero no se
/// puede enumerar, ni contar, ni colgar nada encima: ni exposición acumulada, ni comportamiento
/// de pago, ni límites por cliente. Un negocio de microcrédito vive de la segunda decisión
/// sobre la misma persona, y esa decisión necesita una fila que persista entre ejecuciones.
///
/// Sigue sin guardarse la referencia en claro: la clave es el mismo HMAC que usa
/// `decision_execution`, así que esta tabla no reidentifica a nadie por sí sola.
model DecisionSubject {
  id                   BigInt   @id @default(autoincrement())
  tenantId             BigInt   @map("tenant_id")
  subjectReferenceHash String   @map("subject_reference_hash") @db.VarChar(128)
  firstSeenAt          DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt           DateTime @default(now()) @updatedAt @map("last_seen_at") @db.Timestamptz(6)
  /// Contador denormalizado. Existe para ordenar y filtrar sin recorrer las ejecuciones;
  /// la verdad sigue siendo `decision_execution`.
  decisionCount        Int      @default(0) @map("decision_count")

  executions      DecisionExecution[]
  facilities      CreditFacility[]
  consents        SubjectConsent[]
  reidentifications ReidentificationRequest[]

  @@unique([tenantId, subjectReferenceHash])
  @@index([tenantId, lastSeenAt])
  @@map("decision_subject")
}

/// El crédito concedido, que es a lo que de verdad pertenece un desenlace.
///
/// Un préstamo genera muchas decisiones a lo largo de su vida —originación, aumento de línea,
/// refinanciación, priorización de cobranza— y el análisis de cosecha necesita agrupar por el
/// préstamo, no por cada una de ellas. Sin esta tabla, «tasa de malos de la cosecha de marzo»
/// contaba decisiones en vez de créditos y sobrerrepresentaba a quien más veces fue evaluado.
///
/// `externalReference` es el identificador en el sistema de cartera: es la costura por la que
/// entra el desenlace desde el core, y por eso es única por tenant.
model CreditFacility {
  id                     BigInt    @id @default(autoincrement())
  tenantId               BigInt    @map("tenant_id")
  subjectId              BigInt    @map("subject_id")
  externalReference      String    @map("external_reference") @db.VarChar(160)
  /// La decisión que lo originó, cuando se conoce. Nula si el crédito entró por carga masiva
  /// desde el core sin haber pasado por el motor.
  originationExecutionId BigInt?   @map("origination_execution_id")
  principalAmount        Decimal   @map("principal_amount") @db.Decimal(18, 4)
  currencyCode           String    @map("currency_code") @db.VarChar(3)
  termMonths             Int       @map("term_months")
  annualRate             Decimal   @map("annual_rate") @db.Decimal(9, 6)
  disbursedAt            DateTime? @map("disbursed_at") @db.Timestamptz(6)
  closedAt               DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  subject      DecisionSubject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  observations DecisionOutcomeObservation[]
  windows      OutcomeWindowSchedule[]

  @@unique([tenantId, externalReference])
  @@index([tenantId, subjectId])
  @@index([tenantId, disbursedAt])
  @@map("credit_facility")
}

/// Cada ventana de observación que TOCA mirar, materializada al decidir.
///
/// Es la pieza que convierte «no hay desenlaces» en una cifra. Sin ella, el numerador de la
/// cobertura existía y el denominador no: nadie podía distinguir «este mes no falló ningún
/// crédito» de «este mes nadie cargó los desenlaces». Con la ventana programada por
/// adelantado, una que vence y nadie observa se VE.
model OutcomeWindowSchedule {
  id          BigInt    @id @default(autoincrement())
  tenantId    BigInt    @map("tenant_id")
  executionId BigInt    @map("execution_id")
  facilityId  BigInt?   @map("facility_id")
  windowDays  Int       @map("window_days")
  dueAt       DateTime  @map("due_at") @db.Timestamptz(6)
  /// Sello de cuándo se cerró. Nulo con `dueAt` pasado = ventana vencida sin observar, que es
  /// exactamente la cola de trabajo que la pantalla enseña.
  observedAt  DateTime? @map("observed_at") @db.Timestamptz(6)

  execution DecisionExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  facility  CreditFacility?   @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@unique([executionId, windowDays])
  @@index([tenantId, dueAt, observedAt])
  @@map("outcome_window_schedule")
}

/// Resultado REAL de una decisión, observado meses después de tomarla.
///
/// Sin esta tabla el sistema no podía responder a la única pregunta que valida un modelo:
/// ¿acertó? Se registra por separado y no como columna de la ejecución porque llega mucho
/// más tarde, puede corregirse cuando la evidencia cambia, y la ejecución es evidencia
/// regulatoria que no conviene reescribir.
///
/// `@@unique` por ejecución y ventana: se admite observar el mismo caso a 30, 90 y 180 días
/// —el comportamiento de un crédito depende del plazo— pero no dos veces la misma ventana.
model DecisionOutcomeObservation {
  id          BigInt               @id @default(autoincrement())
  tenantId    BigInt               @map("tenant_id")
  executionId BigInt               @map("execution_id")
  /// El crédito al que pertenece, cuando lo hay. Un rechazo no tiene préstamo y sigue siendo
  /// una observación válida —de hecho la mitad del análisis que casi nadie mide.
  facilityId  BigInt?              @map("facility_id")
  /// Días transcurridos desde la decisión. Es parte de la identidad de la observación.
  windowDays  Int                  @map("window_days")
  label       ObservedOutcomeLabel
  /// Magnitud asociada, cuando la hay: importe perdido, días de mora. Sin unidad impuesta.
  amount      Decimal?             @db.Decimal(18, 4)
  /// De dónde salió: sistema de cobranza, confirmación de fraude, carga manual.
  source      String               @db.VarChar(120)
  /// Cómo se supo, cuando NO se observó directamente: `BUREAU_LOOKUP`, `PROXY_MODEL`…
  ///
  /// Nulo significa observado. La distinción no es un detalle: un desenlace inferido sobre un
  /// rechazado (`reject inference`) mezclado con los observados calibra el modelo contra la
  /// población que ya aprobó y lo hace parecer perfecto. Se guardan juntos y se cuentan
  /// aparte.
  inferenceMethod String?          @map("inference_method") @db.VarChar(60)
  notes       String?              @db.Text
  observedAt  DateTime             @default(now()) @map("observed_at") @db.Timestamptz(6)
  recordedBy  String               @map("recorded_by") @db.VarChar(160)

  execution DecisionExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  facility  CreditFacility?   @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@unique([executionId, windowDays])
  @@index([tenantId, observedAt])
  @@index([tenantId, facilityId])
  @@map("decision_outcome_observation")
}

/// Atributo de un solicitante conservado **solo para medir sesgo**, nunca para decidir.
///
/// Aquí vive una tensión real y conocida: para comprobar que un modelo no discrimina hay que
/// saber a qué grupo pertenece cada solicitante, y ese es justamente el dato que ECOA prohíbe
/// usar al decidir. La respuesta no es renunciar a medir —un modelo que nadie audita por
/// sesgo es peor— sino separar los dos caminos de forma que no puedan tocarse:
///
///  - se escribe por su propio endpoint, DESPUÉS de la decisión;
///  - no cuelga del catálogo de variables, así que no puede aparecer en un contrato de
///    entrada ni resolverse en una ejecución;
///  - el motor nunca lee esta tabla: no hay relación desde el contexto de ejecución hacia
///    aquí, solo desde el análisis de sesgo.
///
/// Es el mismo criterio con el que Regulation B admite el autoexamen: recoger el dato para
/// comprobarse a uno mismo no es usarlo para decidir.
model DecisionMonitoringAttribute {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt   @map("tenant_id")
  executionId BigInt   @map("execution_id")
  /// Grupo bajo examen: `AGE_BAND`, `GENDER`, `REGION`. Lo define quien audita, no el motor.
  attribute   String   @db.VarChar(80)
  /// Valor del grupo, ya agrupado. Bandas, no valores exactos: para medir sesgo basta el
  /// grupo, y guardar el dato exacto sería retener más de lo necesario.
  groupValue  String   @map("group_value") @db.VarChar(80)
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy  String   @map("recorded_by") @db.VarChar(160)

  execution DecisionExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, attribute])
  @@index([tenantId, attribute, recordedAt])
  @@map("decision_monitoring_attribute")
}

/// Distribución de referencia de una variable, congelada al promover la versión.
///
/// La estabilidad de población (PSI) compara la población de hoy contra una de referencia, y
/// la elección de esa referencia decide si el gate sirve para algo. Tomarla «del mes pasado»
/// —lo natural, y lo que casi todo el mundo hace— hace que la deriva LENTA no se detecte
/// nunca: la referencia deriva junto con la población y el índice se queda plano mientras el
/// modelo se aleja del mundo. Se congela, entonces, en el momento de la promoción: la
/// población contra la que se validó el modelo es la única referencia que significa algo.
model MonitoringBaseline {
  id                BigInt   @id @default(autoincrement())
  tenantId          BigInt   @map("tenant_id")
  artifactVersionId BigInt   @map("artifact_version_id")
  variableCode      String   @map("variable_code") @db.VarChar(120)
  /// Bordes de los cubos y su frecuencia relativa. Se guarda el histograma y no la muestra:
  /// para el índice basta, y una muestra de valores sería retener datos personales sin
  /// necesidad.
  bucketsJson       Json     @map("buckets_json")
  sampleSize        Int      @map("sample_size")
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  capturedBy        String   @map("captured_by") @db.VarChar(160)

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)

  @@unique([artifactVersionId, variableCode])
  @@index([tenantId, capturedAt])
  @@map("monitoring_baseline")
}

/// Una medición de vigilancia con su umbral y su veredicto, guardada.
///
/// El motor ya sabía CALCULAR estabilidad, desempeño e impacto adverso; lo hacía cuando
/// alguien mandaba un POST, y nadie lo mandaba nunca. Un cálculo bajo demanda que nadie pide
/// es un cálculo que no ocurre. Persistir cada evaluación con su umbral convierte eso en una
/// serie: se puede ver cuándo empezó a torcerse, y se puede detectar que la vigilancia MISMA
/// se detuvo —una evaluación que no llega es un `BREACH` por sí sola—.
model MonitoringEvaluation {
  id                BigInt            @id @default(autoincrement())
  tenantId          BigInt            @map("tenant_id")
  artifactVersionId BigInt            @map("artifact_version_id")
  /// `PSI`, `BAD_RATE`, `APPROVAL_RATE`, `ADVERSE_IMPACT_RATIO`, `OUTCOME_COVERAGE`…
  metricCode        String            @map("metric_code") @db.VarChar(60)
  /// Sobre qué se midió: el código de la variable, el grupo del atributo, o `-` si es global.
  scope             String            @db.VarChar(120)
  value             Decimal           @db.Decimal(18, 8)
  threshold         Decimal           @db.Decimal(18, 8)
  verdict           MonitoringVerdict
  /// Tamaño de la muestra. Un veredicto sobre doce casos no es el mismo que sobre doce mil, y
  /// sin este número la pantalla enseñaría los dos igual.
  sampleSize        Int               @map("sample_size")
  detailsJson       Json?             @map("details_json")
  evaluatedAt       DateTime          @default(now()) @map("evaluated_at") @db.Timestamptz(6)

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, artifactVersionId, metricCode, evaluatedAt])
  @@index([tenantId, verdict, evaluatedAt])
  @@map("monitoring_evaluation")
}

/// Un decil de la curva de calibración: PD predicha contra tasa de malos observada (§Ola 4).
///
/// Una PD sin calibrar es peor que ninguna PD. Ordena igual de bien —el decil 10 sigue siendo
/// peor que el 1— pero su NIVEL no significa nada, y en cuanto alguien la usa para poner precio o
/// para calcular pérdida esperada, el error se convierte en dinero. Por eso el gate del contrato
/// económico exige cosecha observada antes de dejar que una PD alimente el precio.
model CalibrationBucket {
  id                BigInt   @id @default(autoincrement())
  tenantId          BigInt   @map("tenant_id")
  artifactVersionId BigInt   @map("artifact_version_id")
  /// Ventana de observación sobre la que se calibró. La calibración a 30 días y a 360 no son
  /// la misma curva, y mezclarlas es el error clásico.
  windowDays        Int      @map("window_days")
  /// 1..10. Decil de PD predicha, del más seguro al más arriesgado.
  decile            Int
  predictedRate     Decimal  @map("predicted_rate") @db.Decimal(9, 8)
  observedRate      Decimal  @map("observed_rate") @db.Decimal(9, 8)
  sampleSize        Int      @map("sample_size")
  computedAt        DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)

  @@unique([artifactVersionId, windowDays, decile])
  @@index([tenantId, computedAt])
  @@map("calibration_bucket")
}

/// Estado del negocio en un instante: el contexto que la decisión no tenía (§Ola 5).
///
/// Aprobar depende de en qué punto del mes y con qué liquidez está la operación, no sólo de quién
/// pide. Ninguna entrada representaba eso, así que un límite de concentración sólo podía vivir
/// dentro de una regla de un grafo — donde se olvida al clonar el grafo.
model PortfolioState {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  asOf       DateTime @map("as_of") @db.Timestamptz(6)
  /// `TOTAL_EXPOSURE`, `PAR30`, `ORIGINATION_BUDGET`, `LIQUIDITY`… Lo define quien gobierna el
  /// apetito de riesgo, no el motor.
  metricCode String   @map("metric_code") @db.VarChar(60)
  /// Segmento al que aplica: producto, región, canal. Cadena vacía = toda la cartera.
  ///
  /// Centinela explícito y no `NULL`: en SQL `segment = NULL` no es cierto nunca, así que con
  /// nulos cualquier lectura por clave del límite GLOBAL no encontraba la fila que sí existía.
  segment    String   @default("") @db.VarChar(120)
  value      Decimal  @db.Decimal(18, 4)
  recordedBy String   @map("recorded_by") @db.VarChar(160)

  @@unique([tenantId, asOf, metricCode, segment])
  @@index([tenantId, metricCode, asOf])
  @@map("portfolio_state")
}

/// Un límite duro que el motor comprueba al decidir (§Ola 5).
///
/// Vive aquí y no en una regla del grafo por una razón que se ve la primera vez que alguien clona
/// un artefacto: la regla se copia, se edita y el límite desaparece sin que nadie lo decida. Como
/// restricción del motor, un artefacto nuevo lo hereda por existir.
model ExposureLimit {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt   @map("tenant_id")
  /// `SUBJECT_TOTAL`, `SEGMENT_CONCENTRATION`, `PERIOD_ORIGINATION_BUDGET`.
  limitCode  String   @map("limit_code") @db.VarChar(60)
  /// Cadena vacía = toda la cartera. Mismo criterio que `PortfolioState.segment`.
  segment    String   @default("") @db.VarChar(120)
  maxValue   Decimal  @map("max_value") @db.Decimal(18, 4)
  currencyCode String @map("currency_code") @db.VarChar(3)
  /// Si es falso, se mide y se avisa pero no se rechaza. La forma de estrenar un límite sin
  /// romper la originación el primer día.
  enforced   Boolean  @default(false)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.VarChar(160)

  @@unique([tenantId, limitCode, segment])
  @@index([tenantId, isActive])
  @@map("exposure_limit")
}

/// Vigencia de la base legal para tratar los datos de un titular, por finalidad (§Ola 6).
///
/// `ProcessingLegalBasis` ya existía POR VERSIÓN DE ARTEFACTO: dice con qué amparo se diseñó la
/// decisión. Faltaba lo otro: leer el extracto bancario de una persona concreta tiene un permiso
/// con fecha, y decidir con un dato cuyo permiso venció es una infracción aunque el dato siga en
/// la caché. Las dos cosas son necesarias y ninguna sustituye a la otra.
model SubjectConsent {
  id          BigInt               @id @default(autoincrement())
  tenantId    BigInt               @map("tenant_id")
  subjectId   BigInt               @map("subject_id")
  /// Para qué: `BANK_STATEMENT_ANALYSIS`, `BUREAU_QUERY`, `BIOMETRIC_VERIFICATION`.
  purpose     String               @db.VarChar(120)
  basis       ProcessingLegalBasis
  grantedAt   DateTime             @map("granted_at") @db.Timestamptz(6)
  /// Nulo = sin caducidad declarada. No es lo mismo que «para siempre»: es una decisión que
  /// alguien tiene que haber tomado, y la pantalla lo distingue.
  expiresAt   DateTime?            @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?            @map("revoked_at") @db.Timestamptz(6)
  /// Dónde está la prueba: expediente, grabación, formulario firmado. Nunca el dato en claro.
  evidenceRef String?              @map("evidence_ref") @db.VarChar(200)
  recordedBy  String               @map("recorded_by") @db.VarChar(160)

  subject DecisionSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, subjectId, purpose])
  @@index([tenantId, expiresAt])
  @@map("subject_consent")
}

/// Constancia de una reidentificación: ir del caso seudónimo a la persona (§Ola 6).
///
/// El HMAC protege bien y estorba para operar: atender un reclamo exige poder llegar a la persona.
/// La salida no es aflojar el hash —eso lo aflojaría para todo— sino hacer que el camino exista,
/// cueste dos autorizaciones y quede escrito. Una consulta libre sería lo mismo que no cifrar.
model ReidentificationRequest {
  id          BigInt                 @id @default(autoincrement())
  tenantId    BigInt                 @map("tenant_id")
  subjectId   BigInt                 @map("subject_id")
  /// Por qué se necesita, en prosa. Es lo que otra persona va a leer para aprobar o negar.
  purpose     String                 @db.Text
  status      ReidentificationStatus @default(REQUESTED)
  requestedBy String                 @map("requested_by") @db.VarChar(160)
  requestedAt DateTime               @default(now()) @map("requested_at") @db.Timestamptz(6)
  /// Quien aprueba NO puede ser quien pide: lo comprueba el servicio, no la base.
  decidedBy   String?                @map("decided_by") @db.VarChar(160)
  decidedAt   DateTime?              @map("decided_at") @db.Timestamptz(6)
  consumedAt  DateTime?              @map("consumed_at") @db.Timestamptz(6)

  subject DecisionSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, requestedAt])
  @@index([tenantId, subjectId])
  @@map("reidentification_request")
}

/// Constancia de una solicitud de titular de datos.
///
/// Existe por accountability: LGPD art. 18 §1 obliga a responder, y la prueba de que se
/// respondió —qué se pidió, quién lo atendió, cuándo y con qué alcance— no puede vivir solo
/// en el registro de auditoría, porque ahí no se puede consultar «todas las solicitudes de
/// este titular» sin recorrer la cadena entera.
///
/// El titular se identifica por el MISMO HMAC que usa `decision_execution`, así que la
/// referencia en claro nunca se persiste.
model DecisionDataSubjectRequest {
  id                   BigInt                   @id @default(autoincrement())
  tenantId             BigInt                   @map("tenant_id")
  subjectReferenceHash String                   @map("subject_reference_hash") @db.VarChar(128)
  requestType          DataSubjectRequestType   @map("request_type")
  status               DataSubjectRequestStatus @default(RECEIVED)
  /// Quién registró la solicitud en nombre del titular (operador, canal de atención).
  receivedBy           String                   @map("received_by") @db.VarChar(160)
  /// Contexto del canal: número de ticket, expediente. Nunca el dato del titular.
  reference            String?                  @db.VarChar(200)
  /// Qué se entregó o por qué se rechazó. Sin datos personales: solo el alcance.
  resolutionJson       Json?                    @map("resolution_json")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt           DateTime?                @map("resolved_at") @db.Timestamptz(6)

  @@index([tenantId, subjectReferenceHash, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("decision_data_subject_request")
}

model DecisionExecutionVariable {
  id                BigInt  @id @default(autoincrement())
  executionId       BigInt  @map("execution_id")
  variableVersionId BigInt  @map("variable_version_id")
  valueJson         Json?   @map("value_json")
  valueHash         String  @map("value_hash") @db.VarChar(128)
  sourceCode        String  @map("source_code") @db.VarChar(100)
  resolutionStatus  String  @map("resolution_status") @db.VarChar(50)
  wasDefaulted      Boolean @default(false) @map("was_defaulted")

  /// CUÁNDO ERA CIERTO el valor, según quien lo entregó. Distinto de `fetchedAt`.
  ///
  /// Sin este sello, la traza guardaba el valor y callaba de cuándo era. Dos consecuencias
  /// concretas: reentrenar sobre esa traza mete información del futuro (un saldo leído hoy
  /// atribuido a una decisión de marzo), y defender la decisión ante un supervisor dos años
  /// después es reconstruir de memoria qué sabía el buró ese día.
  observedAt    DateTime? @map("observed_at") @db.Timestamptz(6)
  /// Cuándo se obtuvo. Con `observedAt` da la antigüedad real del dato en el momento de decidir.
  fetchedAt     DateTime? @map("fetched_at") @db.Timestamptz(6)
  /// Versión de la fuente que lo entregó. Sin ella, dos valores del mismo proveedor con
  /// semánticas distintas parecen el mismo dato.
  sourceVersion String?   @map("source_version") @db.VarChar(60)
  /// Antigüedad en segundos, derivada. Se persiste para poder filtrar por ella sin recalcular
  /// sobre millones de filas.
  ageSeconds    Int?      @map("age_seconds")
  /// El valor llegó más viejo que su SLA y la política era `DEGRADE`. Marca la fila, no la
  /// esconde: una decisión tomada con datos viejos sigue siendo válida y hay que poder verla.
  staleAccepted Boolean   @default(false) @map("stale_accepted")

  execution       DecisionExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
