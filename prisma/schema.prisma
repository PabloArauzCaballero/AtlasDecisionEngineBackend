  @@unique([artifactVersionId, code])
  @@index([tenantId, artifactVersionId])
  @@map("decision_intermediate_variable")
}

// ---------------------------------------------------------------------------
// Fase 1 â€” Contrato de salida explÃ­cito del artefacto (Â§4)
// ---------------------------------------------------------------------------

/// Gobierno y mapeo de origen de cada campo del contrato de salida. El TIPO y la
/// obligatoriedad siguen viviendo en la dependencia de variable OUTPUT/OUTPUT_PRIMARY
/// (una sola fuente de verdad para el motor); esta tabla aÃ±ade el origen explÃ­cito,
/// los motivos de ausencia y la documentaciÃ³n exigidos por Â§4. La validaciÃ³n exige
/// correspondencia 1:1 entre ambas antes de publicar (ver ADR-0003).
model DecisionOutputContractField {
  id                BigInt @id @default(autoincrement())
  tenantId          BigInt @map("tenant_id")
  artifactVersionId BigInt @map("artifact_version_id")
  fieldCode         String @map("field_code") @db.VarChar(120)

  name        String  @db.VarChar(160)
  description String? @db.Text

  /// Origen declarado del valor: nodo productor, expresiÃ³n, intermedia, constante o
  /// artefacto referenciado. `sourceRef` se interpreta segÃºn el tipo.
  sourceKind       OutputSourceKind @map("source_kind")
  sourceRef        String           @map("source_ref") @db.VarChar(500)
  /// Mapeo desde valores internos: { [valorInterno]: valorPublicado }.
  valueMappingJson Json?            @map("value_mapping_json")

  /// Motivos vÃ¡lidos por los que el campo puede faltar (solo para campos opcionales).
  absenceReasons   String[]         @map("absence_reasons")
  exampleJson      Json?            @map("example_json")
  contractVersion  String           @default("1") @map("contract_version") @db.VarChar(20)
  sensitivityClass SensitivityClass @default(INTERNAL) @map("sensitivity_class")
  tracePolicy      TracePolicy      @default(FULL) @map("trace_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  artifactVersion DecisionArtifactVersion        @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  reasonCodes     DecisionOutputFieldReasonMap[]

  @@unique([artifactVersionId, fieldCode])
  @@index([tenantId, artifactVersionId])
  @@map("decision_output_contract_field")
}

/// Motivos estructurados que un campo del contrato de salida puede devolver (§4).
///
/// Es la contraparte legible por máquina de `absenceReasons`: esos son prosa para
/// explicar una ausencia; estos son códigos del catálogo gobernado, con FK real,
/// para que quien consume la decisión pueda ramificar por ellos. Se restringe el
/// borrado del reason code (igual que en las acciones): un contrato publicado no
/// puede quedar apuntando a un motivo que ya no existe.
model DecisionOutputFieldReasonMap {
  id            BigInt @id @default(autoincrement())
  outputFieldId BigInt @map("output_field_id")
  reasonCodeId  BigInt @map("reason_code_id")
  priority      Int    @default(100)

  outputField DecisionOutputContractField @relation(fields: [outputFieldId], references: [id], onDelete: Cascade)
  reasonCode  DecisionReasonCode          @relation(fields: [reasonCodeId], references: [id], onDelete: Restrict)

  @@unique([outputFieldId, reasonCodeId])
  @@map("decision_output_field_reason_map")
}

