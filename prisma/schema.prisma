// ---------------------------------------------------------------------------
// Integration client registry.
//
// API key callers used to declare their own tenant, principal and roles through
// x-tenant-id / x-principal-id / x-roles headers, so any holder of the shared key
// could act as any role in any tenant. Identity now resolves from these tables:
// the presented secret is the only caller-supplied input, and it is looked up by
// hash. Roles come from IntegrationScope and the tenant must be listed in
// IntegrationTenantAccess.
// ---------------------------------------------------------------------------

enum IntegrationClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum IntegrationCredentialStatus {
  ACTIVE
  REVOKED
}

model IntegrationClient {
  id          BigInt                  @id @default(autoincrement())
  clientKey   String                  @unique @map("client_key") @db.VarChar(120)
  displayName String                  @map("display_name") @db.VarChar(200)
  audience    String                  @db.VarChar(20)
  status      IntegrationClientStatus @default(ACTIVE)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  credentials  IntegrationCredential[]
  scopes       IntegrationScope[]
  tenantAccess IntegrationTenantAccess[]

  @@index([status])
  @@map("integration_client")
}

model IntegrationCredential {
  id         BigInt                      @id @default(autoincrement())
  clientId   BigInt                      @map("client_id")
  // SHA-256 of the presented secret. Indexed because it is the lookup key; the
  // secret itself is high-entropy and randomly generated, not a user password,
  // so a fast hash is appropriate here and a slow KDF would only add latency.
  secretHash String                      @unique @map("secret_hash") @db.VarChar(128)
  label      String                      @db.VarChar(120)
  status     IntegrationCredentialStatus @default(ACTIVE)
  expiresAt  DateTime?                   @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime?                   @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime?                   @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  client IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([expiresAt])
  @@map("integration_credential")
}

model IntegrationScope {
  id       BigInt @id @default(autoincrement())
  clientId BigInt @map("client_id")
  scope    String @db.VarChar(80)

  client IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, scope])
  @@map("integration_scope")
}

model IntegrationTenantAccess {
  id       BigInt @id @default(autoincrement())
  clientId BigInt @map("client_id")
  tenantId BigInt @map("tenant_id")

  client IntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, tenantId])
  @@index([tenantId])
  @@map("integration_tenant_access")
}

// ---------------------------------------------------------------------------
// Nested decision trees (Fase 7) + Code->Flow import registry (Fase 5).
// These models intentionally declare no Prisma relations to existing models so
// this block stays purely additive; real FK constraints and tenant RLS policies
// live in the SQL migrations.
// ---------------------------------------------------------------------------

enum ArtifactReferenceErrorPolicy {
  FAIL
  FALLBACK
  SKIP
}

/// Cómo se elige la versión del artefacto hijo en cada ejecución (§9.1).
enum ArtifactVersionSelection {
  /// Siempre la versión fijada. Obligatoria de facto en PROD: es la única reproducible.
  EXACT
  /// La versión activa del ambiente en el momento de ejecutar.
  ACTIVE_IN_ENVIRONMENT
}

model DecisionArtifactReference {
  id                      BigInt                       @id @default(autoincrement())
  tenantId                BigInt                       @map("tenant_id")
  parentArtifactVersionId BigInt                       @map("parent_artifact_version_id")
  nodeKey                 String                       @map("node_key") @db.VarChar(120)
  childArtifactId         BigInt                       @map("child_artifact_id")
  // Pinned child version: executions of the parent always run this exact version,
  // never "latest", so a parent approval stays reproducible.
  childArtifactVersionId  BigInt                       @map("child_artifact_version_id")
  // { [childInputVariableCode]: { source: 'VARIABLE'|'LITERAL', path?, value? } }
  inputMappingJson        Json                         @map("input_mapping_json")
  // { [parentContextKey]: childOutputCode }
  outputMappingJson       Json                         @map("output_mapping_json")
  timeoutMs               Int                          @default(2000) @map("timeout_ms")
  onErrorPolicy           ArtifactReferenceErrorPolicy @default(FAIL) @map("on_error_policy")
  fallbackOutputJson      Json?                        @map("fallback_output_json")

  // --- §9: configuración completa de la referencia ---
  /// Ambiente en el que se resuelve el hijo. Null = el mismo que el padre.
  environmentCode        String?                  @map("environment_code") @db.VarChar(40)
  versionSelection       ArtifactVersionSelection @default(EXACT) @map("version_selection")
  /// Reintentos ante error transitorio. 0 = ninguno (por defecto: una decisión no debe
  /// reintentar sola algo que puede tener efectos).
  maxRetries             Int                      @default(0) @map("max_retries")
  retryDelayMs           Int                      @default(0) @map("retry_delay_ms")
  /// Expresión booleana; si no se cumple, la referencia se omite sin ejecutar al hijo.
  executionConditionJson Json?                    @map("execution_condition_json")
  /// Una referencia opcional que falla no tumba la decisión del padre.
  isRequired             Boolean                  @default(true) @map("is_required")
  /// Qué se expone del resultado del hijo en la traza del padre.
  tracePolicy            TracePolicy              @default(FULL) @map("trace_policy")
  // Execution scope: when set, only principals holding this role may create or
  // edit the reference; enforced in the service layer on top of route RBAC.
  requiredRole           String?                  @map("required_role") @db.VarChar(80)
  createdBy              String                   @map("created_by") @db.VarChar(160)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([parentArtifactVersionId, nodeKey])
  @@index([tenantId, childArtifactId])
  @@index([childArtifactVersionId])
  @@map("decision_artifact_reference")
}

model DecisionExecutionTreeLink {
  id                     BigInt   @id @default(autoincrement())
  tenantId               BigInt   @map("tenant_id")
  // The one persisted DecisionExecution this distributed trace hangs off. Nested
  // invocations run fully in-memory during engine execution (see execution-engine
  // recursion) and are only known once the ROOT execution is written, so every row
  // for one request shares the same rootExecutionId/parentExecutionId; `sequence` /
  // `parentSequence` reconstruct the actual call tree shape below the root.
  rootExecutionId        BigInt   @map("root_execution_id")
  parentExecutionId      BigInt   @map("parent_execution_id")
  // Preorder position of this call within the root execution's nested-call trace.
  sequence               Int
  // sequence of the nested call that invoked this one; null for a direct child of the
  // root artifact's own graph (depth 1).
  parentSequence         Int?     @map("parent_sequence")
  nodeKey                String   @map("node_key") @db.VarChar(120)
  // Null only for a FALLBACK/SKIP entry recorded before a child version could even be
  // resolved (e.g. the reference itself was missing) — every SUCCEEDED entry has one.
  childArtifactVersionId BigInt?  @map("child_artifact_version_id")
  // Null when the child ran in-memory (the common case: nested calls are not given
  // their own DecisionExecution row) or failed before persistence.
  childExecutionId       BigInt?  @map("child_execution_id")
  depth                  Int
  status                 String   @db.VarChar(30)
  durationMs             Int      @map("duration_ms")
  outputJson             Json?    @map("output_json")
  errorJson              Json?    @map("error_json")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([rootExecutionId, sequence])
  @@index([tenantId, rootExecutionId])
  @@index([parentExecutionId, nodeKey])
  @@map("decision_execution_tree_link")
}

enum CodeImportStatus {
  ANALYZED
  DRAFT_SAVED
  CONFIRMED
  CANCELLED
}

model DecisionCodeImport {
  id                BigInt           @id @default(autoincrement())
  tenantId          BigInt           @map("tenant_id")
  artifactId        BigInt?          @map("artifact_id")
  artifactVersionId BigInt?          @map("artifact_version_id")
  language          String           @db.VarChar(30)
  sourceCode        String           @map("source_code") @db.Text
  sourceChecksum    String           @map("source_checksum") @db.VarChar(128)
  contractVersion   String           @map("contract_version") @db.VarChar(20)
  contractJson      Json             @map("contract_json")
  irJson            Json             @map("ir_json")
  issuesJson        Json             @map("issues_json")
  status            CodeImportStatus @default(ANALYZED)
  createdBy         String           @map("created_by") @db.VarChar(160)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, createdAt])
  @@index([artifactVersionId])
  @@map("decision_code_import")
}

// ---------------------------------------------------------------------------
// Event-driven infrastructure: transactional outbox + notification inbox.
//
// Business mutations write their domain event into decision_outbox_event inside
// the SAME Prisma transaction as the change (the AuditService.append pattern), so
// "the database changed but the event was never published" cannot happen. A relay
// worker claims PENDING rows with a short lease (the RuntimeIdempotency /
// DecisionTestRun pattern), dispatches them to the in-process event bus and marks
// them DISPATCHED; failures back off via available_at and land in DEAD after
// OUTBOX_MAX_ATTEMPTS. Consumers achieve exactly-once effects through the
// (consumer_name, outbox_event_id) uniqueness of decision_processed_event.
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
  DEAD
}

model DecisionOutboxEvent {
  id             BigInt       @id @default(autoincrement())
  tenantId       BigInt       @map("tenant_id")
  eventType      String       @map("event_type") @db.VarChar(120)
  schemaVersion  String       @default("1") @map("schema_version") @db.VarChar(20)
  aggregateType  String       @map("aggregate_type") @db.VarChar(100)
  aggregateId    String       @map("aggregate_id") @db.VarChar(160)
  actorId        String       @map("actor_id") @db.VarChar(160)
  correlationId  String?      @map("correlation_id") @db.VarChar(120)
  causationId    String?      @map("causation_id") @db.VarChar(120)
  payloadJson    Json         @map("payload_json")
  status         OutboxStatus @default(PENDING)
  attemptCount   Int          @default(0) @map("attempt_count")
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  lockedBy       String?      @map("locked_by") @db.VarChar(120)
  lastError      String?      @map("last_error") @db.Text
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  dispatchedAt   DateTime?    @map("dispatched_at") @db.Timestamptz(6)
  /// Portador de traza W3C capturado en el momento del `publish`. Anulable: una fila
  /// anterior a esta columna, o publicada con la telemetría apagada, no lo trae, y el
  /// relay abre una traza raíz para ella en vez de descartar el evento.
  traceCarrier   Json?        @map("trace_carrier")

  @@index([status, availableAt])
  @@index([tenantId, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("decision_outbox_event")
}

model ProcessedEvent {
  id            BigInt   @id @default(autoincrement())
  consumerName  String   @map("consumer_name") @db.VarChar(120)
  outboxEventId BigInt   @map("outbox_event_id")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([consumerName, outboxEventId])
  @@map("decision_processed_event")
}

model Notification {
  id            BigInt    @id @default(autoincrement())
  tenantId      BigInt    @map("tenant_id")
  // Role-addressed by design: users live in the external identity provider, not in this
  // database, so the inbox targets a role (plus tenant) and/or an optional principal id.
  recipientRole String?   @map("recipient_role") @db.VarChar(80)
  recipientId   String?   @map("recipient_id") @db.VarChar(160)
  category      String    @db.VarChar(50)
  priority      String    @default("NORMAL") @db.VarChar(20)
  title         String    @db.VarChar(200)
  body          String    @db.Text
  entityType    String?   @map("entity_type") @db.VarChar(80)
  entityId      String?   @map("entity_id") @db.VarChar(160)
  actionUrl     String?   @map("action_url") @db.VarChar(500)
  eventType     String    @map("event_type") @db.VarChar(120)
  correlationId String?   @map("correlation_id") @db.VarChar(120)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, recipientRole, readAt, id])
  @@index([tenantId, recipientId, readAt, id])
  @@map("decision_notification")
}

// ---------------------------------------------------------------------------
// Fase 1/2 â€” Variables intermedias del grafo (Â§2)
// ---------------------------------------------------------------------------

/// Variable que solo existe DENTRO de una ejecuciÃ³n del grafo que la declara.
/// Deliberadamente NO cuelga de `decision_variable_definition`: el catÃ¡logo global
/// es de variables reutilizables y una intermedia no debe aparecer allÃ­ (Â§2.1).
/// Su unicidad es (versiÃ³n del artefacto, cÃ³digo), no (tenant, cÃ³digo).
model DecisionIntermediateVariable {
  id                BigInt @id @default(autoincrement())
  tenantId          BigInt @map("tenant_id")
  artifactVersionId BigInt @map("artifact_version_id")
  /// Identificador Ãºnico dentro del grafo. Se referencia como `intermediate.<code>`.
  code              String @db.VarChar(120)
  name              String @db.VarChar(160)
  description       String @db.Text
  dataType          String @map("data_type") @db.VarChar(40)

  /// Nodo que la crea. Obligatorio: sin productor no hay disponibilidad calculable.
  producerNodeKey  String   @map("producer_node_key") @db.VarChar(120)
  /// Nodos autorizados a leerla. VacÃ­o = cualquier nodo alcanzable tras el productor.
  consumerNodeKeys String[] @map("consumer_node_keys")

  initialValueJson          Json?                    @map("initial_value_json")
  constraintsJson           Json?                    @map("constraints_json")
  nullable                  Boolean                  @default(true)
