// ---------------------------------------------------------------------------
// Workers adicionales — análisis semántico y extractos bancarios (ADR-0026)
//
// Una tabla por worker, no una tabla genérica de jobs: los dos tienen entradas
// y resultados que no se parecen en nada, y una tabla común habría acabado con
// la mitad de las columnas nulas y un `payload_json` sin forma. Lo que sí es
// común —ciclo de vida, lease, intentos, correlación— se escribe igual en las
// dos, así que el frontend las lee con el mismo código.
// ---------------------------------------------------------------------------

/// Ejecución del worker de análisis semántico.
model SemanticAnalysisRun {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  /// Identificador público. Es lo que viaja al frontend y a los logs; el `id`
  /// numérico no sale del motor.
  requestId      String @map("request_id") @db.VarChar(64)
  /// Clave de deduplicación acotada al tenant, tal como la define el contrato
  /// original del worker.
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)

  status   WorkerRunStatus @default(QUEUED)
  progress Int             @default(0)

  inputSource   WorkerInputSource @map("input_source")
  /// Texto analizado. Se minimiza al vencer el plazo de retención: se conserva
  /// la trazabilidad, no el contenido.
  inputText     String            @map("input_text") @db.Text
  inputMetadata Json?             @map("input_metadata")
  /// Nombre del escenario cuando `inputSource = FIXTURE`. Permite excluir las
  /// pruebas de cualquier lectura de operación.
  fixtureCode   String?           @map("fixture_code") @db.VarChar(60)

  /// `SemanticAnalysisResult` completo, tal como lo produce el núcleo del worker.
  resultJson   Json?   @map("result_json")
  warningsJson Json?   @map("warnings_json")
  errorCode    String? @map("error_code") @db.VarChar(120)
  errorMessage String? @map("error_message") @db.Text

  attemptCount   Int       @default(0) @map("attempt_count")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  queuedAt       DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  requestedBy   String @map("requested_by") @db.VarChar(160)
  correlationId String @map("correlation_id") @db.VarChar(64)

  /// Portador de traza W3C capturado al encolar. Anulable: una solicitud encolada antes
  /// de esta columna, o con la telemetría apagada, no lo trae y el worker abre una traza
  /// raíz para ella en vez de rechazar el trabajo.
  traceCarrier Json? @map("trace_carrier")

  /// Reenviar la misma solicitud devuelve la ejecución existente en vez de
  /// crear una segunda. Es la idempotencia, y es un índice único porque
  /// confiarla al código deja la puerta abierta a dos peticiones simultáneas.
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, requestId])
  /// El reclamo del worker ordena por este índice; sin él, cada ciclo escanea
  /// la tabla entera para encontrar la fila más antigua en QUEUED.
  @@index([status, queuedAt])
  @@index([tenantId, queuedAt])
  @@map("decision_semantic_analysis_run")
}

/// Ejecución del worker de extractos bancarios.
model BankStatementRun {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  requestId String @map("request_id") @db.VarChar(64)

  status   WorkerRunStatus @default(QUEUED)
  progress Int             @default(0)

  inputSource WorkerInputSource @map("input_source")
  fixtureCode String?           @map("fixture_code") @db.VarChar(60)

  /// Ya saneado en el borde: sin rutas, sin caracteres de control.
  fileName      String @map("file_name") @db.VarChar(255)
  /// SHA-256 del contenido. Es la base de la idempotencia porque el worker
  /// original no traía ninguna y el nombre del archivo no identifica nada.
  fileHash      String @map("file_hash") @db.Char(64)
  fileSizeBytes Int    @map("file_size_bytes")
  /// El documento, mientras hace falta. **Se borra en la misma transacción que
  /// cierra la ejecución**: lo que se conserva es el resultado normalizado, no
  /// el extracto bancario. Es a la vez la decisión de privacidad y el motivo
  /// por el que esta tabla no crece sin cota.
  fileBytes     Bytes? @map("file_bytes")

  /// `NormalizedBankStatement`. Hereda el enmascarado del motor: nunca trae el
  /// número de cuenta completo.
  resultJson Json? @map("result_json")

  warningsJson Json? @map("warnings_json")
  /// Confianza de la EXTRACCIÓN: qué tan bien se leyeron los movimientos.
  /// Conserva el nombre `confidence` porque es la que ya publicaban la API y el
  /// portal, y renombrarla rompería a los dos por una mejora de vocabulario.
  confidence       Decimal? @db.Decimal(4, 3)
  /// Confianza de la CLASIFICACIÓN: qué tan seguro es que el documento sea un
  /// extracto. Es una pregunta distinta de la anterior y por eso es otra columna:
  /// el motor puede estar al 99 % de que es un extracto y al 60 % de algunos
  /// movimientos —eso es revisión de extracción— o al 2 % de que lo sea —eso es
  /// un rechazo, y mandarlo a revisión sería trabajo para nadie.
  documentTypeConfidence Decimal? @map("document_type_confidence") @db.Decimal(4, 3)
  institutionId          String?  @map("institution_id") @db.VarChar(16)
  transactionCount       Int?     @map("transaction_count")

  errorCode    String? @map("error_code") @db.VarChar(120)
  errorMessage String? @map("error_message") @db.Text

  /// Presente sólo con `status` en PENDING_REVIEW o IN_REVIEW.
  reviewReason StatementReviewReason? @map("review_reason")
  /// Presente sólo con `status = PDF_INVALID`.
  rejectionReason StatementRejectionReason? @map("rejection_reason")
  /// 1 alta · 2 media · 3 baja. Se deriva del motivo al entrar en la cola, no se
  /// teclea: una prioridad que se pone a mano se pone a «alta» siempre.
  reviewPriority Int?      @map("review_priority")
  /// Cuándo entró en la cola. Es el origen del «tiempo pendiente», que no se
  /// puede derivar de `queuedAt` —ése es el de la cola del worker, otra espera—.
  reviewOpenedAt DateTime? @map("review_opened_at") @db.Timestamptz(6)
  reviewClaimedBy String?  @map("review_claimed_by") @db.VarChar(160)
  reviewClaimedAt DateTime? @map("review_claimed_at") @db.Timestamptz(6)
  reviewResolvedBy String?  @map("review_resolved_by") @db.VarChar(160)
  reviewResolvedAt DateTime? @map("review_resolved_at") @db.Timestamptz(6)
  /// Lo que decidió quien revisó, en sus palabras. Se conserva aunque el caso se
  /// cierre: es lo único que explica por qué un documento dudoso se aprobó.
  reviewNotes String? @map("review_notes") @db.Text

  attemptCount   Int       @default(0) @map("attempt_count")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  queuedAt       DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  requestedBy   String @map("requested_by") @db.VarChar(160)
  correlationId String @map("correlation_id") @db.VarChar(64)

  /// Portador de traza W3C capturado al encolar. Anulable por el mismo motivo que en
  /// `SemanticAnalysisRun`: compatibilidad con filas y telemetría anteriores a esta columna.
  traceCarrier Json? @map("trace_carrier")

  @@unique([tenantId, fileHash])
  @@unique([tenantId, requestId])
  @@index([status, queuedAt])
  @@index([tenantId, queuedAt])
  /// El orden EXACTO en que la cola de revisión lee: por tenant y estado, dentro
  /// de eso por motivo (la pestaña elegida), y ordenado por prioridad y
  /// antigüedad. Sin él, cada pestaña recorre la tabla entera para contar.
  @@index([tenantId, status, reviewReason, reviewPriority, reviewOpenedAt])
  @@map("decision_bank_statement_run")
}

/// Ejecución del worker de verificación de identidad.
///
/// Tabla propia por lo mismo que las otras dos: su entrada son IMÁGENES y su
/// resultado una decisión con la evidencia que la sostiene, que no se parece ni
/// a un texto clasificado ni a un extracto normalizado.
model IdentityVerificationRun {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  requestId String @map("request_id") @db.VarChar(64)

  status   WorkerRunStatus @default(QUEUED)
  progress Int             @default(0)

  inputSource WorkerInputSource @map("input_source")
  fixtureCode String?           @map("fixture_code") @db.VarChar(60)

  /// SHA-256 de las imágenes juntas (más la clave de deduplicación, si viene).
  /// Es la identidad de la solicitud: el nombre del archivo no identifica nada.
  inputHash        String @map("input_hash") @db.Char(64)
  documentCountry  String @map("document_country") @db.VarChar(2)
  documentFileName String @map("document_file_name") @db.VarChar(255)
  selfieFileName   String @map("selfie_file_name") @db.VarChar(255)
  imageSizeBytes   Int    @map("image_size_bytes")

  /// Las imágenes, mientras hacen falta. **Se borran en la misma actualización
  /// que cierra la ejecución**, igual que el PDF del worker de extractos: lo que
  /// se conserva es la decisión y su evidencia, no la cara ni la cédula de
  /// nadie. Es a la vez la decisión de privacidad y la razón de que esta tabla
  /// no crezca sin cota.
  documentBytes     Bytes? @map("document_bytes")
  documentBackBytes Bytes? @map("document_back_bytes")
  selfieBytes       Bytes? @map("selfie_bytes")

  /// `IdentityVerificationOutcome`. El número de documento viaja enmascarado.
  resultJson   Json? @map("result_json")
  warningsJson Json? @map("warnings_json")

  /// Proyecciones del resultado que se consultan sin abrir el JSON.
  decision        String?  @db.VarChar(30)
  documentType    String?  @map("document_type") @db.VarChar(30)
  similarityScore Decimal? @map("similarity_score") @db.Decimal(4, 3)

  errorCode    String? @map("error_code") @db.VarChar(120)
  errorMessage String? @map("error_message") @db.Text

  attemptCount   Int       @default(0) @map("attempt_count")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  queuedAt       DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  requestedBy   String @map("requested_by") @db.VarChar(160)
  correlationId String @map("correlation_id") @db.VarChar(64)

  traceCarrier Json? @map("trace_carrier")

  @@unique([tenantId, inputHash])
  @@unique([tenantId, requestId])
  @@index([status, queuedAt])
  @@index([tenantId, queuedAt])
  @@map("decision_identity_verification_run")
}

/// Ejecución del worker de locución (audio TTS).
///
/// Tabla propia, como los otros tres. Lo que la distingue es que su resultado
/// **no siempre se genera**: el worker es cache-first, así que una ejecución
/// puede terminar sirviendo un audio que ya existía. Por eso `assetId` y
/// `cacheHit` son columnas y no sólo campos del JSON: son lo que permite medir
/// cuántas locuciones costaron dinero de verdad sin abrir el resultado.
///
/// No guarda el audio: el audio vive en `AudioAsset`, que es la caché
/// compartida. Guardarlo aquí duplicaría cada byte por cada vez que alguien
/// pide la misma frase, que es exactamente lo que la caché existe para evitar.
model AudioTtsRun {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  requestId      String @map("request_id") @db.VarChar(64)
  /// Clave de deduplicación acotada al tenant. Sin una explícita se deriva de
  /// la plantilla, las variables y el idioma: reenviar la misma locución
  /// devuelve la ejecución que ya existe.
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)

  status   WorkerRunStatus @default(QUEUED)
  progress Int             @default(0)

  inputSource WorkerInputSource @map("input_source")
  fixtureCode String?           @map("fixture_code") @db.VarChar(60)

  /// Qué se pidió locutar. La plantilla y sus variables, no el texto ya
  /// compuesto: el texto compuesto vive cifrado en el asset, y escribirlo
  /// también aquí en claro anularía ese cifrado.
  templateCode  String  @map("template_code") @db.VarChar(160)
  variablesJson Json?   @map("variables_json")
  /// Idioma solicitado. Vacío significa «el de la plantilla o el del despliegue».
  language      String? @db.VarChar(20)

  /// Proyecciones del desenlace que se consultan sin abrir el JSON.
  outcome  String? @db.VarChar(20)
  assetId  String? @map("asset_id") @db.Uuid
  cacheHit Boolean @default(false) @map("cache_hit")

  resultJson   Json?   @map("result_json")
  warningsJson Json?   @map("warnings_json")
  errorCode    String? @map("error_code") @db.VarChar(120)
  errorMessage String? @map("error_message") @db.Text

  attemptCount   Int       @default(0) @map("attempt_count")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  queuedAt       DateTime  @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  requestedBy   String @map("requested_by") @db.VarChar(160)
  correlationId String @map("correlation_id") @db.VarChar(64)

  traceCarrier Json? @map("trace_carrier")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, requestId])
  @@index([status, queuedAt])
  @@index([tenantId, queuedAt])
  @@map("decision_audio_tts_run")
}

// ---------------------------------------------------------------------------
// Catálogo y caché del worker de locución.
//
// El paquete original vivía en su propio esquema `audio_tts` con Sequelize y
// siete migraciones propias. Aquí vive en el mismo esquema y el mismo ORM que
// el resto del motor, por el mismo motivo que el catálogo semántico: dos ORM
// contra la misma base parten las transacciones en dos.
//
// Las tres tablas llevan `tenant_id` y el paquete no lo tenía. No es un adorno:
// una plantilla es texto que una organización decidió poner en boca de su
// marca, y la caché guarda el audio ya compuesto CON las variables dentro. Sin
// esa columna, dos organizaciones que locutan la misma frase comparten fila, y
// acertar el texto exacto se convierte en una forma de averiguar qué locutó la
// otra.
// ---------------------------------------------------------------------------

/// Estado de un audio en la caché.
///
/// Se distingue el fallo que se puede reintentar del que no. Un 429 del
/// proveedor se cura solo; un texto que su política rechaza va a fallar igual
/// las tres veces, y reintentarlo sólo gasta cuota.
enum AudioAssetStatus {
  PENDING
  GENERATING
  READY
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

/// Para qué sirve una plantilla.
///
/// `FALLBACK` no es una variante de `STATIC`: es el audio que se sirve cuando
/// NO se puede generar el que se pidió, y el resolutor se niega a degradar
/// hacia una plantilla que no lo declare. Sin esa distinción, un despliegue
/// podría acabar sirviendo como respaldo una frase que menciona un nombre.
enum AudioTemplateStrategy {
  STATIC
  DYNAMIC
  FALLBACK
}

/// Lo que se puede locutar, y con qué texto.
model AudioTemplate {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  code    String @db.VarChar(160)
  version Int    @default(1)

  strategy             AudioTemplateStrategy
  templateText         String                @map("template_text") @db.Text
  /// Idioma de la plantilla. Vacío ⇒ el del despliegue.
  language             String?               @db.VarChar(20)
  /// A qué respaldo degradar cuando ésta no se puede generar.
  fallbackTemplateCode String?               @map("fallback_template_code") @db.VarChar(160)
  isActive             Boolean               @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@map("decision_audio_template")
}

/// Un audio ya compuesto, o el compromiso de componerlo.
///
/// La identidad es `assetKey`: la huella de la plantilla, su versión, el texto
/// ya compuesto, el idioma, el proveedor, el modelo, la voz, su versión, el
/// formato y la frecuencia de muestreo. Cambiar cualquiera de esas cosas
/// produce un asset DISTINTO y nunca sobrescribe uno que ya está `READY`, que
/// es lo que impide servir con la voz nueva un audio calculado con la vieja.
model AudioAsset {
  id       String @id @db.Uuid
  tenantId BigInt @map("tenant_id")

  assetKey        String           @map("asset_key") @db.Char(64)
  templateCode    String           @map("template_code") @db.VarChar(160)
  templateVersion Int              @map("template_version")
  status          AudioAssetStatus @default(PENDING)

  /// El texto ya compuesto, CIFRADO (AES-256-GCM, con el `assetKey` como dato
  /// autenticado). Es la única copia y es la que lee el proveedor: una locución
  /// dinámica lleva dentro el nombre de una persona.
  renderedTextEncrypted String @map("rendered_text_encrypted") @db.Text

  /// Las variables con que se compuso, CIFRADAS igual que el texto. Existen
  /// para la generación por segmentos: sin ellas no se sabe qué tramos son
  /// fijos de la plantilla y cuáles llevan el dato de una persona.
  variablesEncrypted String? @map("variables_encrypted") @db.Text

  /// Cuántos tramos se ensamblaron y cuántos salieron de la caché de
  /// segmentos. `null` en audio generado de una pieza.
  segmentsSummary Json? @map("segments_summary")

  language         String @db.VarChar(20)
  provider         String @db.VarChar(40)
  providerModel    String @map("provider_model") @db.VarChar(128)
  providerVoiceRef String @map("provider_voice_ref") @db.VarChar(255)
  voiceProfile     String @map("voice_profile") @db.VarChar(100)
  voiceVersion     Int    @map("voice_version")
  outputFormat     String @map("output_format") @db.VarChar(64)
  sampleRate       Int    @map("sample_rate")

  /// Unidades reservadas al presupuesto por esta generación. Se liquidan al
  /// terminar y se devuelven si nunca llegó a gastarse.
  reservedUnits Int     @default(0) @map("reserved_units")
  attempts      Int     @default(0)
  correlationId String? @map("correlation_id") @db.VarChar(64)

  /// Arrendamiento de la generación: quién la tomó y hasta cuándo. Es lo que
  /// impide que dos réplicas paguen dos veces por el mismo audio.
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimedBy String?   @map("claimed_by") @db.VarChar(120)

  /// Dónde están los bytes. `db://audio/<id>` con el controlador de base —el
  /// del motor—, `file://…` con el de disco del paquete.
  storageUri     String? @map("storage_uri") @db.Text
  /// El audio, cuando el controlador es la propia base. A diferencia del PDF
  /// del extracto o de las imágenes de la verificación, **esto no se borra al
  /// terminar**: es la caché, y borrarla obligaría a pagar otra vez por la
  /// misma frase. Lo que la acota es que una frase repetida no crea una fila
  /// nueva.
  audioBytes     Bytes?  @map("audio_bytes")
  mimeType       String? @map("mime_type") @db.VarChar(120)
  checksumSha256 String? @map("checksum_sha256") @db.Char(64)
  bytes          BigInt?
  lastErrorCode  String? @map("last_error_code") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, assetKey])
  @@index([tenantId, status])
  @@index([tenantId, templateCode, templateVersion])
  @@map("decision_audio_asset")
}

/// Caché de SEGMENTOS de locución: los tramos fijos de una plantilla y los
/// valores de sus variables, cada uno con su propio audio. Existe para que
/// cambiar una variable no vuelva a pagar la frase entera: el proveedor cobra
/// por carácter y el tramo fijo —casi todo el texto— ya está dicho. Como la
/// caché de frases, no se borra al terminar; lo acota que un segmento repetido
/// no crea fila nueva. Los bytes viven en la fila a propósito: un segmento
/// pesa poco y así la caché no depende del controlador de almacenamiento.
model AudioSegment {
  id       String @id @db.Uuid
  tenantId BigInt @map("tenant_id")

  /// Huella de identidad del tramo: texto + voz + versión + modelo + formato +
  /// ajustes. Sin plantilla: el mismo tramo dicho por la misma voz es el mismo
  /// audio, lo pida la plantilla que lo pida.
  segmentKey String @map("segment_key") @db.Char(64)

  /// El texto del tramo, CIFRADO como el de la frase: un tramo variable lleva
  /// dentro el nombre de una persona.
  textEncrypted String @map("text_encrypted") @db.Text

  audioBytes     Bytes  @map("audio_bytes")
  mimeType       String @map("mime_type") @db.VarChar(120)
  checksumSha256 String @map("checksum_sha256") @db.Char(64)
  bytes          BigInt
  usageUnits     Int    @map("usage_units")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, segmentKey])
  @@map("decision_audio_segment")
}

/// Consumo real por audio generado. Una fila por asset: es idempotente porque
/// liquidar dos veces la misma generación falsearía el presupuesto del mes.
model AudioGenerationUsage {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  assetId    String @map("asset_id") @db.Uuid
  provider   String @db.VarChar(40)
  usageUnits Int    @map("usage_units")
  monthKey   String @map("month_key") @db.VarChar(7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, assetId])
  @@index([tenantId, provider, monthKey])
  @@map("decision_audio_generation_usage")
}

/// Presupuesto del mes, por proveedor.
///
/// Reservado y liquidado van SEPARADOS a propósito: la autorización reserva
/// antes de gastar, así que N peticiones simultáneas no pueden pasarse del
/// límite. Con un solo contador incrementado al terminar, todas verían el
/// presupuesto libre a la vez.
model AudioBudgetWindow {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  provider String @db.VarChar(40)
  monthKey String @map("month_key") @db.VarChar(7)

  reservedUnits Int @default(0) @map("reserved_units")
  settledUnits  Int @default(0) @map("settled_units")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, provider, monthKey])
  @@map("decision_audio_budget_window")
}

/// Generaciones que un actor gastó hoy. El techo por actor y día es lo que
/// impide que una sola cuenta agote el presupuesto de la organización.
model AudioActorGenerationDaily {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  actorId         String @map("actor_id") @db.VarChar(160)
  dayKey          String @map("day_key") @db.VarChar(10)
  generationCount Int    @default(0) @map("generation_count")

  @@unique([tenantId, actorId, dayKey])
  @@index([tenantId, dayKey])
  @@map("decision_audio_actor_generation_daily")
}

// ---------------------------------------------------------------------------
// Catálogo del worker semántico (ADR-0026).
//
// El worker original guardaba esto en su propio esquema `semantic_analysis`
// con Sequelize y tres migraciones propias. Aquí vive en el mismo esquema y el
// mismo ORM que el resto del motor: dos ORM contra la misma base es la clase de
// duplicación que el encargo prohíbe, y además parte las transacciones en dos.
//
// El catálogo son DATOS, no código: añadir una categoría o un alias no exige
// desplegar. Esa era una propiedad del worker original y se conserva.
// ---------------------------------------------------------------------------

/// Categoría contra la que se clasifica un texto.
model SemanticCategory {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  code        String @db.VarChar(120)
  name        String @db.VarChar(200)
  description String @db.Text

  /// Código de la categoría que la contiene; `null` en las raíces del árbol.
  ///
  /// Se guarda el CÓDIGO y no el `id` a propósito: el catálogo son datos que se
  /// siembran e importan por código, y una clave foránea contra `id` obligaría a
  /// ordenar la inserción de padres antes que la de hijos en cada carga. El
  /// árbol se cierra por `(tenant_id, parent_code)` contra `(tenant_id, code)`,
  /// que es único, así que la integridad se conserva sin ese acoplamiento.
  parentCode String? @map("parent_code") @db.VarChar(120)

  /// Ejemplos que SÍ son la categoría, y ejemplos que se le parecen pero NO lo
  /// son. Los contraejemplos son los que evitan el falso positivo, así que
  /// pesan tanto como los positivos.
  positiveExamples     Json @map("positive_examples")
  counterExamples      Json @map("counter_examples")
  restrictions         Json
  relatedCategoryCodes Json @map("related_category_codes")

  /// Confianza mínima para aceptar esta categoría. Es por categoría y no global
  /// porque no todas cuestan lo mismo al equivocarse.
  acceptanceThreshold Decimal @map("acceptance_threshold") @db.Decimal(4, 3)
  /// Sube al cambiar el significado de la categoría. La auditoría guarda con qué
  /// versión se decidió, para que una reclasificación posterior sea explicable.
  version             Int     @default(1)
  isActive            Boolean @default(true) @map("is_active")

  embeddings SemanticCategoryEmbedding[]

  /// El árbol se cierra dentro del tenant: `tenantId` entra en la clave para que
  /// una categoría no pueda colgar de la rama de otro cliente.
  parent   SemanticCategory?  @relation("SemanticCategoryTree", fields: [tenantId, parentCode], references: [tenantId, code], onDelete: Restrict, onUpdate: Cascade)
  children SemanticCategory[] @relation("SemanticCategoryTree")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, parentCode])
  @@map("decision_semantic_category")
}

/// Alias de una entidad conocida, para resolver menciones a su nombre canónico.
model SemanticEntityAlias {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  alias         String  @db.VarChar(200)
  canonicalName String  @map("canonical_name") @db.VarChar(200)
  entityType    String  @map("entity_type") @db.VarChar(60)
  isActive      Boolean @default(true) @map("is_active")

  @@unique([tenantId, entityType, alias])
  @@index([tenantId, isActive])
  @@map("decision_semantic_entity_alias")
}

/// Vector de una categoría, para la recuperación híbrida de candidatos.
model SemanticCategoryEmbedding {
  id         BigInt @id @default(autoincrement())
  categoryId BigInt @map("category_id")

  /// El modelo forma parte de la clave: vectores de modelos distintos no son
  /// comparables entre sí, y mezclarlos produce una similitud sin significado.
  model   String @db.VarChar(120)
  version Int    @default(1)
  /// Se guarda como JSON y no como `vector` de pgvector para no exigir una
  /// extensión de PostgreSQL que este despliegue puede no tener. La similitud
  /// se calcula en el worker; con catálogos de este tamaño es suficiente.
  vector  Json

  category SemanticCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, model])
  @@map("decision_semantic_category_embedding")
}

/// Consumo por tenant dentro de una ventana temporal.
model SemanticTenantBudget {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  /// Inicio de la ventana, truncado. Vive en la base y no en memoria porque el
  /// límite debe respetarse entre TODAS las réplicas del worker, no dentro de
  /// un proceso.
  windowStart   DateTime @map("window_start") @db.Timestamptz(6)
  analyses      Int      @default(0)
  providerCalls Int      @default(0) @map("provider_calls")

  @@unique([tenantId, windowStart])
  @@map("decision_semantic_tenant_budget")
}

/// Un valor que debía pertenecer a un catálogo y no se pudo resolver con confianza.
///
/// Existe para que el motor nunca invente una categoría ni pierda el dato. Cuando
/// el clasificador se abstiene —o duda— la glosa no se descarta: se guarda TAL
/// COMO LLEGÓ, con su mejor recomendación y su contexto, y se escala a quien
/// pueda decidir.
///
/// La unicidad por `(tenant, source, normalizedValue)` es lo que hace que el
/// mismo término repetido sume apariciones en vez de crear pendientes y avisos
/// duplicados; el valor crudo se conserva aparte porque normalizar es una
/// conveniencia de búsqueda, no la verdad de lo que se recibió.
model UnresolvedClassification {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  /// El valor exactamente como se recibió. Nunca se sobrescribe.
  rawValue        String @map("raw_value") @db.Text
  /// Forma comparable: sirve para deduplicar, no para decidir.
  normalizedValue String @map("normalized_value") @db.VarChar(500)

  /// Quién produjo el valor: worker, importación, ejecución de un algoritmo…
  source  String @db.VarChar(120)
  /// Dónde apareció: identificadores de la ejecución, la variable o el artefacto.
  context Json   @default("{}")

  suggestedCategoryCode String?  @map("suggested_category_code") @db.VarChar(120)
  /// Confianza de la recomendación, en [0,1].
  confidence            Decimal? @db.Decimal(4, 3)
  /// Otras candidatas con su confianza, de mayor a menor.
  alternatives          Json     @default("[]")

  occurrenceCount Int      @default(1) @map("occurrence_count")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt      DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  /// PENDING | RESOLVED | IGNORED | REJECTED | AUTO_RESOLVED
  status String @default("PENDING") @db.VarChar(20)

  resolvedCategoryCode String?   @map("resolved_category_code") @db.VarChar(120)
  resolvedBy           String?   @map("resolved_by") @db.VarChar(160)
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// USE_SUGGESTED | ASSIGN_EXISTING | CREATE_CATEGORY | CREATE_ALIAS | DISCARD | NOT_CATEGORIZED
  resolutionType       String?   @map("resolution_type") @db.VarChar(30)
  metadata             Json      @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, source, normalizedValue])
  @@index([tenantId, status, occurrenceCount])
  @@index([tenantId, status, lastSeenAt])
  @@map("decision_unresolved_classification")
}

/// Bitácora de la consola SQL: quién consultó qué, cuándo y con qué resultado (ADR-0031).
///
/// Es la única ESCRITURA de todo el módulo, y existe por una razón que no es de producto:
/// una superficie donde una persona puede cruzar libremente datos de decisiones sobre
/// personas no es defendible ante un auditor si no queda registro de lo que se preguntó.
/// La consola es de sólo lectura para el analista; para el sistema no puede serlo, porque
/// «nadie escribió nada» y «nadie sabe qué se leyó» son la misma frase vista desde fuera.
///
/// Se guarda el TEXTO de la consulta y no sus resultados. La distinción importa: el texto
/// dice qué se quiso saber —que es lo que se audita— mientras que guardar las filas
/// devueltas crearía una segunda copia de los datos, con su propio ciclo de vida y su
/// propio riesgo, justo lo que el módulo evita al no publicar PII.
model SqlConsoleQueryLog {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt  @map("tenant_id")
  /// Sujeto de la sesión que lanzó la consulta, tal como lo emite el proveedor de identidad.
  actorId   String  @map("actor_id") @db.VarChar(160)
  /// Petición HTTP que la originó. Es lo que une esta fila con la traza y el registro de acceso.
  requestId String? @map("request_id") @db.VarChar(120)

  /// El SQL tal cual se envió, sin normalizar. Normalizarlo perdería justo lo que se audita.
  statement String   @db.Text
  /// Relaciones que el PLAN recorrió. Responde «¿alguien consultó la cartera?» sin leer el SQL.
  relations String[]

  /// VALIDATED (sólo se planificó) | SUCCEEDED | REJECTED (guardia) | FAILED (error del motor)
  outcome   String  @db.VarChar(20)
  /// Código del rechazo o del fallo. Nulo cuando salió bien.
  errorCode String? @map("error_code") @db.VarChar(60)

  rowCount      Int?    @map("row_count")
  durationMs    Int?    @map("duration_ms")
  /// Filas que el planificador estimó. Comparada con `rowCount` delata una estadística vieja.
  estimatedRows BigInt? @map("estimated_rows")
  /// El resultado se cortó en el tope de filas.
  truncated     Boolean @default(false)

  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz(6)

  @@index([tenantId, executedAt])
  /// El historial de la consola se pide SIEMPRE por actor: cada quien ve lo suyo.
  @@index([tenantId, actorId, executedAt])
  @@map("sql_console_query_log")
}
