/// Constancia de una solicitud de titular de datos.
///
/// Existe por accountability: LGPD art. 18 §1 obliga a responder, y la prueba de que se
/// respondió —qué se pidió, quién lo atendió, cuándo y con qué alcance— no puede vivir solo
/// en el registro de auditoría, porque ahí no se puede consultar «todas las solicitudes de
/// este titular» sin recorrer la cadena entera.
///
/// El titular se identifica por el MISMO HMAC que usa `decision_execution`, así que la
/// referencia en claro nunca se persiste.
model DecisionDataSubjectRequest {
  id                   BigInt                   @id @default(autoincrement())
  tenantId             BigInt                   @map("tenant_id")
  subjectReferenceHash String                   @map("subject_reference_hash") @db.VarChar(128)
  requestType          DataSubjectRequestType   @map("request_type")
  status               DataSubjectRequestStatus @default(RECEIVED)
  /// Quién registró la solicitud en nombre del titular (operador, canal de atención).
  receivedBy           String                   @map("received_by") @db.VarChar(160)
  /// Contexto del canal: número de ticket, expediente. Nunca el dato del titular.
  reference            String?                  @db.VarChar(200)
  /// Qué se entregó o por qué se rechazó. Sin datos personales: solo el alcance.
  resolutionJson       Json?                    @map("resolution_json")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt           DateTime?                @map("resolved_at") @db.Timestamptz(6)

  @@index([tenantId, subjectReferenceHash, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("decision_data_subject_request")
}

