generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VersionStatus {
  DRAFT
  VALIDATION_FAILED
  VALIDATED
  COMPILED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  DEPLOYED_TO_DEV
  DEPLOYED_TO_STAGING
  DEPLOYED_TO_TEST
  DEPLOYED_TO_PROD
  SUSPENDED
  REJECTED
  RETIRED
}

enum CompileStatus {
  SUCCESS
  FAILED
}

enum ApprovalRequestStatus {
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SKIPPED
}

enum ApprovalOutcome {
  APPROVE
  REQUEST_CHANGES
  REJECT
}

enum TestRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
}

enum TestCaseRunStatus {
  PASS
  FAIL
  ERROR
}

enum DeploymentStatus {
  PREPARING
  ACTIVE
  FAILED
  SUPERSEDED
  ROLLED_BACK
  SUSPENDED
}

enum ExecutionStatus {
  SUCCEEDED
  NO_DECISION
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ManualReviewStatus {
  OPEN
  ASSIGNED
  RESOLVED_APPROVED
  RESOLVED_DECLINED
  CANCELLED
}

/// Clasificación de sensibilidad de un dato del contrato (§1.1 / §3.2).
enum SensitivityClass {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  PII
  SENSITIVE_PII
  SECRET
}

/// Licitud de USO de un dato en una decisión automatizada.
///
/// Es un eje distinto de `SensitivityClass`, y confundirlos fue el hueco que cerró esta
/// enumeración: la sensibilidad dice cuánto hay que proteger un dato, esto dice si puede
/// influir en la decisión. Un ingreso mensual es `CONFIDENTIAL` y perfectamente utilizable;
/// la etnia puede estar bien protegida y aun así no poder tocar el resultado.
enum DecisionUseRestriction {
  /// Sin restricción de uso.
  NONE
  /// Base prohibida. ECOA §1002.6(b)(9) y Reg B prohíben que influya en una decisión
  /// crediticia: raza, color, religión, origen nacional, sexo, estado civil, edad y
  /// recepción de asistencia pública. No se admite excepción por configuración.
  PROHIBITED_BASIS
  /// Categoría especial: LGPD art. 11 (origen racial o étnico, convicción religiosa, salud,
  /// biometría, genética). Su tratamiento exige una base legal declarada, así que se admite
  /// solo cuando la versión que la consume declara la suya.
  SPECIAL_CATEGORY
}

/// Base legal del tratamiento que realiza una versión de artefacto (LGPD arts. 7 y 11).
enum ProcessingLegalBasis {
  /// Consentimiento del titular (LGPD art. 7 I).
  CONSENT
  /// Ejecución de contrato o diligencias preliminares (art. 7 V).
  CONTRACT
  /// Cumplimiento de obligación legal o regulatoria (art. 7 II).
  LEGAL_OBLIGATION
  /// Ejercicio regular de derechos (art. 7 VI).
  REGULATORY_EXERCISE
  /// Protección del crédito (art. 7 X) — la hipótesis propia de un motor de decisión
  /// crediticia, y por eso la que se espera en la mayoría de artefactos de originación.
  CREDIT_PROTECTION
  /// Interés legítimo del controlador (art. 7 IX), que exige prueba de proporcionalidad.
  LEGITIMATE_INTEREST
  /// Protección de la vida o la incolumidad física (art. 7 VII).
  VITAL_INTEREST
  /// Tutela de la salud (art. 11 II f), sólo por profesionales o autoridad sanitaria.
  HEALTH_PROTECTION
}

/// Etiqueta del resultado REAL de una decisión, observado tiempo después de tomarla.
///
/// Es la pieza sin la cual no existe *outcome analysis* (SR 11-7 §V; CMN 4.557 art. 40): el
/// motor sabe qué decidió, y hasta ahora nadie le contaba nunca si acertó.
enum ObservedOutcomeLabel {
  /// El crédito se comportó como se esperaba de una aprobación.
  GOOD
  /// Incumplimiento, fraude confirmado o pérdida: la aprobación fue un error.
  BAD
  /// Rechazado y, por evidencia posterior, se habría comportado bien. Alimenta el coste de
  /// oportunidad, que es la mitad del análisis que casi nadie mide.
  REJECTED_WOULD_HAVE_BEEN_GOOD
  /// Rechazado y la evidencia posterior confirma que fue correcto.
  REJECTED_CONFIRMED_BAD
  /// Sin desenlace todavía, o no observable. Se registra igual para distinguir «no se sabe»
  /// de «nadie lo miró».
  INDETERMINATE
}

/// Exigencia de identificar al sujeto de la decisión, por ambiente y por versión.
///
/// `subject_reference` nació OPCIONAL, y de él cuelgan el historial del solicitante, el
/// desenlace observado, la exposición acumulada y el derecho de acceso del titular. Un campo
/// opcional del que depende todo eso es, en la práctica, un campo vacío: las consultas
/// devuelven cero filas y «cero filas» es indistinguible de «no hubo». Peor todavía, la
/// referencia se guarda como HMAC de una vía, así que una ejecución escrita sin sujeto NO SE
/// PUEDE REPARAR después: no hay forma de reconstruir a quién pertenecía.
///
/// Por eso la exigencia es una política y no un interruptor global: poner `REQUIRED` de golpe
/// rompería a todo integrador vivo el día del despliegue, y una migración de contrato se hace
/// midiendo primero cuánto falta.
enum SubjectReferencePolicy {
  /// Sin sujeto no hay decisión: 400 `SUBJECT_REFERENCE_REQUIRED`. El destino de producción.
  REQUIRED
  /// Ejecuta, pero la ausencia cuenta en la métrica de cobertura. El estado de migración.
  WARN
  /// Decisiones que legítimamente no tienen sujeto (reglas de sistema, enrutado interno).
  /// Exige justificación escrita en la versión: si nadie la escribe, es que no era el caso.
  NOT_APPLICABLE
}

/// Qué hacer cuando un dato llega más viejo que su SLA de frescura (§Ola 3).
///
/// `freshnessSlaSeconds` se declaraba en `decision_variable_source` desde el principio y NO SE
/// IMPONÍA en ninguna parte: una variable con SLA de 60 s se aceptaba con un valor de hace tres
/// días y nadie se enteraba. Para microcrédito eso es grave, porque la señal buena —comportamiento
/// de pago, saldos, extracto— cambia todos los días, y un dato viejo no es un dato menos preciso:
/// es la respuesta a otra pregunta.
enum FreshnessPolicy {
  /// 400 `VARIABLE_STALE`. Para las variables sin las que la decisión no significa nada.
  REJECT
  /// Ejecuta con el valor viejo, marca la ejecución como degradada y lo deja en la traza.
  /// Por omisión en la migración: subir todo a `REJECT` de golpe rompería decisiones vivas.
  DEGRADE
  /// Ni marca. Sólo para variables que no entran en la decisión (etiquetas, referencias).
  IGNORE
}

/// Qué significa económicamente una salida del contrato (§Ola 4).
///
/// Que sea un rol declarado y no una convención de nombre importa por tres cosas: el motor puede
/// validar el rango (una probabilidad fuera de [0,1] es un defecto, no un valor), la calibración
/// sabe qué columna mirar sin que nadie se la diga, y la pantalla puede pintarla como lo que es.
enum OutputSemanticRole {
  /// Ninguno declarado. Es lo que tienen todos los contratos anteriores a esta migración.
  NONE
  /// Probabilidad de incumplimiento, en [0,1].
  PROBABILITY_OF_DEFAULT
  /// Pérdida dado el incumplimiento, en [0,1].
  LOSS_GIVEN_DEFAULT
  /// Exposición en el momento del incumplimiento, importe.
  EXPOSURE_AT_DEFAULT
  /// Pérdida esperada, importe.
  EXPECTED_LOSS
  /// Grado o banda de riesgo. Categórico y ordenado.
  RISK_GRADE
  /// Tasa ofrecida, en tanto por uno.
  PRICED_RATE
  /// Límite aprobado, importe.
  APPROVED_LIMIT
  /// Plazo aprobado, en meses.
  APPROVED_TERM
}

/// Qué clase de decisión toma un artefacto (§Ola 5).
///
/// No es una etiqueta decorativa: determina qué contexto es OBLIGATORIO —una decisión de cobranza
/// sin comportamiento de pago es un error de diseño, no una decisión pobre—, qué ventanas de
/// desenlace aplican y contra qué línea base se mide. El motor sólo modelaba la originación, y en
/// un negocio de microcrédito la mayoría de las decisiones —y casi todo el margen— están después.
enum DecisionKind {
  ORIGINATION
  /// Aumento o reducción de línea sobre un cliente que ya está dentro.
  LIMIT_MANAGEMENT
  RENEWAL
  RESTRUCTURE
  COLLECTIONS
  EARLY_WARNING
  FRAUD_SCREENING
  /// Reglas de sistema, enrutado interno: no deciden sobre una persona.
  OPERATIONAL
}

/// Estado de una solicitud de reidentificación de un sujeto seudónimo (§Ola 6).
enum ReidentificationStatus {
  REQUESTED
  APPROVED
  REJECTED
  /// Aprobada y ya usada. Una autorización gastada no vale para la siguiente consulta.
  CONSUMED
}

/// Veredicto de una métrica de vigilancia frente a su umbral.
enum MonitoringVerdict {
  OK
  /// Merece mirada humana; todavía no obliga a nada.
  WATCH
  /// Fuera de umbral. Un `BREACH` abierto sobre una versión en producción se avisa.
  BREACH
}

/// Tipo de solicitud de un titular de datos (LGPD art. 18; CCPA/CPRA §1798.100 y ss.).
enum DataSubjectRequestType {
  /// Confirmación y acceso a las decisiones tomadas sobre el titular (art. 18 I y II).
  ACCESS
  /// Portabilidad de esos datos (art. 18 V).
  PORTABILITY
  /// Eliminación (art. 18 VI). No alcanza la cadena de auditoría, que es append-only y se
  /// conserva por obligación legal (art. 16 I).
  ERASURE
  /// Revisión humana de una decisión automatizada (art. 20).
  REVIEW
}

/// Estado de una solicitud de titular.
enum DataSubjectRequestStatus {
  RECEIVED
  FULFILLED
  REJECTED
}

/// Estado del ciclo de vida de una variable del catálogo (§1.1).
enum VariableLifecycleState {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

/// Estrategia de actualización de una variable intermedia (§2.2).
enum IntermediateUpdatePolicy {
  /// Solo el nodo productor puede escribirla, y una única vez por ejecución.
  SINGLE_WRITE
  /// El nodo productor puede reescribirla en cada visita (bucles controlados).
  OVERWRITE
  /// Cada escritura acumula sobre el valor previo (sumas, listas).
  ACCUMULATE
}

/// Política de inclusión de un valor en la traza persistida (§2.2 / §3.2).
enum TracePolicy {
  FULL
  MASKED
  REDACTED
  EXCLUDED
}

/// Origen que produce un campo del contrato de salida (§4).
enum OutputSourceKind {
  NODE
  EXPRESSION
  INTERMEDIATE
  CONSTANT
  REFERENCE
}

/// Estado de gobierno de un campo calculado (§5.2).
enum CalculatedFieldStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  DEPRECATED
  RETIRED
}

/// Modalidad de implementación de un campo calculado (§6).
enum CalculatedFieldImplKind {
  OPERATION
  JAVASCRIPT
  PYTHON
}

/// Estado de una librería en el registro autorizado (§7).
enum ApprovedLibraryStatus {
  APPROVED
  RESTRICTED
  BLOCKED
}

/// Estado de una corrida de generación masiva de QA (§10).
enum QaRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// Ciclo de vida de una ejecución de worker adicional (ADR-0026).
///
/// `SUCCEEDED_WITH_WARNINGS` no es un adorno: los dos workers producen
/// resultados útiles pero revisables —el semántico degrada a `UNKNOWN` al
/// agotar el presupuesto del tenant, y el de extractos entrega movimientos con
/// su nivel de confianza y sus avisos de validación financiera—. Colapsarlo con
/// `SUCCEEDED` escondería justo lo que hay que mirar.
enum WorkerRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_WARNINGS
  FAILED
  CANCELLED
  /// Espera a una persona. **No es un fallo**: el motor llegó hasta donde pudo y
  /// la duda que queda es real. Sólo lo produce el worker de extractos por ahora;
  /// vive en el enum común porque el ciclo de vida de una ejecución es uno.
  PENDING_REVIEW
  /// Alguien lo reclamó y lo está mirando. Separado de `PENDING_REVIEW` para que
  /// dos analistas no trabajen sobre el mismo caso sin saberlo.
  IN_REVIEW
  /// El documento NO era lo que este worker procesa, y hay evidencia suficiente
  /// para afirmarlo. Es terminal y **nunca entra en la cola de revisión**: una
  /// cola con facturas dentro deja de revisarse.
  PDF_INVALID
}

/// Por qué un documento espera a una persona. Va SEPARADO del estado: el estado
/// dice dónde está el caso, el motivo dice qué hay que resolver, y mezclarlos
/// obliga a inventar un estado nuevo cada vez que aparece una causa nueva.
enum StatementReviewReason {
  /// El procesamiento superó su presupuesto de tiempo. El documento sigue siendo
  /// válido; lo que se agotó es la paciencia razonable de quien espera.
  TIMEOUT
  /// Se extrajo, y la confianza de la extracción quedó por debajo del corte.
  LOW_CONFIDENCE
  /// Se parece a un estado de cuenta y las señales no bastaron para confirmarlo.
  DOUBTFUL_DOCUMENT
  /// Es un estado de cuenta y no se reconoció la entidad, o su formato no tiene
  /// analizador verificado.
  UNKNOWN_BANK
  /// Se reconoció el documento y no se obtuvieron movimientos utilizables.
  PARTIAL_EXTRACTION
  /// Las comprobaciones contables no cuadran: saldos, totales o continuidad.
  AMBIGUOUS_DATA
  /// No hay capa de texto aprovechable y el reconocimiento óptico no la produjo.
  OCR_ERROR
  /// Alguien lo mandó a revisar a mano. Es el único motivo que no calcula el motor.
  MANUAL_REQUEST
}

/// Por qué se rechazó un documento. Los cinco son afirmaciones sobre el ARCHIVO
/// o su contenido, nunca sobre el estado del motor: un fallo del motor se
/// reintenta, no se le echa la culpa a quien subió el documento.
enum StatementRejectionReason {
  /// El PDF es legítimo y no es un extracto bancario.
  NOT_BANK_STATEMENT
  /// El archivo no es un PDF admisible: extensión, tipo, firma o tamaño.
  UNSUPPORTED_FILE
  /// El PDF no tiene contenido: cero bytes útiles o cero páginas.
  EMPTY_DOCUMENT
  /// El PDF no se pudo abrir: estructura dañada.
  CORRUPTED_PDF
  /// El PDF se abre y no se puede leer: cifrado o protegido por contraseña.
  UNREADABLE_DOCUMENT
}

/// De dónde salió la entrada de una ejecución. Separar el fixture del dato real
/// permite excluir las pruebas de cualquier lectura de operación.
enum WorkerInputSource {
  FIXTURE
  UPLOAD
  INLINE
}

/// Progreso de tutoriales por usuario. No hay tabla de usuarios (la identidad
/// viene del IdP / credencial), así que se llavea por (tenant, userId, tutorialId).
model UserTutorialProgress {
  id          BigInt    @id @default(autoincrement())
  tenantId    BigInt    @map("tenant_id")
  userId      String    @map("user_id") @db.VarChar(200)
  tutorialId  String    @map("tutorial_id") @db.VarChar(200)
  status      String    @default("STARTED") @db.VarChar(30)
  lastStep    Int       @default(0) @map("last_step")
  version     Int       @default(1)
  autoShow    Boolean   @default(true) @map("auto_show")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, userId, tutorialId])
  @@index([tenantId, userId])
  @@map("user_tutorial_progress")
}

model DecisionEnvironment {
  id              BigInt   @id @default(autoincrement())
  code            String   @unique @db.VarChar(40)
  name            String   @db.VarChar(120)
  environmentType String   @map("environment_type") @db.VarChar(40)
  status          String   @default("ACTIVE") @db.VarChar(30)
  isProduction    Boolean  @default(false) @map("is_production")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Exigencia de sujeto en este ambiente. `WARN` en la migración para no romper a los
  /// integradores vivos; producción sube a `REQUIRED` cuando la cobertura medida lo permite.
  subjectReferencePolicy SubjectReferencePolicy @default(WARN) @map("subject_reference_policy")

  deployments DecisionDeployment[]
  bindings    DecisionRuntimeBinding[]
  executions  DecisionExecution[]

  @@map("decision_environment")
}

model DecisionArtifact {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt   @map("tenant_id")
  artifactCode    String   @map("artifact_code") @db.VarChar(100)
  artifactType    String   @map("artifact_type") @db.VarChar(50)
  name            String   @db.VarChar(160)
  description     String?  @db.Text
  ownerTeam       String   @map("owner_team") @db.VarChar(100)
  businessPurpose String   @map("business_purpose") @db.Text
  riskDomain      String   @map("risk_domain") @db.VarChar(50)
  /// Qué clase de decisión toma. Determina qué contexto es obligatorio, qué ventanas de
  /// desenlace aplican y contra qué línea base se mide. `ORIGINATION` por omisión porque es
  /// lo único que el motor modelaba antes de esta migración.
  decisionKind    DecisionKind @default(ORIGINATION) @map("decision_kind")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions DecisionArtifactVersion[]

  @@unique([tenantId, artifactCode])
  @@index([tenantId, isActive])
  @@map("decision_artifact")
}

model DecisionArtifactVersion {
  id                BigInt        @id @default(autoincrement())
  artifactId        BigInt        @map("artifact_id")
  versionNumber     Int           @map("version_number")
  status            VersionStatus @default(DRAFT)
  sourceVersionId   BigInt?       @map("source_version_id")
  semanticVersion   String        @map("semantic_version") @db.VarChar(40)
  changeSummary     String?       @map("change_summary") @db.Text
  authoringNotes    String?       @map("authoring_notes") @db.Text
  canonicalChecksum String?       @map("canonical_checksum") @db.VarChar(128)
  lockVersion       Int           @default(1) @map("lock_version")

  /// Finalidad declarada del tratamiento (LGPD art. 6 I: finalidades legítimas, específicas
  /// y explícitas). En texto libre a propósito: la finalidad es una afirmación de negocio,
  /// no un código, y tiene que poder leerse tal cual en un informe.
  processingPurpose String?               @map("processing_purpose") @db.Text
  /// Base legal del tratamiento. Opcional para no invalidar las versiones ya publicadas,
  /// pero OBLIGATORIA para publicar una versión que consuma una variable `SPECIAL_CATEGORY`.
  legalBasis        ProcessingLegalBasis? @map("legal_basis")

  /// Excepción a la política del ambiente para ESTE artefacto. Nula = manda el ambiente.
  /// Sólo tiene sentido endurecerla o declarar `NOT_APPLICABLE`; relajar una exigencia de
  /// producción desde el artefacto sería una puerta trasera al control, y por eso
  /// `subject-policy.ts` sólo deja que la versión sea igual o más estricta que su ambiente.
  subjectReferencePolicy      SubjectReferencePolicy? @map("subject_reference_policy")
  /// Por qué esta decisión no tiene sujeto. Obligatoria con `NOT_APPLICABLE`: una exención
  /// sin motivo escrito no es una decisión, es un descuido que nadie puede revisar.
  subjectPolicyJustification  String?                 @map("subject_policy_justification") @db.Text

  /// Expediente del modelo (SR 11-7 §V; CMN 4.557 art. 40). El material estaba disperso entre
  /// `DecisionApprovalEvidence`, `BusinessObjective` y `PolicyRequirement`; lo que faltaba era
  /// reunirlo y ponerle VENCIMIENTO. Una validación sin fecha de caducidad se convierte en un
  /// papel de hace tres años que nadie vuelve a mirar.
  validatedBy        String?   @map("validated_by") @db.VarChar(160)
  validatedAt        DateTime? @map("validated_at") @db.Timestamptz(6)
  /// Cuándo toca revalidar. Vencido NO bloquea la ejecución —cortar el crédito de una financiera
  /// por un papel vencido es peor que el papel vencido— pero se marca y no se puede ignorar.
  revalidationDueAt  DateTime? @map("revalidation_due_at") @db.Timestamptz(6)
  /// Limitaciones declaradas: población para la que NO sirve, supuestos, datos que no vio.
  limitationsNotes   String?   @map("limitations_notes") @db.Text
  createdBy         String                @map("created_by") @db.VarChar(160)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt       DateTime?             @map("submitted_at") @db.Timestamptz(6)
  approvedAt        DateTime?             @map("approved_at") @db.Timestamptz(6)
  retiredAt         DateTime?             @map("retired_at") @db.Timestamptz(6)

  artifact              DecisionArtifact                     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  sourceVersion         DecisionArtifactVersion?             @relation("VersionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions       DecisionArtifactVersion[]            @relation("VersionSource")
  compiledArtifacts     DecisionCompiledArtifact[]
  statusHistory         DecisionVersionStatusHistory[]
  variableDependencies  DecisionArtifactVariableDependency[]
  nodes                 DecisionRuleNode[]
  edges                 DecisionRuleEdge[]
  conditions            DecisionRuleCondition[]
  actions               DecisionRuleAction[]
  approvalRequests      DecisionApprovalRequest[]
  testSuites            DecisionTestSuite[]
  deployments           DecisionDeployment[]
  executions            DecisionExecution[]
  changeLogs            DecisionChangeLog[]
  policyLinks           PolicyArtifactLink[]
  nodeScripts           DecisionNodeScript[]
  intermediateVariables DecisionIntermediateVariable[]
  outputContractFields  DecisionOutputContractField[]
  calculatedFieldUses   DecisionArtifactCalculatedFieldUse[]
  qaGenerationRuns      QaGenerationRun[]
  monitoringBaselines   MonitoringBaseline[]
  monitoringEvaluations MonitoringEvaluation[]
  calibrationBuckets    CalibrationBucket[]

  @@unique([artifactId, versionNumber])
  @@index([artifactId, status])
  @@map("decision_artifact_version")
}

model DecisionCompiledArtifact {
  id                   BigInt        @id @default(autoincrement())
  artifactVersionId    BigInt        @map("artifact_version_id")
  compilerVersion      String        @map("compiler_version") @db.VarChar(50)
  runtimeSchemaVersion String        @map("runtime_schema_version") @db.VarChar(50)
  compiledPayloadJson  Json          @map("compiled_payload_json")
  compiledChecksum     String        @map("compiled_checksum") @db.VarChar(128)
  compileStatus        CompileStatus @map("compile_status")
  compiledAt           DateTime      @default(now()) @map("compiled_at") @db.Timestamptz(6)

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  testRuns        DecisionTestRun[]
  deployments     DecisionDeployment[]

  @@unique([artifactVersionId, compiledChecksum])
  @@index([artifactVersionId, compiledAt])
  @@map("decision_compiled_artifact")
}

model DecisionNodeScript {
  id                  BigInt   @id @default(autoincrement())
  tenantId            BigInt   @map("tenant_id")
  artifactVersionId   BigInt   @map("artifact_version_id")
  nodeKey             String   @map("node_key") @db.VarChar(120)
  language            String   @db.VarChar(30)
  sourceCode          String   @map("source_code") @db.Text
  sourceChecksum      String   @map("source_checksum") @db.VarChar(128)
  inputVariablesJson  Json     @map("input_variables_json")
  outputVariablesJson Json     @map("output_variables_json")
  createdBy           String   @map("created_by") @db.VarChar(160)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)

  @@unique([artifactVersionId, nodeKey])
  @@index([tenantId, language])
  @@map("decision_node_script")
}

model DecisionVersionStatusHistory {
  id                BigInt         @id @default(autoincrement())
  artifactVersionId BigInt         @map("artifact_version_id")
  fromStatus        VersionStatus? @map("from_status")
  toStatus          VersionStatus  @map("to_status")
  changedBy         String         @map("changed_by") @db.VarChar(160)
  changedAt         DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)
  reason            String?        @db.Text

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)

  @@index([artifactVersionId, changedAt])
  @@map("decision_version_status_history")
}

model DecisionVariableDefinition {
  id                  BigInt  @id @default(autoincrement())
  tenantId            BigInt  @map("tenant_id")
  variableCode        String  @map("variable_code") @db.VarChar(120)
  canonicalName       String  @map("canonical_name") @db.VarChar(160)
  businessDescription String  @map("business_description") @db.Text
  dataClassification  String  @map("data_classification") @db.VarChar(50)
  ownerTeam           String  @map("owner_team") @db.VarChar(100)
  isSensitive         Boolean @default(false) @map("is_sensitive")
  isActive            Boolean @default(true) @map("is_active")

  /// Clasificación formal de sensibilidad (taxonomía §1.1). `isSensitive` se mantiene
  /// como bandera derivada para no romper consumidores existentes.
  sensitivityClass SensitivityClass       @default(INTERNAL) @map("sensitivity_class")
  /// Ciclo de vida del catálogo: una variable RETIRED no puede añadirse a nuevos contratos.
  lifecycleState   VariableLifecycleState @default(ACTIVE) @map("lifecycle_state")
  /// Versión del contrato en la que se introdujo la variable (§1.1).
  contractVersion  String                 @default("1") @map("contract_version") @db.VarChar(20)
  metadataJson     Json?                  @map("metadata_json")

  /// Licitud de uso en una decisión. Eje independiente de `sensitivityClass`; lo aplica
  /// `graph-decision-use.validator.ts` al publicar, no en ejecución.
  decisionUseRestriction DecisionUseRestriction @default(NONE) @map("decision_use_restriction")

  versions DecisionVariableVersion[]

  @@unique([tenantId, variableCode])
  @@index([tenantId, isActive])
  @@index([tenantId, lifecycleState])
  @@map("decision_variable_definition")
}

model DecisionVariableVersion {
  id                       BigInt    @id @default(autoincrement())
  variableDefinitionId     BigInt    @map("variable_definition_id")
  versionNumber            Int       @map("version_number")
  dataType                 String    @map("data_type") @db.VarChar(40)
  unitCode                 String?   @map("unit_code") @db.VarChar(40)
  nullable                 Boolean   @default(false)
  defaultValueJson         Json?     @map("default_value_json")
  validationSchemaJson     Json?     @map("validation_schema_json")
  derivationExpressionJson Json?     @map("derivation_expression_json")
  effectiveFrom            DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo              DateTime? @map("effective_to") @db.Timestamptz(6)

  /// Nombre visible y descripción por versión: el contrato puede renombrar sin
  /// tocar el código técnico estable de la definición.
  displayName        String? @map("display_name") @db.VarChar(160)
  description        String? @map("description") @db.Text
  /// Restricciones configurables normalizadas (§1.1). Fuente autoritativa que el
  /// backend compila e impone; `validationSchemaJson` queda como proyección JSON-Schema.
  constraintsJson    Json?   @map("constraints_json")
  /// Mensaje de error mostrado cuando la validación falla.
  validationMessage  String? @map("validation_message") @db.VarChar(400)
  exampleValidJson   Json?   @map("example_valid_json")
  exampleInvalidJson Json?   @map("example_invalid_json")
  /// Origen esperado del dato (REQUEST, PROVIDER, DERIVED, CALCULATED_FIELD…).
  expectedOrigin     String  @default("REQUEST") @map("expected_origin") @db.VarChar(40)
  contractVersion    String  @default("1") @map("contract_version") @db.VarChar(20)

  definition         DecisionVariableDefinition           @relation(fields: [variableDefinitionId], references: [id], onDelete: Cascade)
  sources            DecisionVariableSource[]
  validationRules    DecisionVariableValidationRule[]
  artifactUses       DecisionArtifactVariableDependency[]
  executionVariables DecisionExecutionVariable[]

  @@unique([variableDefinitionId, versionNumber])
  @@index([variableDefinitionId, effectiveFrom])
  @@map("decision_variable_version")
}

model DecisionVariableSource {
  id                  BigInt  @id @default(autoincrement())
  variableVersionId   BigInt  @map("variable_version_id")
  sourceSystemCode    String  @map("source_system_code") @db.VarChar(100)
  sourcePath          String  @map("source_path") @db.VarChar(500)
  sourceField         String  @map("source_field") @db.VarChar(160)
  freshnessSlaSeconds Int     @map("freshness_sla_seconds")
  precedence          Int     @default(1)
  isAuthoritative     Boolean @default(false) @map("is_authoritative")

  variableVersion DecisionVariableVersion @relation(fields: [variableVersionId], references: [id], onDelete: Cascade)

  @@unique([variableVersionId, sourceSystemCode, sourcePath, sourceField])
  @@map("decision_variable_source")
}

model DecisionVariableValidationRule {
  id                BigInt @id @default(autoincrement())
  variableVersionId BigInt @map("variable_version_id")
  ruleType          String @map("rule_type") @db.VarChar(50)
  ruleConfigJson    Json   @map("rule_config_json")
  severity          String @db.VarChar(30)
  errorCode         String @map("error_code") @db.VarChar(100)

  variableVersion DecisionVariableVersion @relation(fields: [variableVersionId], references: [id], onDelete: Cascade)

  @@map("decision_variable_validation_rule")
}

model DecisionArtifactVariableDependency {
  id                BigInt  @id @default(autoincrement())
  artifactVersionId BigInt  @map("artifact_version_id")
  variableVersionId BigInt  @map("variable_version_id")
  usageType         String  @map("usage_type") @db.VarChar(50)
  isRequired        Boolean @default(true) @map("is_required")
  fallbackPolicy    String  @map("fallback_policy") @db.VarChar(50)
  dependencyPath    String  @map("dependency_path") @db.VarChar(500)
  /// Qué hacer si el dato llega más viejo que su SLA. `DEGRADE` en la migración porque subir
  /// todo a `REJECT` de golpe rompería decisiones vivas; se endurece variable por variable.
  freshnessPolicy   FreshnessPolicy @default(DEGRADE) @map("freshness_policy")

  artifactVersion DecisionArtifactVersion @relation(fields: [artifactVersionId], references: [id], onDelete: Cascade)
  variableVersion DecisionVariableVersion @relation(fields: [variableVersionId], references: [id], onDelete: Restrict)

  @@unique([artifactVersionId, variableVersionId, dependencyPath])
  @@map("decision_artifact_variable_dependency")
}

model DecisionRuleNode {
  id                BigInt  @id @default(autoincrement())
  artifactVersionId BigInt  @map("artifact_version_id")
