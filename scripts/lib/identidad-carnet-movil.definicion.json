      "producerNodeKey": "VERIFICAR_IDENTIDAD",
      "consumerNodeKeys": []
    },
    {
      "code": "id_liveness",
      "name": "Desenlace de la prueba de vida",
      "description": "Desenlace de la prueba de vida. Sólo existe durante la ejecución que la crea.",
      "dataType": "STRING",
      "producerNodeKey": "VERIFICAR_IDENTIDAD",
      "consumerNodeKeys": []
    }
  ],
  "conditions": [
    {
      "code": "DOCUMENTO_NO_VALIDO",
      "name": "La imagen no es un carnet admisible",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "left": {
              "var": "intermediate.id_codigo_error"
            },
            "right": {
              "value": "IDENTITY_DOCUMENT_NOT_IDENTITY"
            }
          },
          {
            "op": "eq",
            "left": {
              "var": "intermediate.id_codigo_error"
            },
            "right": {
              "value": "IDENTITY_DOCUMENT_TYPE_NOT_ACCEPTED"
            }
          },
          {
            "op": "eq",
            "left": {
              "var": "intermediate.id_codigo_error"
            },
            "right": {
              "value": "IDENTITY_DOCUMENT_UNSUPPORTED"
            }
          }
        ]
      },
      "severity": "BLOCKING",
      "reusable": false
    },
    {
      "code": "IDENTIDAD_CONFIRMADA",
      "name": "Verificado por el worker y por encima de los suelos de esta política",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "left": {
              "var": "intermediate.id_estado_llamada"
            },
            "right": {
              "value": "SUCCEEDED"
            }
          },
          {
            "op": "eq",
            "left": {
              "var": "intermediate.id_decision"
            },
            "right": {
              "value": "VERIFIED"
            }
          },
          {
            "op": "gte",
            "left": {
              "var": "intermediate.id_parecido"
            },
            "right": {
              "value": 0.82
            }
          },
          {
            "op": "gte",
            "left": {
              "var": "intermediate.id_evidencia"
            },
            "right": {
              "value": 0.7
            }
          }
        ]
      },
      "severity": "BLOCKING",
      "reusable": false
    },
    {
      "code": "IDENTIDAD_NO_COINCIDE",
      "name": "El worker afirma que no es la misma persona",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "eq",
        "left": {
          "var": "intermediate.id_decision"
        },
        "right": {
          "value": "NOT_VERIFIED"
        }
      },
      "severity": "BLOCKING",
      "reusable": false
    },
    {
      "code": "COMPORTAMIENTO_MECANICO",
      "name": "Pegó el carnet, no corrigió nada y la fase de identidad duró menos de 40 s",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "left": {
              "var": "identidad_comportamiento_disponible"
            },
            "right": {
              "value": true
            }
          },
          {
            "op": "eq",
            "left": {
              "var": "identidad_comportamiento_pegado_en_carnet"
            },
            "right": {
              "value": true
            }
          },
          {
            "op": "eq",
            "left": {
              "var": "identidad_comportamiento_correcciones_ocr"
            },
            "right": {
              "value": 0
            }
          },
          {
            "op": "lt",
            "left": {
              "var": "identidad_comportamiento_segundos_identidad"
            },
            "right": {
              "value": 40
            }
          }
        ]
      },
      "severity": "BLOCKING",
      "reusable": false
    },
    {
      "code": "CAPTURA_INTERRUMPIDA",
      "name": "La app pasó a segundo plano con la cámara abierta",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "left": {
              "var": "identidad_comportamiento_disponible"
            },
            "right": {
              "value": true
            }
          },
          {
            "op": "eq",
            "left": {
              "var": "identidad_comportamiento_segundo_plano_en_captura"
            },
            "right": {
              "value": true
            }
          }
        ]
      },
      "severity": "BLOCKING",
      "reusable": false
    },
    {
      "code": "COMPORTAMIENTO_AUTOMATIZADO",
      "name": "La heurística de automatización llega a 0,7",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "left": {
