      "optional": false,
      "sensitive": true
    },
    {
      "code": "identidad_pais_documento",
      "dataType": "STRING",
      "name": "País del documento",
      "description": "ISO-3166 alfa-2 del país emisor (BO).",
      "optional": false,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_disponible",
      "dataType": "BOOLEAN",
      "name": "Bitácora del alta disponible",
      "description": "Si AtlasBackend pudo calcular el resumen de comportamiento del alta. Ausente = menos evidencia, nunca en contra.",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_segundos_total",
      "dataType": "INTEGER",
      "name": "Segundos totales del alta",
      "description": "Tiempo del alta descontando el segundo plano.",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_segundos_identidad",
      "dataType": "INTEGER",
      "name": "Segundos en la fase de identidad",
      "description": "Tiempo acumulado en las pantallas de identidad.",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_pegado_en_carnet",
      "dataType": "BOOLEAN",
      "name": "Pegado en campos de identidad",
      "description": "Si se pegó texto en el número de carnet, nombres o nacimiento.",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_correcciones_ocr",
      "dataType": "INTEGER",
      "name": "Correcciones sobre lo leído",
      "description": "Cuántas veces corrigió lo que el OCR prellenó.",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_ratio_errores",
      "dataType": "DECIMAL",
      "name": "Tasa de errores de formulario",
      "description": "Errores de envío y validación sobre envíos.",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_segundo_plano_en_captura",
      "dataType": "BOOLEAN",
      "name": "Captura interrumpida",
      "description": "Si la app pasó a segundo plano con la cámara abierta (posible foto de una foto).",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_abandonos_previos",
      "dataType": "INTEGER",
      "name": "Altas abandonadas antes",
      "description": "Flujos de alta anteriores del mismo cliente que quedaron abandonados.",
      "optional": true,
      "sensitive": false
    },
    {
      "code": "identidad_comportamiento_bot_score",
      "dataType": "DECIMAL",
      "name": "Heurística de automatización",
      "description": "0-1; behavior-summary-v1 de AtlasBackend. Sólo escala a revisión.",
      "optional": true,
      "sensitive": false
    }
  ],
  "outputs": [
