              "value": true
            }
          },
          {
            "op": "gte",
            "left": {
              "var": "identidad_comportamiento_bot_score"
            },
            "right": {
              "value": 0.7
            }
          }
        ]
      },
      "severity": "BLOCKING",
      "reusable": false
    }
  ],
