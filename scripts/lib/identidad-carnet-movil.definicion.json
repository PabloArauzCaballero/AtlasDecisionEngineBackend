      "name": "Evidencia de que la imagen es un carnet",
      "description": "Evidencia de que la imagen es un carnet. Sólo existe durante la ejecución que la crea.",
      "dataType": "DECIMAL",
      "producerNodeKey": "VERIFICAR_IDENTIDAD",
      "consumerNodeKeys": []
    },
    {
      "code": "id_tipo_documento",
      "name": "Tipo de documento reconocido",
