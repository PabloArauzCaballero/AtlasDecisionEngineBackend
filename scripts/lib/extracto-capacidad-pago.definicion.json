{
  "artifact": {
    "artifactCode": "EXTRACTO_CAPACIDAD_PAGO",
    "artifactType": "CREDIT_POLICY",
    "riskDomain": "CREDIT_ORIGINATION",
    "ownerTeam": "RISK_DECISIONING",
    "name": "Capacidad de pago verificada por extracto bancario",
    "description": "Demostración de un nodo que LLAMA a un servicio de worker: convierte el extracto en PDF a movimientos normalizados, guarda el resultado en variables intermedias y decide con ellas.",
    "businessPurpose": "Servir de referencia ejecutable de cómo un algoritmo consume los servicios de los workers absorbidos (ADR-0026) como variables del motor.",
    "semanticVersion": "1.1.0",
    "authoringNotes": "El nodo ANALIZAR_EXTRACTO continúa ante un fallo del servicio con los valores por defecto declarados; la rama EXTRACTO_NO_CONFIABLE es la que recoge ese caso. Portada al repositorio desde la versión 1 (1.1.0) sembrada en DEV, checksum 91769ea02681b2dd507a2d04ed9c6484e312db8e4b4500e7b19b268159c94a01: mismo grafo, mismas condiciones y mismos umbrales (confianza 0,6; 5 movimientos; cobertura 3 y 1,5). El ingreso verificado son los abonos del periodo tal como los suma el motor de extractos (`totals.creditExtracted`), no el total impreso por el banco, que ningún formato especializado publica."
  },
  "inputs": [
    {
      "code": "extracto_pdf_base64",
      "dataType": "STRING",
      "name": "Extracto bancario (PDF en base64)",
      "description": "Documento que la solicitud adjunta. Lo consume el nodo que llama al servicio de extractos; nunca se persiste su valor, sólo su huella.",
      "dataClassification": "PII",
      "isSensitive": true,
      "fallbackPolicy": "FAIL_CLOSED",
      "_sensitivityClassEnOrigen": "PII",
      "_sensitivityClassNota": "El JSON real de v3 trae sensitivityClass='PII' en la columna de gobierno (no confundir con dataClassification, que es OTRA columna). POST /v1/variables no acepta sensitivityClass — sólo UpdateVariableDefinitionDto lo declara, y ese endpoint no está cableado a ninguna ruta (variable.controller.ts no lo expone): al crear esta variable en un Motor vacío queda con el default de esquema INTERNAL, no PII. El guion lo detecta y avisa; corregirlo de verdad es tarea del Motor (exponer un PATCH), no de este puerto."
    },
    {
      "code": "extracto_nombre_archivo",
      "dataType": "STRING",
      "name": "Nombre del archivo del extracto",
      "description": "Nombre original del PDF. Viaja al servicio sólo para la traza.",
      "dataClassification": "INTERNAL",
      "isSensitive": false,
      "fallbackPolicy": "FAIL_CLOSED"
    },
    {
      "code": "cuota_solicitada_extracto",
      "dataType": "DECIMAL",
      "name": "Cuota mensual solicitada",
      "description": "Cuota del crédito que se solicita, en la moneda de la cuenta.",
      "unitCode": "BOB",
      "constraints": {
        "max": 1000000,
        "scale": 2,
        "exclusiveMin": 0
      },
      "dataClassification": "INTERNAL",
      "isSensitive": false,
      "fallbackPolicy": "FAIL_CLOSED"
    }
  ],
  "outputs": [
    {
      "code": "decision_extracto",
      "dataType": "STRING",
      "usageType": "OUTPUT_PRIMARY",
      "name": "Decisión sobre el extracto",
      "description": "Resultado principal del análisis de capacidad de pago sobre el extracto.",
      "constraints": {
        "allowedValues": [
          "APROBADO",
          "APROBADO_CON_CONDICIONES",
          "REVISION_MANUAL",
          "RECHAZADO"
        ]
      },
      "dataClassification": "INTERNAL",
      "isSensitive": false,
      "fallbackPolicy": "NOT_APPLICABLE"
    },
    {
      "code": "motivo_extracto",
      "dataType": "STRING",
      "usageType": "OUTPUT",
      "name": "Motivo de la decisión",
