      "name": "Veces que el ingreso cubre la cuota",
      "description": "Veces que el ingreso cubre la cuota. Sólo existe durante la ejecución que la crea.",
      "dataType": "DECIMAL",
      "producerNodeKey": "DERIVAR_CAPACIDAD",
      "consumerNodeKeys": []
    }
  ],
  "conditions": [
    {
      "code": "EXTRACTO_NO_CONFIABLE",
      "name": "El extracto no es fiable",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "left": {
              "var": "intermediate.ext_estado_llamada"
            },
            "right": {
              "value": "FAILED"
            }
          },
          {
            "op": "lt",
            "left": {
              "var": "intermediate.ext_confianza"
            },
            "right": {
              "value": 0.6
            }
          },
          {
            "op": "lt",
            "left": {
              "var": "intermediate.ext_movimientos"
            },
            "right": {
              "value": 5
            }
          }
        ]
      },
      "severity": "BLOCKING",
      "reusable": true
    },
    {
      "code": "COBERTURA_HOLGADA",
      "name": "Los abonos cubren la cuota con holgura",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "gte",
        "left": {
          "var": "intermediate.ext_cobertura_cuota"
        },
        "right": {
          "value": 3
        }
      },
      "severity": "BLOCKING",
      "reusable": true
    },
    {
      "code": "COBERTURA_SUFICIENTE",
      "name": "Los abonos cubren la cuota de forma ajustada",
      "expressionType": "JSON_AST",
      "expression": {
        "op": "gte",
        "left": {
          "var": "intermediate.ext_cobertura_cuota"
        },
        "right": {
          "value": 1.5
        }
      },
      "severity": "BLOCKING",
      "reusable": true
    }
  ],
  "actions": [],
  "nodes": [
    {
      "key": "START",
      "type": "START",
      "label": "Inicio",
      "terminal": false,
      "config": {
        "description": "Recibe el extracto bancario en PDF (base64) y la cuota mensual solicitada."
      },
      "actions": []
    },
    {
      "key": "ANALIZAR_EXTRACTO",
      "type": "WORKER",
      "label": "Analizar el extracto bancario",
      "terminal": false,
      "config": {
        "onError": "CONTINUE",
        "outputs": [
          {
            "path": "call.status",
            "defaultValue": "FAILED",
            "intermediateCode": "ext_estado_llamada"
          },
          {
            "path": "call.errorCode",
            "defaultValue": "",
            "intermediateCode": "ext_codigo_error"
          },
          {
            "path": "result.quality.overallConfidence",
            "defaultValue": 0,
            "intermediateCode": "ext_confianza"
          },
          {
            "path": "result.totals.creditExtracted",
            "defaultValue": 0,
            "intermediateCode": "ext_total_creditos"
          },
          {
            "path": "result.totals.debitExtracted",
            "defaultValue": 0,
            "intermediateCode": "ext_total_debitos"
          },
          {
            "path": "result.balances.closing",
            "defaultValue": 0,
            "intermediateCode": "ext_saldo_final"
          },
          {
            "path": "result.transactions.length",
            "defaultValue": 0,
            "intermediateCode": "ext_movimientos"
          },
          {
            "path": "result.account.currency",
            "defaultValue": "DESCONOCIDA",
            "intermediateCode": "ext_moneda"
          }
        ],
        "service": "bank-statement",
        "arguments": {
          "fileName": {
            "path": "extracto_nombre_archivo",
            "source": "VARIABLE"
          },
          "documentBase64": {
            "path": "extracto_pdf_base64",
            "source": "VARIABLE"
          }
        },
        "operation": "normalize",
        "timeoutMs": 30000,
        "description": "Llama al servicio de extractos con el PDF de la solicitud y guarda lo que devuelve en variables intermedias."
      },
      "actions": []
    },
    {
      "key": "DERIVAR_CAPACIDAD",
      "type": "EXPRESSION",
      "label": "Derivar capacidad de pago",
      "terminal": false,
      "config": {
        "description": "Toma los abonos del periodo como ingreso verificado y calcula cuántas veces cubren la cuota.",
        "intermediateAssignments": [
          {
            "code": "ext_ingreso_mensual",
            "source": "EXPRESSION",
            "expression": {
              "var": "intermediate.ext_total_creditos"
            }
          },
          {
            "code": "ext_cobertura_cuota",
            "source": "EXPRESSION",
            "expression": {
              "op": "div",
              "left": {
                "var": "intermediate.ext_ingreso_mensual"
              },
              "right": {
                "var": "cuota_solicitada_extracto"
              }
            }
          }
        ]
      },
      "actions": []
    },
    {
      "key": "EVALUAR",
      "type": "CONDITION",
