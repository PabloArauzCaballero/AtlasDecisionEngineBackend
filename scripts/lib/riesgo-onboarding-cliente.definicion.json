{
  "artifact": {
    "artifactCode": "RIESGO_ONBOARDING_CLIENTE",
    "artifactType": "RISK_POLICY",
    "riskDomain": "CUSTOMER_ONBOARDING",
    "ownerTeam": "RISK_DECISIONING",
    "name": "Riesgo de onboarding del cliente",
    "description": "Decide si el alta de un cliente sigue adelante o la mira una persona. Es la política versionada de lo que AtlasBackend resolvía con `risk_heuristic_v0` dentro del código: sin documento de identidad o sin consentimiento vigente el caso va a una persona; con ambos, sigue si el puntaje total alcanza el umbral y, si no, también lo mira una persona. Nunca rechaza: el riesgo de onboarding deriva, no niega.",
    "businessPurpose": "Que la primera evaluación de riesgo de cada cliente la tome una política con versión, aprobación y auditoría, en vez de una heurística en el código del backend que aprobaba sin que nadie la hubiera firmado.",
    "semanticVersion": "1.0.0",
    "authoringNotes": "Equivalente a `risk_heuristic_v0` de AtlasBackend (umbral 65). La falta de evidencia manda sobre el puntaje: se evalúa primero. No existe desenlace de rechazo a propósito."
  },
  "umbral": 65,
  "queueCode": "RIESGO_ONBOARDING",
  "inputs": [
    {
      "code": "has_identity_document",
      "dataType": "BOOLEAN",
      "name": "Documento de identidad presente",
      "description": "El cliente registró un documento de identidad en su expediente."
    },
    {
      "code": "verified_contact_count",
      "dataType": "INTEGER",
      "name": "Contactos verificados",
      "description": "Cuántos medios de contacto (correo, teléfono) confirmó el cliente.",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "code": "has_granted_consent",
      "dataType": "BOOLEAN",
      "name": "Consentimiento vigente",
      "description": "El cliente otorgó y no revocó el consentimiento de tratamiento de datos."
    },
    {
      "code": "identity_score",
      "dataType": "DECIMAL",
      "name": "Puntaje de identidad",
      "description": "Dimensión de identidad del modelo heurístico (0-100).",
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "unitCode": "SCORE_0_100"
    },
    {
      "code": "contact_score",
      "dataType": "DECIMAL",
      "name": "Puntaje de contacto",
      "description": "Dimensión de contacto verificado (0-100).",
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "unitCode": "SCORE_0_100"
    },
    {
      "code": "device_score",
      "dataType": "DECIMAL",
      "name": "Puntaje de dispositivo",
      "description": "Dimensión de dispositivo declarado (0-100).",
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "unitCode": "SCORE_0_100"
    },
    {
      "code": "behavior_score",
      "dataType": "DECIMAL",
      "name": "Puntaje de comportamiento",
      "description": "Dimensión de comportamiento durante el alta (0-100).",
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "unitCode": "SCORE_0_100"
    },
    {
      "code": "consistency_score",
      "dataType": "DECIMAL",
      "name": "Puntaje de consistencia",
      "description": "Coherencia interna del expediente (0-100).",
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "unitCode": "SCORE_0_100"
    },
    {
      "code": "fraud_score",
      "dataType": "DECIMAL",
      "name": "Puntaje de fraude",
      "description": "Probabilidad consolidada de fraude en la solicitud (0-100).",
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "unitCode": "SCORE_0_100"
    },
    {
      "code": "total_score",
      "dataType": "DECIMAL",
      "name": "Puntaje total",
      "description": "Promedio ponderado de las dimensiones (0-100); es lo que se compara con el umbral.",
      "constraints": {
        "minimum": 0,
        "maximum": 100
      },
      "unitCode": "SCORE_0_100"
    },
    {
      "code": "assessment_type",
      "dataType": "STRING",
      "name": "Tipo de evaluación",
      "description": "Contexto de la evaluación de riesgo (onboarding_initial, manual_recheck, …)."
    }
  ],
  "outputs": [
    {
      "code": "riesgo_decision",
      "dataType": "STRING",
      "usageType": "OUTPUT_PRIMARY",
      "name": "Decisión de riesgo",
      "description": "APPROVE sigue adelante; MANUAL_REVIEW lo mira una persona."
    },
    {
      "code": "riesgo_motivo",
      "dataType": "STRING",
      "usageType": "OUTPUT",
      "name": "Motivo",
      "description": "Por qué se decidió así, en una palabra clave."
    },
    {
      "code": "riesgo_faltantes",
      "dataType": "INTEGER",
      "usageType": "OUTPUT",
      "name": "Evidencias faltantes",
      "description": "Cuántas de las dos evidencias obligatorias (identidad, consentimiento) faltan."
    }
  ],
  "reasonCodes": [
    {
      "reasonCode": "MISSING_IDENTITY_DOCUMENT",
      "category": "ONBOARDING_RISK",
      "publicMessage": "Falta el documento de identidad.",
      "internalMessage": "El expediente no tiene documento de identidad registrado; el caso pasa a revisión humana.",
      "severity": "HIGH",
      "isAdverseAction": false
    },
    {
      "reasonCode": "MISSING_CONSENT",
      "category": "ONBOARDING_RISK",
      "publicMessage": "Falta el consentimiento de tratamiento de datos.",
      "internalMessage": "El cliente no otorgó (o revocó) el consentimiento; el caso pasa a revisión humana.",
      "severity": "HIGH",
      "isAdverseAction": false
    },
    {
      "reasonCode": "BELOW_MINIMUM_RISK_SCORE",
      "category": "ONBOARDING_RISK",
      "publicMessage": "El perfil no alcanza el puntaje mínimo de riesgo.",
      "internalMessage": "total_score por debajo del umbral de aprobación; el caso pasa a revisión humana.",
      "severity": "MEDIUM",
      "isAdverseAction": true
    },
    {
      "reasonCode": "MINIMUM_ONBOARDING_RISK_PASSED",
      "category": "ONBOARDING_RISK",
      "publicMessage": "El perfil supera el riesgo mínimo de onboarding.",
      "internalMessage": "Evidencias completas y total_score igual o superior al umbral.",
      "severity": "LOW",
      "isAdverseAction": false
    }
  ],
  "intermediates": [
    {
      "code": "faltantes",
      "name": "Evidencias faltantes",
      "description": "Cuántas de las dos evidencias obligatorias faltan.",
      "dataType": "INTEGER",
      "producerNodeKey": "CONTAR_FALTANTES",
      "consumerNodeKeys": [
