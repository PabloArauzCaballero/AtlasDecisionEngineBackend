  BackgroundColor #FFFFFF
  BorderColor #355C7D
  FontColor #1F2937
}
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #355C7D
  FontColor #1F2937
  DiamondBackgroundColor #FFF7E6
  DiamondBorderColor #D97706
}
title ATLAS — Casos de uso del motor de decisión con segregación de funciones
left to right direction

actor "Risk Analyst" as RA
actor "Fraud Analyst" as FA
actor "QA Analyst" as QA
actor "Compliance Officer" as CO
actor "Business Approver" as BA
actor "Platform Admin" as PA
actor "Independent Auditor" as AU
actor "Operations Support" as OS
actor "Backend Externo" as BE
actor "BI / Monitoring" as BI

rectangle "ATLAS Decision Platform" {
  package "Diseño" {
    usecase "Crear artefacto" as UC01
    usecase "Clonar versión" as UC02
    usecase "Editar flujo visual" as UC03
    usecase "Definir condiciones" as UC04
    usecase "Definir acciones y reason codes" as UC05
    usecase "Gestionar dependencias de variables" as UC06
    usecase "Comparar versiones" as UC07
  }

  package "Validación y pruebas" {
    usecase "Validar topología y semántica" as UC08
    usecase "Compilar versión" as UC09
    usecase "Crear suite de pruebas" as UC10
    usecase "Ejecutar pruebas deterministas" as UC11
    usecase "Ejecutar regresión masiva" as UC12
    usecase "Medir cobertura de nodos/rutas" as UC13
    usecase "Bloquear promoción si falla QA" as UC14
  }

  package "Gobierno" {
    usecase "Solicitar revisión" as UC15
    usecase "Aprobar desde Riesgo" as UC16
    usecase "Aprobar desde Compliance" as UC17
    usecase "Adjuntar evidencia" as UC18
    usecase "Rechazar y pedir cambios" as UC19
    usecase "Verificar segregación de funciones" as UC20
  }

  package "Despliegue" {
    usecase "Desplegar a Sandbox" as UC21
    usecase "Desplegar a Test" as UC22
    usecase "Promover a Producción" as UC23
    usecase "Configurar champion/challenger" as UC24
    usecase "Rollback de despliegue" as UC25
    usecase "Retirar versión" as UC26
  }

  package "Runtime y operación" {
    usecase "Sincronizar contrato de variables" as UC27
    usecase "Ejecutar decisión online" as UC28
    usecase "Resolver variables externas" as UC29
    usecase "Generar explicación y reason codes" as UC30
    usecase "Reprocesar ejecución histórica" as UC31
    usecase "Atender revisión manual" as UC32
  }

  package "Auditoría y monitoreo" {
    usecase "Consultar trazabilidad completa" as UC33
    usecase "Exportar evidencia de auditoría" as UC34
    usecase "Monitorear aprobación, mora y fraude" as UC35
    usecase "Detectar drift operativo" as UC36
    usecase "Reconciliar métricas por versión" as UC37
  }
}

