      {{/if}}

      <section class='cond keep-together'>
        <h2 class='h2'>Condiciones económicas</h2>
        {{#if data.condiciones.length}}
          <table class='cond__tabla'>
            <thead><tr><th scope='col'>Concepto</th><th scope='col' class='num'>Condición</th><th
                  scope='col'
                  class='num'
                >Se cobra</th></tr></thead>
            <tbody>
              {{#each data.condiciones}}
                <tr>
                  <td><strong>{{concepto}}</strong>{{#if detalle}}<span
                        class='cond__detalle'
                      >{{detalle}}</span>{{/if}}</td>
                  <td class='num cond__valor'>{{condicion}}</td>
                  <td class='num cond__cobro'>{{cobro}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <p class='cond__vacio'>Esta propuesta no tiene cargos.</p>
        {{/if}}
        {{#if data.condicionesNota}}<p class='cond__nota'>{{data.condicionesNota}}</p>{{/if}}
      </section>
    </div>
    <footer class='pg__pie'><span>ATLAS · Compras en cuotas para su comercio</span><span
      >{{data.propuesta.numero}}</span></footer>
  </section>

