NODE_ENV=development
PORT=3000
# Reparto de responsabilidades entre procesos (src/common/config/worker-role.ts):
#   ALL    → sirve HTTP y ejecuta los trabajos de fondo (desarrollo, un solo contenedor)
#   API    → solo sirve HTTP; los trabajos de fondo corren en otro proceso
#   WORKER → solo trabajos de fondo (`node dist/worker.js`), sin tráfico de negocio
WORKER_ROLE=ALL
# Puerto de sondas y de /metrics del proceso WORKER, que no expone la API de negocio pero sí
# debe poder sondearse y rasparse (las métricas atlas_job_* / atlas_outbox_* nacen ahí).
WORKER_HEALTH_PORT=3001

# --- Orquestación central de trabajos de fondo (src/common/jobs) -----------------------
# Un lote vacío multiplica su espera por JOB_BACKOFF_FACTOR hasta JOB_MAX_IDLE_INTERVAL_MS;
# el `pg_notify` que emite el productor al confirmar la reinicia. Por eso subir el techo
# abarata el ralentí sin costar latencia: la señal es quien la fija, no el sondeo.
JOB_SCHEDULER_ENABLED=true
JOB_INITIAL_DELAY_MS=500
JOB_MIN_IDLE_INTERVAL_MS=1000
JOB_MAX_IDLE_INTERVAL_MS=30000
JOB_BACKOFF_FACTOR=2
JOB_ERROR_INTERVAL_MS=5000
JOB_MAX_ERROR_INTERVAL_MS=120000
# Pon esto en false si la conexión atraviesa un pgbouncer en modo transaction/statement: no
# propaga LISTEN/NOTIFY. El sistema sigue siendo correcto, solo cae a la latencia del sondeo.
JOB_WAKE_ENABLED=true
JOB_WAKE_CHANNEL=atlas_jobs
BUILD_VERSION=2.0.0
COMMIT_SHA=local
# Published API contract version (changes only on a breaking change, unlike BUILD_VERSION).
# The OpenAPI document is served at /docs/$API_VERSION plus the /docs alias.
API_VERSION=v1

# Runtime connection: the NON-superuser role, so the tenant RLS policies actually apply.
DATABASE_URL=postgresql://atlas_app:change-me-app-db-password@localhost:5432/atlas_decision?schema=public
# Elevated connection used only by migrations and scripts/set-app-db-role.mjs.
ADMIN_DATABASE_URL=postgresql://atlas:change-me-postgres-password@localhost:5432/atlas_decision?schema=public
DATABASE_POOL_MAX=15
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Separación de rutas de datos (ADR-0029) ---------------------------------
# Vacías, lectura y escritura son la MISMA conexión y el comportamiento es el de siempre.
# El registro compara huellas saneadas (motor|proveedor|host:puerto|base|esquema|usuario|tls)
# y reutiliza el pool cuando coinciden, así que declarar la misma URL no abre un pool extra.
#
#   Escenario A (por defecto)  ambas vacías          -> un solo pool
#   Escenario B (recomendado)  roles distintos       -> dos pools, mismo servidor
#   Escenario C (réplica)      otro host             -> lectura eventual, fallback al primario
#
# Aprovisiona los roles con `yarn db:provision:dev` antes de activar el Escenario B.
DATABASE_WRITE_URL=
DATABASE_READ_URL=
# DATABASE_READ_URL=postgresql://atlas_reader:change-me-reader-password@localhost:5432/atlas_decision?schema=public
DATABASE_READ_POOL_MAX=
# Interruptor de la separación. Apagado, toda lectura vuelve al primario: es el rollback
# de esta migración sin desplegar. Enciéndelo cuando la conexión de lectura esté lista.
DATA_READ_ROUTING_ENABLED=false
ENABLE_PRIMARY_READ_FALLBACK=true
# Reglas por módulo en JSON, fusionadas sobre las base. Un JSON inválido impide arrancar.
# DATA_ROUTING_RULES={"views":{"read":"postgres-read","consistency":"eventual"}}
DATA_ROUTING_RULES=

# --- Roles PostgreSQL de desarrollo (yarn db:provision:dev) -------------------
# Aprovisionamiento idempotente y con mínimo privilegio. El lector NO puede escribir y
# ninguno de los dos recibe atributos administrativos; el script lo verifica preguntando
# al motor y sale con código distinto de cero si no se cumple. Nunca corre en producción.
POSTGRES_ADMIN_URL=
POSTGRES_WRITER_ROLE=atlas_writer
POSTGRES_READER_ROLE=atlas_reader
POSTGRES_WRITER_PASSWORD=change-me-writer-password
POSTGRES_READER_PASSWORD=change-me-reader-password
POSTGRES_MANAGED_SCHEMAS=public
# Rol que CREA los objetos (el que corre las migraciones). De él dependen los privilegios
# predeterminados: sin el valor correcto, la tabla de la próxima migración nace sin permisos.
POSTGRES_OBJECT_OWNER_ROLE=

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=atlas:decision
REQUIRE_REDIS_IN_PRODUCTION=true

# Browser portal: IDENTITY_PROVIDER. Use IDENTITY_HYBRID only while trusted
# technical integrations still require API keys.
AUTH_MODE=IDENTITY_PROVIDER
MANAGEMENT_API_KEY=change-me-management-with-at-least-24-characters
RUNTIME_API_KEY=change-me-runtime-with-at-least-24-characters
JWT_JWKS_URL=
JWT_ISSUER=
JWT_MANAGEMENT_AUDIENCE=atlas-decision-management
JWT_RUNTIME_AUDIENCE=atlas-decision-runtime
JWT_TENANT_CLAIM=tenant_id
JWT_ROLES_CLAIM=roles
JWT_JWKS_CACHE_SECONDS=900
JWT_JWKS_TIMEOUT_MS=3000
JWT_CLOCK_SKEW_SECONDS=30

# AtlasBackend identity provider. Include its global prefix, normally /api/v1.
# Use AUTH_MODE=IDENTITY_PROVIDER for the browser portal, or IDENTITY_HYBRID
# when trusted technical integrations still require API keys.
# This value assumes AtlasBackend on the HOST. From inside the container localhost
# is the container itself, so the login answers 503 IDENTITY_PROVIDER_UNAVAILABLE;
# docker-compose.host-expose.yml overrides it with the published address.
IDENTITY_PROVIDER_URL=http://localhost:3001/api/v1
IDENTITY_PROVIDER_TIMEOUT_MS=3000
# Login does more than a read —it hashes the password and mails the PIN—, so it gets its own
# budget. With 3000 it timed out while the provider was still working, and the retry issued a
# second PIN that invalidated the first: two mails, the first one already dead.
IDENTITY_PROVIDER_LOGIN_TIMEOUT_MS=12000
# Retries only on transient provider failures (connection refused / 502-503-504), never on a
# rejected credential and never on a timeout: a timeout does not prove the request failed to
# arrive. Absorbs the brief restart window of the provider dev server. 0 disables it.
IDENTITY_PROVIDER_RETRY_ATTEMPTS=2
IDENTITY_PROVIDER_RETRY_BACKOFF_MS=300
# How long a verified access token is trusted without asking the provider again.
# Without it every protected request revalidated, so one busy screen exhausted the
# provider's timeout and the engine answered 503 on requests at random. This is
# also the revocation lag: a disabled account keeps working for at most this long.
# 0 restores per-request validation.
IDENTITY_PROVIDER_CACHE_TTL_SECONDS=10
IDENTITY_REFRESH_COOKIE_NAME=atlas_refresh
IDENTITY_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
IDENTITY_SESSION_RATE_LIMIT=20

# Origenes del navegador admitidos. 5173 = portal en `yarn dev`; 5180 = portal en
# contenedor (docker-compose del frontend). Gobierna TAMBIEN las rutas de sesion
# (session-origin.service.ts): un origen ausente no falla como CORS, devuelve 403
# UNTRUSTED_ORIGIN en el login y el portal lo muestra como falta de roles.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180
TRUST_PROXY_HOPS=1
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
# Plazo total del apagado ordenado: acota el drenaje de lotes en vuelo y, agotado,
# fuerza la salida. Debe quedar por DEBAJO del terminationGracePeriodSeconds del
# orquestador, o el SIGKILL llegará antes y se perderá el motivo del apagado.
SHUTDOWN_GRACE_MS=20000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MANAGEMENT_REQUESTS=300
RATE_LIMIT_RUNTIME_REQUESTS=1500
AUTH_FAILURE_RATE_LIMIT=20

SWAGGER_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=change-me-metrics-token-with-at-least-24-characters
LOG_LEVEL=debug
# stdout | stdout_and_file. Keep stdout in containers: the root filesystem is read-only,
# so stdout_and_file needs LOG_FILE_PATH to point at a mounted, writable volume.
LOG_OUTPUT=stdout
# LOG_FILE_PATH=logs/atlas-decision-engine.log
ACCESS_AUDIT_ENABLED=true
ACCESS_AUDIT_QUEUE_MAX=1000
ACCESS_AUDIT_RETRY_SECONDS=15

# Credentials consumed by docker-compose.yml. Compose loads this file and declares no
# fallback for any of them, so a missing value fails the stack instead of silently booting
# with a password baked into a versioned file.
# POSTGRES_DB / POSTGRES_USER / REDIS_PORT / API_PORT keep their defaults.
POSTGRES_PASSWORD=change-me-postgres-password
# Host port for the Compose Postgres. The default (5432) collides with a natively installed
# PostgreSQL, which is common on a developer machine; pick a free port and use the SAME one in
# DATABASE_URL / ADMIN_DATABASE_URL, since the host-side tooling reaches the container through it.
POSTGRES_PORT=55432
# Login secret of the non-superuser app role (atlas_app), applied by scripts/set-app-db-role.mjs.
# At least 16 characters and only [A-Za-z0-9_.~-], since ALTER ROLE cannot take a bind parameter.
APP_DB_PASSWORD=change-me-app-db-password

# Bootstrap integration clients used by API_KEY and hybrid modes. API key callers never
# declare their own identity or roles; the seed persists the permitted tenant and scopes.
#
# BOOTSTRAP_TENANT_ID es el tenant de TODO lo que siembra el módulo —variables, motivos,
# librerías, campos calculados, categorías semánticas—, no sólo de estos clientes.
# `SEED_TENANT_ID` se acepta como sinónimo (es el nombre que usaban los guiones de
# `prisma/dev-seeds/`). Un valor que no sea un entero >= 1 hace fallar la siembra en vez de
# caer al 1 en silencio, que es como el catálogo termina en un tenant que nadie pidió.
BOOTSTRAP_TENANT_ID=1
BOOTSTRAP_MANAGEMENT_ROLES=AUDITOR,COMPLIANCE,FRAUD_ANALYST,OPERATIONS,PLATFORM_ADMIN,QA_ANALYST,RISK_ANALYST,RISK_APPROVER
BOOTSTRAP_RUNTIME_ROLES=DECISION_RUNTIME

# --- Origen de las semillas -------------------------------------------------------------------
# Los datos de semilla ya no viven en el repositorio: viven en una RAMA de PostgreSQL gestionado y
# se traen con `yarn prisma:seed`. La rama ES el perfil -la de desarrollo publica tambien el
# artefacto de demostracion; la de produccion, no-, y por eso ya no existe SEED_INCLUDE_MOCKUP: a la
# rama de produccion no se le puede PEDIR lo que no tiene. Como cada rama tiene su propio endpoint,
# cambiar de perfil es cambiar SEED_SOURCE_HOST.
#   1. SEED_SOURCE_DATABASE_URL -> cadena completa; gana sobre todo lo demas.
#   2. SEED_SOURCE_HOST + _DB + _USER + _PASSWORD -> comodo cuando solo cambia la rama.
SEED_SOURCE_DATABASE_URL=
SEED_SOURCE_HOST=
SEED_SOURCE_PORT=5432
SEED_SOURCE_DB=atlas_decision
SEED_SOURCE_USER=
SEED_SOURCE_PASSWORD=
SEED_SOURCE_SSL=true

# Al arrancar, trae el conjunto publicado SI la base esta VACIA. Si ya tiene datos no se toca nada:
# la carga es un reemplazo, no un upsert, y reiniciar un proceso no puede borrar el trabajo de la
# sesion anterior. Para rehacerla a proposito: `yarn prisma:seed`.
# Es trabajo de fondo: solo se ejecuta donde WORKER_ROLE en ALL, WORKER. Una replica de API
# jamas siembra, aunque esto valga true. En despliegues orquestados la fuente de verdad es
# el Job de semilla (docker compose `seed`, deploy/kubernetes/migration-job.yaml).
#
# Las credenciales de integracion (MANAGEMENT_API_KEY, RUNTIME_API_KEY, APPROVER_*) NO vienen de la
# rama: son secretos del entorno y se registran despues de la copia, leyendo estas variables.
STARTUP_SEED_ENABLED=true

# Distributed tracing (OpenTelemetry). Off by default: nothing is patched and no exporter
# runs. Enable alongside an OTLP collector; unset endpoint means the default localhost:4318.
# Local Jaeger: `yarn jaeger:up`, then point the endpoint below at http://localhost:4318/v1/traces
# and browse http://localhost:16686. See docs/observability/README.md.
OTEL_ENABLED=false
# One name PER PROCESS: api and worker must not share it or Jaeger's service graph is useless.
OTEL_SERVICE_NAME=atlas-api
OTEL_SERVICE_NAMESPACE=atlas
# Defaults to BUILD_VERSION / NODE_ENV when left empty.
OTEL_SERVICE_VERSION=
OTEL_DEPLOYMENT_ENVIRONMENT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORT_TIMEOUT_MS=10000
# Parent-based ratio sampler. 1.0 in development; lower it in production against real traffic
# (docs/observability/01-architecture-design.md). Never hardcode the ratio in code.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_DIAG_LOG_LEVEL=ERROR

# (El bloque BOOTSTRAP_* estaba repetido aquí. Un `.env` real toma la ÚLTIMA aparición, así
# que un fichero con dos copias hace que corregir la primera no surta ningún efecto.)

VARIABLE_BACKEND_URL=
VARIABLE_BACKEND_TIMEOUT_MS=1500
AUDIT_HASH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Identifier persisted beside each HMAC. Change it when rotating the active secret.
AUDIT_HASH_KEY_ID=v1
# JSON map of retired key ids to old secrets, used only to verify historical events.
# AUDIT_HASH_PREVIOUS_SECRETS={"v0":"old-secret-at-least-32-characters-long"}
DEFAULT_ENVIRONMENT=PROD
MAX_EXECUTION_STEPS=256
TEST_RUN_WORKER_ENABLED=true
# Suelo y techo del sondeo. Una corrida encolada despierta al worker en el commit, así que
# estos valores solo gobiernan la red de seguridad, no la latencia de arranque.
TEST_RUN_WORKER_POLL_MS=500
TEST_RUN_WORKER_MAX_POLL_MS=30000
TEST_RUN_RECOVERY_INTERVAL_MS=30000
TEST_RUN_WORKER_CONCURRENCY=2
TEST_RUN_LEASE_SECONDS=300
TEST_CASE_CONCURRENCY=4
SCRIPT_NODES_ENABLED=false
# IN_PROCESS is dev/test only. Production requires SIDECAR (see docker-compose.yml's
# script-runner service and docs/CONFIGURABLE_OUTPUTS.md) — the env schema refuses
# SCRIPT_NODES_ENABLED=true in production otherwise.
SCRIPT_RUNNER_MODE=IN_PROCESS
SCRIPT_RUNNER_SOCKET_PATH=/var/run/atlas-runner/runner.sock
# Interpreter for the in-process runner and the Code -> Flow Python syntax checker. The
# SIDECAR image ships only `python3` and sets this itself. `python3` es el único nombre que
# PEP 394 garantiza: el corto `python` no existe en macOS ni en la mayoría de distribuciones.
# En Windows, donde el instalador oficial registra `python`, cámbialo aquí.
PYTHON_EXECUTABLE=python3
SCRIPT_NODE_TIMEOUT_MS=250
SCRIPT_NODE_MAX_SOURCE_BYTES=16384
SCRIPT_NODE_MAX_OUTPUT_BYTES=65536
SCRIPT_NODE_MAX_MEMORY_MB=32
IDEMPOTENCY_TTL_HOURS=24
# Lease held while a decision is PROCESSING; a crashed holder frees the key after this.
IDEMPOTENCY_LEASE_SECONDS=60
# Background purge of expired runtime idempotency rows (highest-volume table).
RUNTIME_RETENTION_SWEEP_ENABLED=true
RUNTIME_RETENTION_SWEEP_INTERVAL_MS=3600000
RUNTIME_IDEMPOTENCY_RETENTION_GRACE_HOURS=24
RUNTIME_RETENTION_SWEEP_BATCH=1000
MAX_PAGE_SIZE=100
AUDIT_VERIFY_BATCH_SIZE=500

# Nested artifacts and Code -> Flow analysis bounds.
NESTED_TREE_MAX_DEPTH=5
NESTED_TREE_DEFAULT_TIMEOUT_MS=2000
NESTED_TREE_GRAPH_MAX_EDGES=2000
# Cotas de la cadena de artefactos encadenados (§9.3).
NESTED_TREE_MAX_ARTIFACTS=25
NESTED_TREE_MAX_TOTAL_MS=10000
NESTED_TREE_MAX_RESULT_BYTES=262144
NESTED_TREE_MAX_RETAINED_BYTES=1048576
CODE_IMPORT_MAX_SOURCE_BYTES=131072
CODE_IMPORT_ANALYSIS_TIMEOUT_MS=2000

# Management-only SSE preview. Keep disabled unless the portal uses the live view.
LIVE_EXECUTION_STREAM_ENABLED=false
LIVE_EXECUTION_STREAM_HEARTBEAT_MS=15000

# Transactional outbox relay: dispatches domain events written by business transactions
# to the in-process event bus (notifications, projections). Backoff is exponential via
# available_at; after OUTBOX_MAX_ATTEMPTS the event moves to DEAD (dead-letter).
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_MAX_INTERVAL_MS=30000
# Cada cuánto se cuenta el backlog para el gauge atlas_outbox_pending.
OUTBOX_BACKLOG_SAMPLE_MS=30000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_MS=30000

# Runtime smoke (yarn smoke). It reuses MANAGEMENT_API_KEY / RUNTIME_API_KEY / PORT /
# BOOTSTRAP_TENANT_ID / DEFAULT_ENVIRONMENT from this same file — it holds no credential of
# its own. Override only to point it at another instance, tenant or artifact.
# BASE_URL=http://127.0.0.1:3000
# TENANT_ID=1
SMOKE_ARTIFACT_CODE=BNPL_CREDIT_DECISION

# --- Perfil de observabilidad (compose.observability.yml) ------------------------------
# Solo se leen al levantar ese perfil:
#   docker compose -f docker-compose.yml -f compose.observability.yml \
#     --profile observability up -d
#
# Prometheus raspa /metrics de la API (3000) Y del worker (3001). Raspar solo la API deja
# el panel del outbox vacío: atlas_outbox_*, atlas_job_* y atlas_notification_created_total
# los produce únicamente el worker. Se autentica con METRICS_TOKEN, que ya está arriba,
# enviado como `Authorization: Bearer` — Prometheus no admite cabeceras arbitrarias en un
# scrape_config, de ahí que el endpoint acepte ese portador además de X-Metrics-Token.
#
# OBLIGATORIA para levantar el perfil. Sin valor, Compose se detiene: `admin/admin` es
# exactamente la credencial que sobrevive a la migración a un servidor.
# GRAFANA_ADMIN_PASSWORD=
# Publicados solo en loopback. Grafana usa 3300 en el anfitrión porque 3000 es el de la API.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
PROMETHEUS_MEMORY=512m
GRAFANA_MEMORY=384m
OTEL_COLLECTOR_MEMORY=256m

# --- Copias de seguridad (scripts/backup.sh, scripts/restore.sh) -----------------------
# No los lee la aplicación: son variables del entorno de quien ejecuta los scripts.
# `backup.sh` verifica el archivo con pg_restore --list y escribe un .sha256 junto a él;
# la purga por retención ocurre DESPUÉS de esa verificación.
BACKUP_DIR=./backups
RETENTION_DAYS=14

# --- Worker semántico: clasificador de gastos (ADR-0026) -------------------------------
# Clasifica la descripción de un movimiento —«PAGO ALQUILER DEPARTAMENTO JULIO»— contra un
# ÁRBOL de categorías de gasto e ingreso, y la decisión recae en sus hojas.
#
# Apagado por omisión: sin proveedor de modelo el worker ni siquiera se registra, y el
# catálogo lo declara no disponible. Encenderlo es una decisión, no un valor por defecto.
#
# Con el clasificador de transformers, que corre en el perfil `transformer` de
# docker-compose.yml:
#   docker compose --profile transformer up -d transformer
#
# Es un codificador, no un modelo que escribe: proyecta el texto y las sondas del catálogo
# al mismo espacio y compara. Por eso no hay timeout de minutos, ni tokens de salida, ni
# reintentos — una clasificación es un producto escalar.
#
# Las variables del proveedor van en el compose SIN valor por defecto: un modelo de OpenAI
# y un codificador de Hugging Face no son intercambiables, y una cadena vacía no activa el
# valor por omisión del esquema — lo rompe. Descomentar aquí es lo que las enciende.
# SEMANTIC_ANALYSIS_WORKER_ENABLED=true
# SEMANTIC_ANALYSIS_PROVIDER=transformer
# TRANSFORMER_BASE_URL=http://transformer:80   # nombre del servicio, no localhost
# SEMANTIC_TRANSFORMER_MODEL=intfloat/multilingual-e5-small
# SEMANTIC_TRANSFORMER_TIMEOUT_MS=15000
# Debe ser MENOR O IGUAL que el --max-client-batch-size del servidor.
# SEMANTIC_TRANSFORMER_BATCH_SIZE=32
#
# Prefijos y umbrales son propiedades DEL MODELO servido, no del dominio, y estos están
# MEDIDOS con `node scripts/semantic-calibration.mjs` sobre e5 y el árbol de gastos:
#
#   pares correctos    min 0,8923   media 0,9214   max 0,9553
#   pares incorrectos  min 0,8452   media 0,8731   max 0,8995
#   textos sin categoría posible, mejor parecido: 0,8631
#
# El suelo (0,87) queda por encima de todo lo que debe abstenerse y por debajo de todo lo
# que debe acertar: es la ABSTENCIÓN. La temperatura reparte la confianza entre candidatos
# y es lo que separa la categoría correcta de la segunda. Al cambiar de modelo hay que
# volver a correr la calibración — BGE y la mayoría, además, quieren los prefijos VACÍOS.
# SEMANTIC_TRANSFORMER_QUERY_PREFIX="query: "
# SEMANTIC_TRANSFORMER_PASSAGE_PREFIX="passage: "
# SEMANTIC_TRANSFORMER_SIMILARITY_FLOOR=0.87
# La temperatura reparte la confianza entre las candidatas, y baja al crecer el
# catalogo: con 48 hojas y el vocabulario de comercios sembrado, TODAS casan un
# poco mejor con cualquier glosa, el ganador se despega menos del peloton y las
# hojas de umbral alto -Impuestos, 0,70- dejaban de alcanzarlo. Medido: a 0,01
# la calibracion caia a 20/21; a 0,005 vuelve a 21/21 y los siete extractos
# reales pasan de 168 a 205 glosas clasificadas de 213. Desde esa medicion 0,005
# es ademas el valor por omision del esquema, no solo la recomendacion escrita.
#
# El SUELO ya se recalibro (2026-08-31) contra el arbol crecido de 148 hojas, y el
# resultado contradice lo que aqui se sospechaba: NO hay que bajarlo.
#
#   suelo 0,87 -> 17/21 (81,0 %)      suelo 0,80 -> 14/21 (66,7 %)
#
# Bajarlo empeora, y la razon se ve en los casos: las abstenciones al 86 % no son
# el clasificador callandose de mas. Con el suelo en 0,80 esas mismas glosas dejan
# de abstenerse y contestan MAL -«TRANSFERENCIA RECIBIDA» pasa a «Transferencia
# enviada», «AJUSTE CONTABLE INTERNO» a «Sueldo»-. Se queda en 0,87.
#
# La TEMPERATURA tambien se recalibro (2026-09-01) y tampoco hay que bajarla. Se
# sospechaba que el optimo estaria por debajo de 0,005 tras crecer el arbol a 148
# hojas; medido con un barrido, el techo esta entre 0,005 y 0,02:
#
#   0,001 -> 21/21 (100 %)      0,02 -> 18/21 (85,7 %)
#   0,005 -> 21/21 (100 %)      0,05 -> 17/21 (81,0 %)
#
# 0,005 ya esta en el optimo y bajar no aporta: el margen es hacia abajo, y lo
# que hay que evitar es subir. Se queda.
#
# Los cuatro fallos que quedaban de la calibracion tambien se corrigieron y la
# exactitud es 21/21. Eran de tres clases distintas: un lookahead que solo miraba
# hacia adelante y archivaba «GASOLINA ... SURTIDOR YPFB» como gas domiciliario;
# «COBRO FACTURA» leido como gasto por el supuesto conservador del sentido; y dos
# casos cuya expectativa era «abstencion», escrita antes de que existiera el
# cajon, que hoy es el desenlace correcto y deliberado.
#   node scripts/semantic-calibration.mjs
# SEMANTIC_TRANSFORMER_TEMPERATURE=0.005
# SEMANTIC_TRANSFORMER_CONTRADICTION_MARGIN=0.02
#
# Sondas de catalogo con vector en memoria. Es la suma de enunciados, ejemplos y
# contraejemplos del arbol sembrado: por debajo de ella la LRU expulsa vectores
# que va a volver a pedir. Hoy son ~2.820 y el valor por omision, 4.000 (~12 MB).
# Al ampliar el catalogo hay que revisarlo; lo vigila una prueba del arbol.
# SEMANTIC_TRANSFORMER_PROBE_CACHE_SIZE=4000
#
# Cada candidato añade sus sondas al lote de embeddings. El coste es lineal y barato, así
# que aquí cabe más recall que con un modelo generativo.
# SEMANTIC_ANALYSIS_CANDIDATE_LIMIT=8
# TRANSFORMER_CPUS=2
# TRANSFORMER_MEMORY=2g
#
# Con OpenAI en su lugar. El puente deriva el lease del peor caso
# (timeout x intentos x 2 niveles) y lo eleva solo, así que no hace falta tocar
# SEMANTIC_ANALYSIS_LEASE_SECONDS.
# SEMANTIC_ANALYSIS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# SEMANTIC_FAST_MODEL=gpt-4.1-mini
# SEMANTIC_DEEP_MODEL=gpt-4.1
# SEMANTIC_PROVIDER_TIMEOUT_MS=30000
# SEMANTIC_PROVIDER_MAX_ATTEMPTS=3
#
# RECOMENDADO con IA: cascada local-primero. El codificador del servicio
# `transformer` clasifica todas las glosas y el LLM sólo entra en las que aquél no
# resuelve o tarda demasiado. Necesita los DOS perfiles levantados:
#   docker compose --profile transformer --profile litellm up -d transformer litellm
# SEMANTIC_ANALYSIS_PROVIDER=cascade
# TRANSFORMER_BASE_URL=http://transformer:80
# SEMANTIC_CASCADE_LOCAL_TIMEOUT_MS=2000
#
# Con el gateway LiteLLM por delante (docs/workers/semantic-litellm-gateway.md).
# El motor pide ALIAS LÓGICOS y conoce UNA sola credencial, la del gateway; qué
# modelo físico atiende cada alias vive en `infra/litellm/config.yaml` junto con
# las claves de los proveedores. Cambiar de proveedor deja de ser un despliegue
# del motor.
#   docker compose --profile litellm up -d litellm
# SEMANTIC_ANALYSIS_PROVIDER=litellm
# LITELLM_BASE_URL=http://litellm:4000/v1
# LITELLM_API_KEY=            # == LITELLM_MASTER_KEY, o una virtual key del proxy
# LITELLM_FAST_MODEL=semantic-classifier-fast
# LITELLM_DEEP_MODEL=semantic-classifier-deep
# LITELLM_EMBEDDING_MODEL=semantic-embedding
# LITELLM_TIMEOUT_MS=30000
# LITELLM_MAX_ATTEMPTS=3
# LITELLM_MAX_OUTPUT_TOKENS=2048
#
# --- Lo que ve SÓLO el contenedor del gateway, nunca el motor ---------------
# Aquí sí van nombres de modelo físicos y las claves de cada proveedor.
# LITELLM_MASTER_KEY=
# SEMANTIC_FAST_DEPLOYMENT=gemini/gemini-2.0-flash
# SEMANTIC_FAST_API_KEY=
# SEMANTIC_FAST_FALLBACK_DEPLOYMENT=gpt-4.1-mini
# SEMANTIC_FAST_FALLBACK_API_KEY=
# SEMANTIC_DEEP_DEPLOYMENT=gpt-4.1
# SEMANTIC_DEEP_API_KEY=
# SEMANTIC_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# SEMANTIC_EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Worker de verificación de identidad (ADR-0030)
# ---------------------------------------------------------------------------
# Compara la foto de un documento con una selfie y decide si son la misma
# persona. `docker-compose.yml` ya lo enciende en la topología de desarrollo:
# sus proveedores son SINTÉTICOS y no dependen de ningún servicio externo.
# IDENTITY_VERIFICATION_WORKER_ENABLED=true
#
# Los umbrales de la comparación biométrica NO tienen valor por omisión, y es
# deliberado: sin ellos toda verificación termina en revisión manual con
# `THRESHOLD_PROFILE_MISSING`. Un umbral por defecto decidiría sobre la
# identidad de una persona con una cifra que nadie midió contra un corpus
# etiquetado, y lo haría en silencio.
#
# Van los DOS o no va ninguno, y el de revisión tiene que ser MENOR que el de
# coincidencia. `IDENTITY_THRESHOLD_PROFILE_VERSION` nombra la calibración de la
# que salieron y viaja al resultado: es lo que permite auditar después contra
# qué se decidió. Los valores del compose son de LABORATORIO —medidos contra el
# proveedor sintético, no contra un corpus— y un despliegue real los sustituye.
# IDENTITY_MATCH_THRESHOLD=0.8824
# IDENTITY_REVIEW_THRESHOLD=0.7789
# IDENTITY_THRESHOLD_PROFILE_VERSION=sintetico-60x3-fmr1e-3-fnmr1e-2
#
# Prueba de vida. Apagada por omisión: sin ella, una foto impresa del documento
# junto a una foto impresa de su titular pasa una comparación 1:1. El adaptador
# deshabilitado devuelve NOT_RUN, que el motor de decisión trata como señal
# ausente y NO como éxito.
# IDENTITY_LIVENESS_ENABLED=true
#
# En PRODUCCIÓN, apagarla exige declararlo por escrito. La guarda no impide
# correr sin prueba de vida: impide hacerlo sin que nadie lo haya decidido.
# IDENTITY_ACCEPT_NO_LIVENESS_RISK=false
#
# El resto de guardas de producción (`src/common/config/env.schema.ts`) sólo se
# disparan con el worker ENCENDIDO, y todas fallan al arrancar en vez de en la
# primera verificación:
#   - comparador de rostros simulado          -> prohibido
#   - prueba de vida simulada                 -> prohibida
#   - IDENTITY_THRESHOLD_PROFILE_VERSION sin nombrar -> prohibido
# Con el worker apagado no se exige ninguna: el precio se paga al encenderlo.
#
# La LECTURA del documento es real y local: Tesseract sobre WebAssembly, con los
# datos del idioma como paquete de npm. Sin credenciales y sin salir a la red.
# Es lo que permite rechazar una imagen que no es un documento — con un lector
# simulado, una foto cualquiera terminaba VERIFICADA.
#
# La BIOMETRÍA sigue simulada: los adaptadores de AWS del paquete original
# exigen tres SDK y credenciales que este despliegue no tiene. Los puertos
# siguen intactos, así que añadir uno real es registrar un proveedor más en
# `WorkersModule`. El catálogo publica quién decidió cada cosa, porque un
# «VERIFICADO» de aquí afirma que se leyó un documento válido, NO que las dos
# caras sean de la misma persona.
# IDENTITY_OCR_PROVIDER=tesseract
# IDENTITY_FACE_PROVIDER=mock
#
# Límites de entrada. El techo de tamaño es POR IMAGEN.
# IDENTITY_MAX_UPLOAD_BYTES=10485760
#
# Los tres siguientes NO rechazan nada: por debajo de ellos la medida emite el
# aviso LOW_RESOLUTION, que viaja al veredicto y puede mandarlo a revisión.
# IDENTITY_MIN_IMAGE_WIDTH=480
# IDENTITY_MIN_IMAGE_HEIGHT=480
# IDENTITY_MIN_IMAGE_PIXELS=230400
#
# Éstos sí rechazan, y son el ÚNICO rechazo por tamaño: el suelo por debajo del
# cual no queda texto que leer, medido con scripts/medir-resolucion-identidad.ts
# (a 450x289 la cédula se lee entera; a 220x141 ya no clasifica). Van por eje
# largo y corto porque una cédula es apaisada: exigirle lo mismo a lo alto que a
# lo ancho pedía en realidad 761 px de ancho para leer algo que se lee con 450.
# IDENTITY_MIN_READABLE_LONG_EDGE=240
# IDENTITY_MIN_READABLE_SHORT_EDGE=150
#
# El tope de lo que se le entrega al RECONOCEDOR, y la palanca de velocidad del
# worker. No es un mínimo de calidad: es cuánta imagen vale la pena pagar.
#
# El coste de Tesseract no es proporcional a los píxeles —lo marca cuántos
# candidatos a texto encuentra—, así que sobre una foto que NO es un documento
# hay un acantilado. Medido con scripts/medir-rechazo-identidad.ts sobre ruido de
# 12 MP: 4753 ms a 600x800 y 513 ms a 450x600. Con el tope en 600 y las sondas de
# orientación, rechazar lo que no es un documento pasó de 36 s a 2,5 s.
#
# Lo que cuesta: por debajo de cierto tamaño se pierde la MRZ, y con ella el
# número y las fechas. Eso NO aprueba nada mal —al caso le faltan campos y cae en
# la bandeja de revisión—, pero el precio lo paga quien hizo bien la foto. Los
# campos aguantan a 600 px en la cédula SINTÉTICA, que no pasó por ningún sensor;
# con fotos reales hay que volver a medirlo:
#   yarn ts-node scripts/medir-resolucion-ocr-identidad.ts <DIRECTORIO CON FOTOS>
# y subir este número hasta donde la MRZ vuelva a leerse. `0` desactiva el tope.
# IDENTITY_OCR_MAX_LONG_EDGE=600
#
# Quién cierra la franja de duda de la puerta de documentos: HUMAN (por omisión)
# o AI. Las dos se pueden elegir, pero hoy sólo una decide de verdad: el
# adaptador de IA está declarado y NO tiene modelo detrás —contesta DEFERRED
# siempre y lo dice en su health()—, así que con AI puesto las dudas siguen
# yendo a la bandeja.
#
# Y cuando llegue un modelo, la regla ya está puesta en el pipeline: un árbitro
# automático puede ESCALAR y no puede APROBAR. No es desconfianza genérica; es
# que lo que separa una cédula legítima de una falsificada está en los píxeles y
# no en el texto —el texto de una falsificación es el de un documento auténtico,
# porque se copió de uno—. Su «no» rechaza; su «sí» deja el caso en la bandeja.
# IDENTITY_ARBITRATION_MODE=HUMAN
# IDENTITY_DEFAULT_DOCUMENT_COUNTRY=BO

# --- Worker D: locución (audio TTS) -----------------------------------------
#
# El único de los cuatro workers que puede COSTAR DINERO por ejecución, y eso
# explica casi todo lo que sigue. Es cache-first: una frase ya locutada con la
# misma voz se sirve tal cual y no vuelve a cobrarse, así que lo que se acota no
# es el uso sino la GENERACIÓN.
#
# Apagado por omisión, como los otros tres.
# AUDIO_TTS_WORKER_ENABLED=true
#
# `disabled` (por omisión) deja el worker declarado NO disponible aunque esté
# encendido, igual que el semántico sin proveedor de modelo: es preferible una
# pantalla que lo explica a una cola de errores.
#
# `fake` sintetiza un MP3 determinista sin salir a la red y sin coste. Sirve
# para recorrer la pantalla y para las pruebas; está PROHIBIDO en producción,
# porque un audio de prueba servido a una persona real es peor que no servir
# ninguno.
# AUDIO_TTS_PROVIDER=fake
#
# Permiso APARTE para generar audio nuevo durante la operación. Apagado, el
# worker sólo sirve lo que ya está en caché — que no es lo mismo que apagar el
# worker: permite servir un catálogo ya locutado sin que nadie pueda gastar.
# AUDIO_TTS_ALLOW_RUNTIME_GENERATION=true
#
# Identidad de la voz. Cambiar CUALQUIERA de estos cinco produce un audio
# distinto: la caché no los mezcla y las locuciones anteriores dejan de servir.
# AUDIO_TTS_DEFAULT_LANGUAGE=es-419
# AUDIO_TTS_VOICE_PROFILE=brand_es_latam_v1
# AUDIO_TTS_VOICE_VERSION=1
# AUDIO_TTS_MODEL=eleven_v3
# AUDIO_TTS_DEFAULT_FORMAT=mp3_44100_128
#
# Presupuesto. El techo por actor y día es lo que impide que una sola cuenta
# —o un formulario pulsado en bucle— agote el mes de toda la organización. Un 0
# ahí significa BLOQUEADO, no ilimitado.
# AUDIO_TTS_MONTHLY_BUDGET_UNITS=10000
# AUDIO_TTS_SAFETY_RESERVE_UNITS=1000
# AUDIO_TTS_RUNTIME_GENERATIONS_PER_ACTOR_DAY=3
#
# Cifrado del texto locutado. Se exige con el worker encendido fuera de las
# pruebas: el texto lleva dentro las variables —el nombre de una persona en la
# plantilla dinámica— y su única copia vive en la caché.
# AUDIO_TTS_DATA_KEY=<al menos 32 caracteres, nunca en el repositorio>
# AUDIO_TTS_DATA_KEY_ID=k1
# AUDIO_TTS_DATA_KEYS_PREVIOUS=k0:<secreto anterior>
#
# Proveedor ElevenLabs. La voz no tiene valor por omisión a propósito: elegirla
# es una decisión de marca, no una configuración heredada.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
#
# CÓMO habla esa voz. Los valores por omisión son los del proveedor, así que
# dejarlos suena igual que no mandarlos. La palanca contra la locución plana
# —lo que se percibe como voz «robótica»— es STABILITY: cuanto más baja, más
# varía la entonación; entre 0,30 y 0,45 suena conversacional, por encima de
# 0,70 recita. STYLE añade expresión y también latencia.
#
# Los cuatro entran en la clave de caché del audio: ajustarlos REGENERA las
# locuciones afectadas en vez de seguir sirviendo las de antes. Eso cuesta
# créditos, que es justo lo que un worker cache-first existe para no gastar dos
# veces — no los toques frase a frase.
#
# Una advertencia que no es de configuración: una voz cuyo idioma nativo NO es
# el del texto suena rara por muchos ajustes que se le pongan. Si el catálogo
# habla español, elige una voz española; ningún STABILITY arregla una voz
# inglesa pronunciando español.
# ELEVENLABS_VOICE_STABILITY=0.5
# ELEVENLABS_VOICE_SIMILARITY_BOOST=0.75
# ELEVENLABS_VOICE_STYLE=0
# ELEVENLABS_VOICE_SPEAKER_BOOST=true
#
# Dónde viven los bytes. `database` los guarda en la propia base, como el resto
# de workers guarda su carga útil, y hereda su aislamiento por tenant y su copia
# de seguridad. `local` es el adaptador de disco del paquete, para desarrollo:
# en producción está prohibido porque el directorio se va con el contenedor y se
# lleva la caché entera, que habría que volver a pagar.
# AUDIO_STORAGE_DRIVER=database
#
# En PRODUCCIÓN, usar la voz del proveedor exige declarar que alguien miró la
# licencia. La guarda no impide locutar: impide hacerlo sin que nadie lo decida.
# AUDIO_TTS_PROD_LICENSE_CONFIRMED=false

# ─────────────────────────────────────────────────────────────────────────────
# PDF Generator Worker  (src/pdf-worker)
#
# Estas variables NO pasan por `validateEnvironment`: el generador documental
# valida su propio entorno con su propio esquema al arrancar. El motivo es
# concreto y costaría horas descubrirlo de otro modo: `envSchema` es un
# `z.object` y un `z.object` DESCARTA las claves que no declara, así que todas
# las `PDF_*` sobrevivirían a la validación y desaparecerían del ConfigService.
# Leer `process.env` directamente es además lo que permite arrancar el worker
# como proceso suelto (`node dist/pdf-worker.js`) sin que el motor sepa nada.
#
# Todo lo de abajo tiene valor por omisión. Un despliegue mínimo sólo necesita
# PDF_ORG_NAME para que el membrete diga algo cierto.
# ─────────────────────────────────────────────────────────────────────────────

# Proveedores. Cambiarlos es cambiar de adaptador, no de casos de uso.
# PDF_RENDERER=playwright
# PDF_TEMPLATE_ENGINE=handlebars

# Concurrencia y plazos. `CONCURRENCY` es el número de pestañas simultáneas de
# Chromium: subirlo sin subir la memoria del contenedor produce OOM, no
# velocidad. Agotado el plazo de cola se responde 429 —el servicio está sano,
# falta capacidad—, que es lo que le dice al cliente que reintente con retroceso.
# PDF_RENDER_CONCURRENCY=4
# PDF_RENDER_TIMEOUT_MS=30000
# PDF_RENDER_QUEUE_TIMEOUT_MS=15000
# PDF_MAX_DOCUMENT_BYTES=20971520

# Navegador. JavaScript va APAGADO: ninguna plantilla lo necesita y sin él
# ningún payload puede ejecutar nada aunque atravesara el escapado.
# PDF_BROWSER_HEADLESS=true
# PDF_BROWSER_JAVASCRIPT=false
# PDF_BROWSER_EXECUTABLE_PATH=

# Rutas. Vacías, todo cuelga de la carpeta `templates` que acompaña al código
# compilado, para que las plantillas, el logotipo y las fuentes viajen juntos en
# la imagen.
# PDF_TEMPLATE_PATH=
# PDF_ASSETS_PATH=
# PDF_FONTS_PATH=

# Almacenamiento. Apagado por omisión: el modo síncrono devuelve el búfer y no
# escribe nada. Un generador que obliga a persistir convierte cada «previsualiza
# esto» en basura que alguien tendrá que barrer.
# PDF_STORAGE_ENABLED=false
# PDF_STORAGE_PROVIDER=local
# PDF_STORAGE_PATH=./var/pdf-worker
# PDF_PERSIST_BY_DEFAULT=false

# Idempotencia. El almacén que se entrega vive EN MEMORIA: cubre el reenvío
# accidental y la carrera dentro de una réplica, no dos réplicas ni un
# reinicio. Con varias réplicas hay que sustituirlo (ver docs/pdf-worker/).
# PDF_IDEMPOTENCY_TTL_SECONDS=86400
# PDF_IDEMPOTENCY_LEASE_SECONDS=120

# Cola. Apagada por omisión: un 202 sobre una cola sin consumidor es la peor
# respuesta posible, porque el llamante espera un evento que no llegará.
# PDF_QUEUE_ENABLED=false
# PDF_QUEUE_CAPACITY=200

# Presentación por defecto.
# PDF_DEFAULT_FORMAT=A4
# PDF_DEFAULT_LOCALE=es-BO
# PDF_DEFAULT_TIMEZONE=America/La_Paz

# Membrete e identidad visual. Es lo único que un despliegue nuevo necesita
# tocar para que los documentos salgan con su nombre.
# PDF_BRAND_ID=atlas
# PDF_BRAND_NAME=ATLAS Decision Engine
PDF_ORG_NAME=ATLAS Decision Engine
# PDF_ORG_LEGAL_NAME=
# PDF_ORG_TAX_ID=
# PDF_ORG_ADDRESS=
# PDF_ORG_PHONE=
# PDF_ORG_EMAIL=
# PDF_ORG_WEBSITE=
# PDF_ORG_SECONDARY_TEXT=
# El logotipo se referencia como recurso, NUNCA como URL: el resolutor rechaza
# http(s) y así el render no puede convertirse en un cliente que visita lo que
# le digan desde dentro de la red (SSRF).
# PDF_ORG_LOGO=asset:logo.svg
# PDF_LETTERHEAD_MODE=every-page
# PDF_FOOTER_TEXT=
# PDF_BRAND_ACCENT=#1d4ed8

# Sólo para el proceso suelto (`node dist/pdf-worker.js`).
# PDF_WORKER_PORT=3100
# Swagger APAGADO por omisión. Antes la condición era «encendido salvo que alguien
# lo apague», y sólo estaba apagado porque el compose fijaba la variable: un
# `node dist/pdf-worker.js` a pelo publicaba /docs y /openapi.json enteros.
# PDF_SWAGGER_ENABLED=false
# PDF_MAX_REQUEST_SIZE=8mb

# --- Puerta del servicio (SÓLO en el proceso suelto) --------------------------
#
# Existe por un hallazgo medido: la misma operación respondía 401 por el motor y
# 200 por el worker, porque el arranque suelto no registraba ningún guardia.
#
#     GET  :3000/pdf/templates  -> 401   (dentro del motor: lo cubre su APP_GUARD)
#     GET  :3100/pdf/templates  -> 200   (suelto: no lo cubría nada)
#     POST :3100/pdf/generate   -> 422   (validación; o sea, pasó la autenticación)
#
# ENCENDIDA por omisión, al revés que la administración de templates de más
# abajo: aquélla es una capacidad que la mayoría de despliegues no usa, y ésta es
# el suelo. En modo suelto, arrancar sin clave ABORTA — no degrada a modo
# abierto: un servicio que se abre solo cuando le falta la clave es un servicio
# sin autenticación con pasos extra.
#
# Dentro del motor esto no aplica y la clave no hace falta: autentica el
# anfitrión, y exigirla obligaría al motor a mandarse una credencial a sí mismo.
#
# `GET /pdf/health` queda fuera de la puerta: es la sonda del contenedor, la
# llama el HEALTHCHECK sin cabeceras, y publica estado de vida, no datos.
# PDF_SERVICE_AUTH_ENABLED=true
# PDF_SERVICE_API_KEY=<al menos 32 caracteres, nunca en el repositorio>
# PDF_SERVICE_HEADER=x-pdf-service-key
#
# CORS cerrado salvo lista explícita. Vacío = ningún origen de navegador, que es
# lo que corresponde a un servicio al que llama un servidor y no una pestaña.
# PDF_CORS_ALLOWED_ORIGINS=

# Administración de templates por API (CRUD).
#
# APAGADA por omisión, y no por prudencia genérica: es la ÚNICA superficie del
# worker que acepta plantillas del exterior. Con esto apagado las rutas de
# administración responden 404 —no 403—, que es lo que corresponde a algo que
# para el mundo no existe. El formato admitido SÍ es público:
# GET /pdf/template-format/example descarga un paquete de ejemplo funcional y
# GET /pdf/template-format/schema publica su JSON Schema.
#
# Encenderla sin clave aborta el arranque: dejaría abierta la vía de publicación.
# La clave se compara en tiempo constante. Esto NO sustituye a la autenticación
# del anfitrión; montado dentro del motor, la ruta debe quedar además detrás de
# sus guardias de rol.
# PDF_TEMPLATE_ADMIN_ENABLED=false
# PDF_TEMPLATE_ADMIN_KEY=<al menos 24 caracteres, nunca en el repositorio>
# PDF_TEMPLATE_ADMIN_HEADER=x-pdf-admin-key
#
# Dónde se guardan los templates publicados por API. DEBE ser un volumen
# persistente: si se pierde, se pierde la capacidad de reproducir todo lo que se
# emitió con ellos.
# PDF_CUSTOM_TEMPLATE_PATH=./var/pdf-worker/templates

# --- Worker de extractos: las cuatro compuertas de admisión -------------------
# Ninguna es un umbral de calidad: cada una decide si el documento entra. Los
# valores de aquí son los de por defecto; se listan para poder discutirlos.
#
# CONTENEDOR — con qué se produjo el archivo. Es la única compuerta que no se
# puede satisfacer escribiendo el texto correcto en el documento, y también la
# que más documentos legítimos detiene: un PDF reabierto en Vista Previa de macOS
# declara `Quartz PDFContext` y puntúa 85, que es rechazo. Sube REJECT_SCORE para
# dejarlos pasar, sabiendo que cada punto es un intento de composición que ya no
# se detiene.
BANK_STATEMENT_AUTHENTICITY_ENFORCE=true
BANK_STATEMENT_AUTHENTICITY_REJECT_SCORE=70
BANK_STATEMENT_AUTHENTICITY_REVIEW_SCORE=30
#
# EMISOR — si la carátula lo atribuye a una entidad con licencia de ASFI.
BANK_STATEMENT_REQUIRE_LICENSED_ISSUER=true
#
# COBERTURA — si los tres meses completos RECHAZAN o sólo advierten. Advierten:
# los meses se cuentan naturales y completos, así que el extracto que la banca
# por internet entrega como «últimos 3 meses» aporta dos.
BANK_STATEMENT_ENFORCE_MINIMUM_MONTHS=false
#
# VIGENCIA — hasta cuándo tiene que llegar el extracto. La tolerancia existe
# porque el extracto cierra en el último movimiento, no el día de la descarga.
# Ojo: los escenarios del laboratorio están fechados en el primer trimestre de
# 2026, así que en QA esto tiene que ir en `false` hasta reanclarlos.
#
# Hasta el 2026-08-31 estas tres —y las otras siete de las compuertas— NO llegaban
# al contenedor: `docker-compose.yml` no tiene `env_file` y no las nombraba, así
# que corrían con el valor compilado y no había forma de calibrarlas. Con
# `enforce=true` y tolerancia de 3 días, la vigencia rechazaba TODO extracto real
# medido (cierres de 32 a 422 días atrás). Ya están declaradas en el compose.
BANK_STATEMENT_RECENCY_ENFORCE=true
BANK_STATEMENT_RECENCY_TOLERANCE_DAYS=3
BANK_STATEMENT_RECENCY_FUTURE_TOLERANCE_DAYS=3

# PARECIDO — cuánto se parece el documento a los extractos que su entidad emite
# de verdad, medido contra el descriptor de señales del padrón. `CORROBORATE`
# deja que un parecido alto sostenga un documento que el contenedor dejó en duda;
# NO existe un modo que rechace por no parecerse. Rescatar exige un descriptor
# `MEASURED` con muestra suficiente, y hoy los siete compilados son `DECLARED`:
# la palanca queda lista y el dato decide cuándo empieza a tener efecto.
BANK_STATEMENT_SIMILARITY_MODE=CORROBORATE
BANK_STATEMENT_SIMILARITY_MATCH_SCORE=70
BANK_STATEMENT_SIMILARITY_PARTIAL_SCORE=35
BANK_STATEMENT_SIMILARITY_MIN_SAMPLE=3
