NODE_ENV=development
PORT=3000
BUILD_VERSION=2.0.0
COMMIT_SHA=local
# Published API contract version (changes only on a breaking change, unlike BUILD_VERSION).
# The OpenAPI document is served at /docs/$API_VERSION plus the /docs alias.
API_VERSION=v1

DATABASE_URL=postgresql://atlas:atlas-local-only@localhost:5432/atlas_decision?schema=public
DATABASE_POOL_MAX=15
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=atlas:decision
REQUIRE_REDIS_IN_PRODUCTION=true

# Browser portal: IDENTITY_PROVIDER. Use IDENTITY_HYBRID only while trusted
# technical integrations still require API keys.
AUTH_MODE=IDENTITY_PROVIDER
MANAGEMENT_API_KEY=change-me-management-with-at-least-24-characters
RUNTIME_API_KEY=change-me-runtime-with-at-least-24-characters
JWT_JWKS_URL=
JWT_ISSUER=
JWT_MANAGEMENT_AUDIENCE=atlas-decision-management
JWT_RUNTIME_AUDIENCE=atlas-decision-runtime
JWT_TENANT_CLAIM=tenant_id
JWT_ROLES_CLAIM=roles
JWT_JWKS_CACHE_SECONDS=900
JWT_JWKS_TIMEOUT_MS=3000
JWT_CLOCK_SKEW_SECONDS=30

# AtlasBackend identity provider. Include its global prefix, normally /api/v1.
# Use AUTH_MODE=IDENTITY_PROVIDER for the browser portal, or IDENTITY_HYBRID
# when trusted technical integrations still require API keys.
IDENTITY_PROVIDER_URL=http://localhost:3001/api/v1
IDENTITY_PROVIDER_TIMEOUT_MS=3000
# Retries only on transient provider failures (network error / timeout / 502-503-504), never on a
# rejected credential. Absorbs the brief restart window of the provider dev server. 0 disables it.
IDENTITY_PROVIDER_RETRY_ATTEMPTS=2
IDENTITY_PROVIDER_RETRY_BACKOFF_MS=300
IDENTITY_REFRESH_COOKIE_NAME=atlas_refresh
IDENTITY_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
IDENTITY_SESSION_RATE_LIMIT=20

CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_GRACE_MS=20000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MANAGEMENT_REQUESTS=300
RATE_LIMIT_RUNTIME_REQUESTS=1500
AUTH_FAILURE_RATE_LIMIT=20

SWAGGER_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=change-me-metrics-token-with-at-least-24-characters
LOG_LEVEL=debug
# stdout | stdout_and_file. Keep stdout in containers: the root filesystem is read-only,
# so stdout_and_file needs LOG_FILE_PATH to point at a mounted, writable volume.
LOG_OUTPUT=stdout
# LOG_FILE_PATH=logs/atlas-decision-engine.log
ACCESS_AUDIT_ENABLED=true

# Bootstrap integration clients used by API_KEY and hybrid modes. API key callers never
# declare their own identity or roles; the seed persists the permitted tenant and scopes.
BOOTSTRAP_TENANT_ID=1
BOOTSTRAP_MANAGEMENT_ROLES=AUDITOR,COMPLIANCE,FRAUD_ANALYST,OPERATIONS,PLATFORM_ADMIN,QA_ANALYST,RISK_ANALYST,RISK_APPROVER
BOOTSTRAP_RUNTIME_ROLES=DECISION_RUNTIME

# Startup seeding: injects bootstrap seeds (every environment) and mockup/demo seeds
# (development only) idempotently when the app boots. Unset => on everywhere except NODE_ENV=test.
STARTUP_SEED_ENABLED=true

# Distributed tracing (OpenTelemetry). Off by default: nothing is patched and no exporter
# runs. Enable alongside an OTLP collector; unset endpoint means the default localhost:4318.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atlas-decision-engine
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

VARIABLE_BACKEND_URL=
VARIABLE_BACKEND_TIMEOUT_MS=1500
AUDIT_HASH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DEFAULT_ENVIRONMENT=PROD
MAX_EXECUTION_STEPS=256
TEST_RUN_WORKER_POLL_MS=500
TEST_RUN_WORKER_CONCURRENCY=2
TEST_RUN_LEASE_SECONDS=300
TEST_CASE_CONCURRENCY=4
SCRIPT_NODES_ENABLED=false
# IN_PROCESS is dev/test only. Production requires SIDECAR (see docker-compose.yml's
# script-runner service and docs/CONFIGURABLE_OUTPUTS.md) — the env schema refuses
# SCRIPT_NODES_ENABLED=true in production otherwise.
SCRIPT_RUNNER_MODE=IN_PROCESS
SCRIPT_RUNNER_SOCKET_PATH=/var/run/atlas-runner/runner.sock
SCRIPT_NODE_TIMEOUT_MS=250
SCRIPT_NODE_MAX_SOURCE_BYTES=16384
SCRIPT_NODE_MAX_OUTPUT_BYTES=65536
IDEMPOTENCY_TTL_HOURS=24
# Lease held while a decision is PROCESSING; a crashed holder frees the key after this.
IDEMPOTENCY_LEASE_SECONDS=60
# Background purge of expired runtime idempotency rows (highest-volume table).
RUNTIME_RETENTION_SWEEP_ENABLED=true
RUNTIME_RETENTION_SWEEP_INTERVAL_MS=3600000
RUNTIME_IDEMPOTENCY_RETENTION_GRACE_HOURS=24
RUNTIME_RETENTION_SWEEP_BATCH=1000
MAX_PAGE_SIZE=100

# Transactional outbox relay: dispatches domain events written by business transactions
# to the in-process event bus (notifications, projections). Backoff is exponential via
# available_at; after OUTBOX_MAX_ATTEMPTS the event moves to DEAD (dead-letter).
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_MS=30000
