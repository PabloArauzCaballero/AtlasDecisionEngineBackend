node_modules
dist
.env
# Toda variante local de .env, no solo el fichero exacto. `.env` a secas dejaba fuera las
# copias que se hacen antes de un cambio grande (`.env.bak-antes-transformer`, `.env.old`,
# `.env.local`), que llevan los MISMOS secretos y quedaban como untracked a la espera de
# que un `git add -A` las publicara. `.env.example` se exceptúa: es la plantilla, y sus
# valores son literales `change-me-*` que el env schema rechaza en producción.
.env.*
!.env.example
coverage
# Los otros dos informes: el de la batería e2e y la unión de ambos (`yarn cov:merge`).
coverage-e2e
coverage-merged
*.log
.prisma
/smoke/last-run.json
# Evidencia del smoke integral: describe una corrida local concreta, no se versiona.
/smoke/out/

graphify-out/
# Build artifacts and archives (never commit — backend.zip previously leaked .env)
*.zip
dist/

# Local RLS rollback backup (contains a secret)
.env.pre-rls.bak

# This project is on Yarn (yarn.lock is the tracked lockfile). A stray `npm install` writes
# a competing package-lock.json and resolves a different tree, which is what produced the
# "invalid or damaged lockfile" warning. Ignore it so an accidental npm run cannot be
# committed and cannot become a second source of truth. Use yarn.
package-lock.json

# Portal MkDocs generado (se construye en CI y en contenedor).
site/

# Estado local de la bóveda de Obsidian (`docs/` abierta como vault). La configuración sí se
# versiona —define que los enlaces sean Markdown relativos y por tanto compatibles con MkDocs—,
# pero el layout de ventanas y la caché son de cada máquina.
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache
backups/

# macOS
.DS_Store

# Árboles de trabajo de git creados por las herramientas de agente.
#
# `.claude/` SÍ se versiona —ahí viven las reglas del repositorio— pero esta carpeta no es
# configuración: es un `git worktree` vivo, es decir, una copia completa del repositorio
# apuntando a otra rama. Versionarla mete un repositorio dentro de otro, y a partir de ahí `git
# status` empieza a informar del árbol equivocado.
.claude/worktrees/
